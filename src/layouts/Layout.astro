---
import "../styles/global.css";
const { title = "Fusionedge" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,500;1,600;1,700&display=swap" rel="stylesheet">
<title>{title}</title>
<style is:global>
:root{--bg:#fff;--ink:#111;--muted:#444;--teal:#6B2288;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{color-scheme:light;background:#fff}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Public Sans",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;overflow-x:hidden}
.btn{border-radius:99px;font:inherit;cursor:pointer}
p{font-size:14px;line-height:1.6;color:var(--muted);max-width:480px;margin:0 auto 30px}
.wrap{max-width:none;margin:0 auto}
.hexwrap{position:relative;margin:0 auto}
.hex svg{display:block}
.hex{position:absolute;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;background:transparent;filter:drop-shadow(0 8px 14px rgba(40,80,120,.18));font-weight:500;color:#5b676d;text-align:center}
.hex::before{content:"";position:absolute;inset:0;background:#fff;clip-path:polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0 50%);z-index:0}
.hex svg,.hex span{position:relative;z-index:1}
.mod{overflow:visible}
.mod.p{--d:#6B2288;--k:#5D1F72;--l:#F3E9F8;--m:#CBA9DB;--g:#fff}
.mod.n{--d:#00BF88;--k:#00A276;--l:#FBFCDA;--m:#F6F7A9;--g:#fff}
.mod.w{--d:#00BF88;--k:#00A276;--l:#fff;--m:#C4EEDF;--g:#fff}
.D{fill:var(--d)}.K{fill:var(--k)}.L{fill:var(--l)}.M{fill:var(--m)}.W{fill:#fff}.G{fill:var(--g)}.N{fill:none}
.sD,.sM,.sG{stroke-linecap:round;stroke-linejoin:round;stroke-width:2.2}
.sD{stroke:var(--d)}.sM{stroke:var(--m)}.sG{stroke:var(--g);stroke-width:2}
.o{stroke:#fff;stroke-width:3;paint-order:stroke;stroke-linejoin:round}
.hex span{max-width:72%;line-height:1.15}
.hexwrap{transition:height .9s cubic-bezier(.65,0,.25,1)}
@media (prefers-reduced-motion:reduce){.hex,.hexwrap{transition:none}}
html,body{background:#fff!important}
nav.top{position:sticky;top:0;z-index:20;background:#fff;align-items:center;padding:18px 5vw;border-bottom:1px solid #eef1f3}
nav.top .links{display:flex;gap:30px;list-style:none;padding:0}
nav.top .links a{font-size:13px;font-weight:500;color:var(--ink);text-decoration:none;cursor:pointer}
nav.top .links a:hover{color:var(--teal)}
nav.top .btn{font-size:13px;padding:10px 26px;white-space:nowrap}
@media (max-width:760px){nav.top{justify-content:space-between}}
nav.top{display:grid!important;grid-template-columns:1fr auto 1fr;gap:20px}
nav.top .links{margin:0!important;justify-content:center}
nav.top .btn{justify-self:end}
.brand{display:flex;align-items:center;justify-self:start}
.brand img{height:44px;width:auto;display:block;mix-blend-mode:multiply}
@media (max-width:760px){nav.top{grid-template-columns:1fr auto}}
.origin-btn{position:relative;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 28px;border-radius:12px;border:1px solid #e3e7ec;background:#fff;color:#111;font:inherit;font-size:14px;font-weight:500;letter-spacing:-.02em;cursor:pointer;touch-action:manipulation;user-select:none;-webkit-tap-highlight-color:transparent;transition:color .3s cubic-bezier(.16,1,.3,1),transform .15s ease}
.origin-btn.on{color:#fff}
.origin-btn.down{transform:scale(.985)}
.origin-btn .fill{position:absolute;left:0;top:0;border-radius:50%;background:#111;pointer-events:none;transform:translate(-50%,-50%) scale(0);transition:transform .5s cubic-bezier(.16,1,.3,1)}
.origin-btn.on .fill{transform:translate(-50%,-50%) scale(1)}
.origin-btn .z{position:relative;z-index:1}
.origin-btn:focus-visible{outline:0;box-shadow:0 0 0 2px #fff,0 0 0 4px rgba(93,31,114,.4)}
@media (prefers-reduced-motion:reduce){.origin-btn,.origin-btn .fill{transition:none}}
.origin-btn.primary{background:#5D1F72;border-color:#5D1F72;color:#fff}
nav.top .btn{background:#5D1F72;color:#fff;border:1px solid #5D1F72;transition:background .3s,color .3s}
body,button,input{font-family:"Public Sans",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif}
.origin-btn.primary .fill{background:#3E1450}
nav.top{padding-top:16px;padding-bottom:16px}
.wrap{padding:clamp(40px,6vh,64px) 3vw clamp(64px,10vh,100px)}
.cat{width:100%;overflow-x:auto;padding:88px 0 100px}
.cat .hex{opacity:0;transform:scale(.6);transition:left .9s cubic-bezier(.65,0,.25,1),top .9s cubic-bezier(.65,0,.25,1),opacity .6s ease,transform .6s cubic-bezier(.16,1,.3,1)}
.cat.in .hex{opacity:1;transform:scale(.96)}
.lines{position:absolute;left:0;top:0;overflow:visible;pointer-events:none}
.seg{stroke:#5D1F72;stroke-width:3;stroke-linecap:round;fill:none;stroke-dasharray:1;stroke-dashoffset:1}
.gseg.green .seg{stroke:#00BF88}
.gseg{opacity:0;transition:opacity .5s ease}.gseg.on{opacity:1}
.gseg.drawn .seg{stroke-dashoffset:0;transition:stroke-dashoffset .8s ease}
.lbl{position:absolute;top:-80px;transform:translateX(-50%);text-align:center;opacity:0;transition:opacity .6s ease}
.lbl.green{top:auto;bottom:-84px}
.lbl.on{opacity:1;transition-delay:.3s}
.lbl small{display:block;margin-top:6px;font-size:12px;line-height:1.25;font-weight:500;color:#5D1F72}
.lbl.green,.lbl.green small{color:#00BF88}
@media (prefers-reduced-motion:reduce){.cat .hex{opacity:1;transform:scale(.96);transition:none}.gseg{opacity:1}.gseg .seg{stroke-dashoffset:0;transition:none}.lbl{opacity:1;transition:none}}
.hero{position:relative;max-width:none;display:flex;align-items:center;justify-content:center;padding:clamp(36px,5vh,56px) 24px clamp(28px,4vh,40px);background:#fff}
.hero-copy{position:relative;z-index:1;max-width:1080px;margin:0 auto;text-align:center}
.hero h1{margin:clamp(18px,3vh,32px) 0 0;padding:clamp(10px,2vh,18px) 0 0;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:clamp(36px,5.4vw,68px);line-height:1.15;letter-spacing:-.03em;color:#1a1424}
.hero .tag{margin:0 0 clamp(16px,3vh,28px);padding:0 0 clamp(8px,1.5vh,14px);max-width:none;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:clamp(24px,3.6vw,44px);line-height:1.25;letter-spacing:-.03em;color:#1a1424}
.hero .tag em{position:relative;font-style:inherit;text-decoration:none;border-bottom:none;padding-bottom:0;color:#5D1F72}
.hero .tag em::after{content:"";position:absolute;left:0;right:0;bottom:-.14em;height:.16em;border-radius:999px;background:#00BF88;transform:rotate(-1.4deg)}
nav.top .btn:hover{background:#fff;color:#5D1F72;border-color:#5D1F72}
nav.top{transition:transform .35s ease}
nav.top.hide{transform:translateY(-110%)}
@media (prefers-reduced-motion:reduce){nav.top{transition:none}}

/* ===================== RESPONSIVE ADDITIONS ===================== */

/* --- Base (mobile-first) --- */
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
img{max-width:100%;height:auto}
.burger{display:none}
.menu-cta{display:none}
.hero h1,.hero .tag{overflow-wrap:break-word}

/* --- Tablet and below: hamburger menu (<=900px) --- */
@media (max-width:900px){
  nav.top{grid-template-columns:1fr auto!important;gap:12px;padding:12px 4vw}
  .brand img{height:36px}
  nav.top .nav-demo{display:none}
  .menu-cta{display:block;list-style:none;padding-top:8px}
  .menu-cta .btn{width:100%;min-height:48px;padding:0 18px;border-radius:8px;font-size:15px}
  .burger{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:1px solid #e3e7ec;border-radius:10px;background:#fff;cursor:pointer;-webkit-tap-highlight-color:transparent}
  .burger span,.burger span::before,.burger span::after{display:block;width:18px;height:2px;border-radius:2px;background:#5D1F72;transition:transform .25s ease,background .2s ease}
  .burger span{position:relative}
  .burger span::before,.burger span::after{content:"";position:absolute;left:0}
  .burger span::before{top:-6px}
  .burger span::after{top:6px}
  nav.top.open .burger span{background:transparent}
  nav.top.open .burger span::before{transform:translateY(6px) rotate(45deg)}
  nav.top.open .burger span::after{transform:translateY(-6px) rotate(-45deg)}
  nav.top .links{display:none!important;position:absolute;left:0;right:0;top:100%;flex-direction:column;gap:0;margin:0!important;padding:8px 4vw 12px;background:#fff;border-bottom:1px solid #eef1f3;box-shadow:0 12px 24px rgba(40,80,120,.12)}
  nav.top.open .links{display:flex!important}
  nav.top .links a{display:flex;align-items:center;min-height:48px;font-size:15px}
}

/* --- Stacked honeycomb for phones AND tablets (<=1100px) --- */
@media (max-width:1100px){
  .cat.stack{padding:8px 0 16px;overflow:visible}
  .cat.stack .hex{gap:2px}
  .cat.stack .seg{stroke-width:1.8}
  .cat.stack .hex span{max-width:80%;line-height:1.12;letter-spacing:-.005em;font-weight:500}
  .cat.stack .lbl{font-size:14px;font-weight:700;line-height:1.2}
  .cat.stack .lbl small{font-size:10.5px;line-height:1.25;font-weight:500;margin-top:3px}
}

/* --- Phones (<=760px): touch-friendly hero buttons --- */
@media (max-width:760px){
  .hero{padding-top:24px;padding-bottom:0}
  .hero h1{margin-top:16px;padding-top:8px;font-size:clamp(30px,8vw,40px)}
  .hero .tag{margin-bottom:0;padding-bottom:6px;font-size:clamp(20px,5.2vw,28px)}
  .wrap{padding-top:28px}
}

/* --- Small phones (<=480px) --- */
@media (max-width:480px){
  .hero{padding-left:16px;padding-right:16px}
  .hero .tag em::after{height:.14em}
  .video h2 em{border-bottom-width:4px}
}

/* --- Large screens (>=1600px): keep content centered --- */
@media (min-width:1600px){
  .wrap{max-width:1800px;margin-left:auto;margin-right:auto}
}
.wrap{padding-bottom:clamp(8px,2vh,20px)}
.video{padding:clamp(20px,3vh,36px) 5vw clamp(40px,6vh,72px);background:#fff}
@media (min-width:761px){.video{padding-top:clamp(56px,7vh,96px)}}
.video h2{margin:0 auto clamp(16px,2.5vh,24px);max-width:1080px;text-align:center;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:clamp(22px,2.1vw + 12px,48px);line-height:1.2;letter-spacing:-.03em;color:#1a1424;overflow-wrap:break-word;text-wrap:balance}
.video h2 em{font-style:inherit;text-decoration:none;border-bottom:5px solid #00BF88;padding-bottom:1px}
@media (max-width:760px){
  .video h2{font-size:clamp(22px,6.4vw,32px);text-wrap:wrap}
  .video h2 span{display:block;white-space:nowrap}
}
.video-frame{position:relative;display:block;width:100%;max-width:1080px;margin:0 auto;aspect-ratio:16/9;border-radius:0;background:#f6f3f8;border:1px solid #e3e7ec;padding:8px;outline:none;box-shadow:none;object-fit:cover;pointer-events:none}
.video-frame::-webkit-media-controls,.video-frame::-webkit-media-controls-enclosure{display:none!important}
@media (max-width:760px){
  .video{padding-left:0;padding-right:0}
  .video h2{padding-left:16px;padding-right:16px}
  .video-frame{width:100%;max-width:none;height:auto;aspect-ratio:auto;object-fit:contain;object-position:center}
}
.customers{padding:clamp(36px,6vh,72px) 5vw clamp(48px,8vh,88px);background:#fff;text-align:center}
.customers h2{margin:0;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:clamp(28px,3vw,40px);line-height:1.2;letter-spacing:-.03em;color:#1a1424}
.customers p{margin:10px auto 0;max-width:520px;font-size:14px;line-height:1.5;color:#6b7280}
.marquee{overflow:hidden;width:100vw;margin:clamp(28px,4vh,44px) calc(50% - 50vw) 0}
.logo-track{display:flex;width:max-content;animation:logo-marquee 28s linear infinite}
.logo-row{display:flex;align-items:center;gap:52px;list-style:none;margin:0;padding:0 26px;flex:none}
.logo-row li{display:flex;align-items:center;color:#8b939e}
.logo-row svg{display:block;height:38px;width:auto}
@keyframes logo-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (max-width:760px){.customers{padding-left:16px;padding-right:16px}.logo-row{gap:36px;padding:0 18px}.logo-row svg{height:32px}}
@media (prefers-reduced-motion:reduce){.logo-track{animation:none;flex-wrap:wrap;justify-content:center;width:auto}.marquee{width:auto;margin-left:auto;margin-right:auto;overflow:visible}}
.usecases{padding:clamp(64px,9vh,112px) 0 clamp(72px,10vh,120px);background:#fff}
.uc-top{max-width:1180px;margin:0 auto;padding:0 5vw;text-align:center}
.usecases h2{margin:0 auto;max-width:16em;text-align:center;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:clamp(28px,3vw,40px);line-height:1.2;letter-spacing:-.03em;color:#1a1424}
.uc-lead{margin:10px auto 0;max-width:520px;font-family:"Public Sans",system-ui,sans-serif;font-size:14px;line-height:1.5;color:#6b7280}
.uc-nav{display:flex;align-items:center;justify-content:flex-end;gap:4px;margin:clamp(28px,4vh,40px) 0 0}
.uc-nav button{width:36px;height:44px;border:0;border-radius:0;background:none;padding:0;cursor:pointer;color:#5D1F72;font-size:28px;font-weight:600;line-height:1}
.uc-nav button:hover:not(:disabled){color:#3E1450}
.uc-nav button:disabled{background:none;color:#c5c9d0;cursor:default}
.uc-nav button:focus-visible{outline:2px solid #5D1F72;outline-offset:3px}
.uc-more:focus-visible{outline:2px solid #5D1F72;outline-offset:3px}
.uc-row{max-width:1180px;margin:clamp(20px,3vh,32px) auto 0;padding:0 5vw}
.uc-card.is-off{display:none}
.uc-card h3{margin:0;max-width:none;text-align:left;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:clamp(28px,3vw,40px);line-height:1.2;letter-spacing:-.03em;color:#1a1424}
.uc-card h3 .uc-p{color:#5D1F72}
.uc-card h3 .uc-g{color:#00BF88}
.uc-points{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px 32px;margin:clamp(22px,3vh,32px) 0 0;padding:0;list-style:none}
.uc-points li{font-family:"Public Sans",system-ui,sans-serif;font-size:14px;line-height:1.5;color:#6b7280}
.uc-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px 32px;margin:clamp(40px,7vh,72px) 0 0}
.uc-stats div{min-width:0}
.uc-stats dt{font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:clamp(28px,3vw,40px);line-height:1.2;letter-spacing:-.03em;color:#1a1424}
.uc-stats dt.uc-p{color:#5D1F72}
.uc-stats dt.uc-g{color:#00BF88}
.uc-stats dd{margin:10px 0 0;max-width:12em;font-family:"Public Sans",system-ui,sans-serif;font-size:14px;line-height:1.5;color:#6b7280}
.uc-more{display:inline-block;margin-top:clamp(28px,4vh,40px);padding:0;color:#5D1F72;font-family:"Public Sans",system-ui,sans-serif;font-size:14px;font-weight:500;text-decoration:none}
.uc-more:hover{text-decoration:underline}
@media (max-width:760px){
  .usecases{padding:clamp(40px,8vh,64px) 0}
  .uc-top{padding:0 16px}
  .usecases h2{max-width:none}
  .uc-row{margin-top:28px;padding:0 16px}
  .uc-points,.uc-stats{grid-template-columns:1fr 1fr;gap:20px 16px}
  .uc-stats{margin-top:36px}
  .uc-stats dd{max-width:none}
}
.story{max-width:720px;margin:0 auto;padding:clamp(48px,8vh,88px) 5vw clamp(72px,10vh,120px)}
.story-back{margin:0 0 18px;max-width:none}
.story-back a{color:#5D1F72;font-size:14px;font-weight:500;text-decoration:none}
.story-back a:hover{text-decoration:underline}
.story h1{margin:0;max-width:none;text-align:left;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:clamp(28px,3vw,40px);line-height:1.2;letter-spacing:-.03em;color:#1a1424}
.story h2{margin:32px 0 0;max-width:none;text-align:left;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:22px;line-height:1.3;letter-spacing:-.03em;color:#1a1424}
.story p{margin:16px 0 0;max-width:none;text-align:left;font-family:"Public Sans",system-ui,sans-serif;font-size:16px;line-height:1.65;color:#1a1424}
.story .story-lead{color:#6b7280}
.story ul{margin:8px 0 0;padding-left:1.2em}
.story li{margin-top:8px;font-family:"Public Sans",system-ui,sans-serif;font-size:16px;line-height:1.65;color:#1a1424}
@media (max-width:760px){.story{padding-left:16px;padding-right:16px}}
.signup{background:#5D1F72;padding:clamp(80px,12vh,140px) 5vw}
.signup-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,400px);gap:clamp(28px,5vw,72px);align-items:center}
.signup h2{margin:0;max-width:520px;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:clamp(32px,3.6vw,48px);line-height:1.15;letter-spacing:-.03em;color:#fff}
.signup-lead{margin:16px 0 0;max-width:420px;font-size:16px;line-height:1.5;color:rgba(255,255,255,.86)}
.signup-card{background:#fff;border-radius:16px;padding:22px 22px 16px;box-shadow:0 12px 32px rgba(40,80,120,.18)}
.signup-card label{display:block;margin:0 0 8px;font-size:13px;font-weight:600;color:#1a1424}
.signup-card input{width:100%;height:46px;border:1px solid #e3e7ec;border-radius:10px;padding:0 14px;font:inherit;font-size:14px;color:#1a1424;background:#fff;outline:0}
.signup-card input:focus{border-color:#5D1F72}
.signup-card .origin-btn{width:100%;height:46px;margin-top:12px;border-radius:10px}
.signup-meta{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:12px 0 0;max-width:none;font-size:12px;line-height:1.4;color:#8b919a}
.signup-meta a{color:#5D1F72;font-weight:600;text-decoration:none;white-space:nowrap}
.signup-meta a:hover{text-decoration:underline}
@media (max-width:760px){.signup{padding-left:16px;padding-right:16px}.signup-inner{grid-template-columns:1fr;gap:28px}.signup-meta{flex-wrap:wrap}}
.reviews{padding:clamp(56px,8vh,88px) 28px clamp(48px,7vh,72px);background:#f3f3f3}
.reviews h3{margin:0;font-family:"Public Sans",system-ui,sans-serif;font-style:normal;font-weight:700;font-size:16px;line-height:1.25;letter-spacing:-.02em;color:#1a1a1a}
.reviews p{margin:8px 0 0;max-width:none;font-family:"Public Sans",system-ui,sans-serif;font-size:12px;font-weight:400;line-height:1.45;color:#8d8d8d}
.reviews strong{display:block;font-family:"Public Sans",system-ui,sans-serif;font-size:13px;font-weight:700;line-height:1.2;color:#1a1a1a}
.rev-co{display:block;font-family:"Public Sans",system-ui,sans-serif;font-size:11px;line-height:1.3;color:#9a9a9a}
.rev-board{display:grid;grid-template-columns:1.15fr .9fr 1.05fr;gap:28px 26px;max-width:1120px;margin:0 auto;align-items:start}
.rev-col{display:flex;flex-direction:column;gap:22px;min-width:0}
.rev-c{position:relative;background:#fff;border-radius:16px;box-shadow:0 10px 28px rgba(0,0,0,.05);box-sizing:border-box}
.rev-dot{display:block;border-radius:50%;background:#e6e6e6;flex:none}
.rev-stars{display:block;width:78px;height:14px;margin-top:12px}
.rev-q{display:block;font-family:"Public Sans",system-ui,sans-serif;font-weight:700;font-size:28px;line-height:.8;color:#1a1a1a}
.rev-q-lg{font-size:42px}
.rev-sign{font-family:"Segoe Script","Brush Script MT",cursive;font-size:18px;line-height:1;color:#c8c8c8}
.rev-scrib{display:block;width:72px;height:20px;flex:none}
.rev-like{display:inline-flex;align-items:center;gap:4px;font-family:"Public Sans",system-ui,sans-serif;font-size:11px;font-weight:600;color:#1a1a1a}
.rev-like svg{width:14px;height:12px;display:block}
.rev-good{width:86%;margin:28px auto 16px;padding:36px 36px 26px;text-align:center}
