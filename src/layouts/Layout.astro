.rev-nav button:disabled{color:#c5c9d0;cursor:default}
.rev-track{position:relative;flex:1;height:2px;background:#e3e5ea}
.rev-fill{position:absolute;left:0;top:0;height:100%;width:36%;background:#1a1424}
.rev-scroller{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;padding:6px 5vw 28px 0;scrollbar-width:none}
.rev-scroller::-webkit-scrollbar{display:none}
.rev-card{flex:0 0 clamp(260px,38%,380px);scroll-snap-align:start;position:relative;display:flex;flex-direction:column;min-height:250px;background:#fff;border-radius:22px;padding:24px 22px 20px;box-shadow:0 10px 28px rgba(40,80,120,.1)}
.rev-card::after{content:"";position:absolute;left:36px;bottom:-7px;width:16px;height:16px;background:#fff;transform:rotate(45deg);border-radius:2px}
.rev-card p{margin:0;max-width:none;font-size:14px;line-height:1.55;color:#3d4450}
.rev-stars{margin:16px 0 0;color:#00BF88;letter-spacing:3px;font-size:15px;line-height:1}
.rev-who{display:flex;align-items:center;gap:10px;margin-top:auto;padding-top:18px}
.rev-ph{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;flex:none;background:linear-gradient(145deg,#f7f2fa,#e4d4ef);color:#5D1F72;font-size:13px;font-weight:600}
.rev-ph.g{background:linear-gradient(145deg,#f3fbf7,#C4EEDF);color:#00A276}
.rev-ph.y{background:linear-gradient(145deg,#FCFDD8,#F6F7A9);color:#5D1F72}
.rev-who strong{display:block;font-size:14px;font-weight:600;color:#1a1424;line-height:1.2}
.rev-who span{display:block;margin-top:2px;font-size:12px;line-height:1.2;color:#8b919a}
@media (max-width:760px){
  .reviews h2{padding:0 16px}
  .rev-row{grid-template-columns:1fr;gap:22px;padding-left:16px}
  .rev-aside h3{max-width:240px}
  .rev-card{flex-basis:min(320px,78vw)}
