---
const { title = "Fusionedge" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500;1,600;1,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Gloria+Hallelujah&family=Gochi+Hand&family=Indie+Flower&family=Kalam:wght@400;700&family=Nanum+Pen+Script&family=Patrick+Hand&family=Shadows+Into+Light&display=swap" rel="stylesheet">
<link rel="icon" href="/Favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/Favicon.png">
<title>{title}</title>
<style is:global>
:root{--bg:#fff;--ink:#111;--muted:#444;--teal:#6B2288;--type-h:clamp(28px,3vw,40px);--type-body:15px;--type-sub:16px;--section-y:clamp(64px,8vh,96px);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{color-scheme:light;background:#fff}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Public Sans",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;overflow-x:clip}
.btn{border-radius:99px;font:inherit;cursor:pointer}
p{font-size:var(--type-body);line-height:1.5;color:var(--muted);max-width:480px;margin:0 auto 30px}
html,body{background:#fff!important}
nav.top{position:relative;z-index:600;isolation:isolate;background:#fff;align-items:center;padding:18px 5vw;border-bottom:1px solid #eef1f3}
nav.top .links{display:flex;gap:30px;list-style:none;padding:0}
nav.top .links a{font-size:var(--type-body);font-weight:500;color:var(--ink);text-decoration:none;cursor:pointer}
nav.top .links a:hover{color:var(--teal)}
nav.top .btn{font-size:var(--type-body);padding:10px 26px;white-space:nowrap}
@media (max-width:760px){nav.top{justify-content:space-between}}
nav.top{display:grid!important;grid-template-columns:1fr auto 1fr;gap:20px}
nav.top .links{margin:0!important;justify-content:center}
nav.top .btn{justify-self:end}
.brand{display:flex;align-items:center;justify-self:start}
.brand img{height:44px;width:auto;display:block;mix-blend-mode:multiply}
@media (max-width:760px){nav.top{grid-template-columns:1fr auto}}
nav.top .btn{background:#5D1F72;color:#fff;border:1px solid #5D1F72;transition:background .3s,color .3s}
body,button,input{font-family:"Public Sans",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif}
nav.top{padding-top:16px;padding-bottom:16px}
.hero{position:relative;max-width:none;display:flex;align-items:center;justify-content:center;padding:var(--section-y) 24px;background:#fff}
.hero-copy{position:relative;z-index:1;width:min(1080px,calc(100vw - 10vw));max-width:1080px;margin:0 auto;text-align:center}
.hero h1{margin:calc(clamp(18px,3vh,32px) - 3px) 0 0;padding:calc(clamp(10px,2vh,18px) - 2px) 0 0;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:clamp(40px,5vw,64px);line-height:1.15;letter-spacing:-.03em;color:#1a1424}
.hero .tag{margin:0 0 clamp(16px,3vh,28px);padding:0 0 clamp(8px,1.5vh,14px);max-width:none;text-align:center;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:500;font-size:clamp(20px,2.3vw,28px);line-height:1.4;letter-spacing:-.03em;color:#1a1424}
.hero .tag em{position:relative;font-style:inherit;text-decoration:none;border-bottom:none;padding-bottom:0;color:#5D1F72}
.hero .tag em::after{content:"";position:absolute;left:0;right:0;bottom:-.14em;height:.16em;border-radius:999px;background:#00BF88;transform:rotate(-1.4deg)}
nav.top .btn:hover{background:#fff;color:#5D1F72;border-color:#5D1F72}

/* ===================== RESPONSIVE ADDITIONS ===================== */

/* --- Base (mobile-first) --- */
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
img{max-width:100%;height:auto}
.burger{display:none}
.menu-cta{display:none}
.hero h1,.hero .tag{overflow-wrap:break-word}

/* --- Tablet and below: hamburger menu (<=900px) --- */
@media (max-width:900px){
  nav.top{grid-template-columns:1fr auto!important;gap:12px;padding:12px 4vw}
  .brand img{height:36px}
  nav.top .nav-demo{display:none}
  .menu-cta{display:block;list-style:none;padding-top:8px}
  .menu-cta .btn{width:100%;min-height:48px;padding:0 18px;border-radius:8px;font-size:15px}
  .burger{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:1px solid #e3e7ec;border-radius:10px;background:#fff;cursor:pointer;-webkit-tap-highlight-color:transparent}
  .burger span,.burger span::before,.burger span::after{display:block;width:18px;height:2px;border-radius:2px;background:#5D1F72;transition:transform .25s ease,background .2s ease}
  .burger span{position:relative}
  .burger span::before,.burger span::after{content:"";position:absolute;left:0}
  .burger span::before{top:-6px}
  .burger span::after{top:6px}
  nav.top.open .burger span{background:transparent}
  nav.top.open .burger span::before{transform:translateY(6px) rotate(45deg)}
  nav.top.open .burger span::after{transform:translateY(-6px) rotate(-45deg)}
  nav.top .links{display:none!important;position:absolute;left:0;right:0;top:100%;flex-direction:column;gap:0;margin:0!important;padding:8px 4vw 12px;background:#fff;border-bottom:1px solid #eef1f3;box-shadow:0 12px 24px rgba(40,80,120,.12)}
  nav.top.open .links{display:flex!important}
  nav.top .links a{display:flex;align-items:center;min-height:48px;font-size:15px}
}

/* --- Phones (<=760px): touch-friendly hero buttons --- */
@media (max-width:760px){
  .hero-copy,.hero .tag{text-align:center}
  .hero h1{margin-top:13px;padding-top:6px;font-size:clamp(32px,10.5vw,40px)}
  .hero .tag{margin-bottom:0;padding-bottom:6px}
}

/* --- Small phones (<=480px) --- */
@media (max-width:480px){
  .hero{padding-left:16px;padding-right:16px}
  .hero .tag em::after{height:.14em}
  .touch h2 em{border-bottom-width:4px}
}

.certs{background:#5D1F72;padding:var(--section-y) 16px;text-align:center;color:#fff}
.certs h2{margin:0;padding-bottom:36px;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:var(--type-h);line-height:1.2;letter-spacing:-.03em;color:#fff}
.certs ul{list-style:none;display:flex;flex-wrap:nowrap;justify-content:center;gap:16px;max-width:1100px;margin:28px auto 0;padding:0}
.certs li{flex:1 1 0;min-width:0;text-align:center}
.certs svg{width:80px;height:80px;display:block;margin:0 auto;background:#fff;border:1px solid #e3e7ec;border-radius:12px}
.certs p{max-width:none;margin:10px 0 0;font-family:"Public Sans",system-ui,sans-serif;font-weight:600;font-size:var(--type-body);line-height:1.35;color:#fff}
.esg-banner{background:#fff;padding:var(--section-y) 0;font-family:"Public Sans",system-ui,sans-serif}
.esg-banner .card{position:relative;width:100%;max-width:none;margin:0;aspect-ratio:2.6/1;background:#fff;border:0;border-radius:0;overflow:hidden}
.esg-banner .esg-fit{position:absolute;top:0;bottom:0;left:max(5vw,calc((100% - 1180px) / 2 + 5vw));right:max(5vw,calc((100% - 1180px) / 2 + 5vw))}
.esg-banner .esg-fit>svg{position:absolute;inset:0;width:100%;height:100%}
.esg-banner .line{stroke-dasharray:3000;stroke-dashoffset:3000}
.esg-banner.in .line{animation:esg-draw 2.8s ease-out forwards}
@keyframes esg-draw{to{stroke-dashoffset:0}}
.esg-banner .head{position:absolute;right:4%;top:8%;width:max-content;max-width:46%}
.esg-banner .esg{position:absolute;left:3.5%;top:36%;font-size:clamp(22px,3.6vw,54px);font-weight:600;letter-spacing:.12em;color:#00BF88}
.esg-banner .kicker{font-size:clamp(9px,.8vw,12px);font-weight:500;letter-spacing:.3em;color:#5D1F72}
.esg-banner h2{margin:0;margin-top:.35em;max-width:none;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:clamp(18px,1.6vw,26px);line-height:1.15;letter-spacing:-.03em;color:#5D1F72}
.esg-banner h2 span{color:#00BF88;font-weight:500}
.esg-banner .cta{display:inline-block;margin-top:1.2em;color:#5D1F72;font-size:clamp(11px,.95vw,14px);font-weight:600;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:2px}
.esg-banner .node{position:absolute;transform:translate(-50%,-50%);width:7.6%;aspect-ratio:1;border-radius:50%;background:#fff;box-shadow:0 8px 20px rgba(0,0,0,.08),inset 0 -3px 0 #f3eef6;border:1.5px solid rgba(0,191,136,.35);display:grid;place-items:center;color:#5D1F72;font-size:clamp(12px,1.35vw,20px);font-weight:600;letter-spacing:-.02em;opacity:0}
.esg-banner.in .node{animation:esg-pop .5s forwards}
.esg-banner .node.n-sm{font-size:clamp(9px,.95vw,14px)}
@keyframes esg-pop{from{opacity:0;transform:translate(-50%,-50%) scale(.6)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}
.esg-banner .lbl{position:absolute;top:41%;transform:translateX(-50%);width:10.5%;text-align:center}
.esg-banner .lbl svg{position:static;width:clamp(22px,2.4vw,36px);height:auto;margin:0 auto .5em;display:block}
.esg-banner .lbl b{display:block;font-size:clamp(12px,1.2vw,17px);font-weight:500;color:#5D1F72}
.esg-banner .lbl p{max-width:none;margin:.3em auto 0;font-size:clamp(9px,.8vw,12px);line-height:1.45;color:#7d6a86}
.esg-banner .lf{transform-box:fill-box;transform-origin:0 100%}
.esg-banner .lf path:first-child{transform-origin:0 0}
.esg-banner.in .lf path:first-child{animation:esg-sway 4s ease-in-out infinite alternate}
@keyframes esg-sway{to{transform:rotate(6deg)}}
.esg-banner .v-wrap{display:none;container-type:inline-size;width:min(100%,560px);margin:0 auto}
.esg-banner .v-card{position:relative;width:100%;aspect-ratio:600/1620;background:#fff;color:#5D1F72;font-size:3.1cqw;border:1px solid #e3e7ec;border-radius:16px;box-shadow:0 16px 40px rgba(40,80,120,.18);overflow:hidden}
.esg-banner .v-card>svg{position:absolute;inset:0;width:100%;height:100%}
.esg-banner .v-line{stroke-dasharray:4000;stroke-dashoffset:4000}
.esg-banner .v-top{position:absolute;left:0;right:0;top:3%;text-align:left;padding:0 8%}
.esg-banner .v-esg{font-size:3.4em;font-weight:600;letter-spacing:.12em;color:#00BF88;line-height:1}
.esg-banner .v-kicker{margin-top:.9em;font-size:.8em;font-weight:500;letter-spacing:.3em;color:#5D1F72}
.esg-banner .v-h1{margin-top:.5em;font-size:1.85em;font-weight:400;line-height:1.2;letter-spacing:-.02em;color:#5D1F72}
.esg-banner .v-h1 span{color:#00BF88;font-weight:500}
.esg-banner .v-cta{display:inline-block;margin-top:.9em;color:#5D1F72;font-size:1em;font-weight:600;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:2px}
.esg-banner .v-node{position:absolute;transform:translate(-50%,-50%) scale(.6);width:18%;aspect-ratio:1;border-radius:50%;background:#fff;box-shadow:0 .5em 1.2em rgba(0,0,0,.08),inset 0 -3px 0 #f3eef6;border:1.5px solid rgba(0,191,136,.35);display:grid;place-items:center;color:#5D1F72;font-size:1.45em;font-weight:600;letter-spacing:-.02em;opacity:0;transition:opacity .45s ease,transform .45s ease}
.esg-banner .v-node.on{opacity:1;transform:translate(-50%,-50%) scale(1)}
.esg-banner .v-lbl{position:absolute;transform:translate(-50%,-50%);width:46%;text-align:center;opacity:0;transition:opacity .45s ease}
.esg-banner .v-lbl.on{opacity:1}
.esg-banner .v-lbl svg{position:static;width:2.4em;height:auto;margin:0 auto .5em;display:block}
.esg-banner .v-lbl b{display:block;font-size:1.25em;font-weight:500;color:#5D1F72}
.esg-banner .v-lbl p{max-width:none;margin:.3em auto 0;font-size:.9em;line-height:1.45;color:#7d6a86}
.esg-banner .v-lf path:first-child{transform-origin:0 0}
.esg-banner.grown .v-lf path:first-child{animation:esg-vsway 4s ease-in-out infinite alternate}
@keyframes esg-vsway{to{transform:rotate(6deg)}}
@media (max-width:860px){
  .esg-banner{padding-left:16px;padding-right:16px}
  .esg-banner .card{display:none}
  .esg-banner .v-wrap{display:block}
}
@media (prefers-reduced-motion:reduce){
  .esg-banner .line,.esg-banner .v-line{animation:none;stroke-dashoffset:0}
  .esg-banner .node,.esg-banner .v-node{animation:none;opacity:1;transform:translate(-50%,-50%)}
  .esg-banner .v-lbl{opacity:1}
  .esg-banner .lf path:first-child,.esg-banner .v-lf path:first-child{animation:none}
}
@media (max-width:760px){
  .certs{padding:var(--section-y) 16px}
  .certs h2{padding-bottom:8px}
  .certs ul{flex-wrap:wrap;justify-content:center;gap:22px 16px;max-width:420px;margin-top:16px}
  .certs li{flex:0 0 calc(50% - 8px)}
  .certs svg{width:52px;height:52px}
  .certs p{font-size:var(--type-body)}
}
.customers{padding:var(--section-y) 5vw;background:#5D1F72;text-align:center}
.customers h2{margin:0;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:var(--type-h);line-height:1.2;letter-spacing:-.03em;color:#fff}
.customers p{margin:14px auto 0;max-width:640px;font-size:var(--type-body);line-height:1.5;color:#fff}
.marquee{overflow:hidden;width:100vw;margin:clamp(68px,8vh,88px) calc(50% - 50vw) 0}
.logo-track{display:flex;width:max-content;animation:logo-marquee 28s linear infinite}
.logo-row{display:flex;align-items:center;gap:64px;list-style:none;margin:0;padding:0 32px;flex:none}
.logo-row li{display:flex;align-items:center}
.logo-row img{display:block;height:24px;width:auto}
.logo-row img.is-mark{height:40px}
@keyframes logo-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (max-width:760px){.customers{padding-left:16px;padding-right:16px}.logo-row{gap:40px;padding:0 20px}.logo-row img{height:20px}.logo-row img.is-mark{height:34px}}
@media (prefers-reduced-motion:reduce){.logo-track{animation:none;flex-wrap:wrap;justify-content:center;width:auto}.marquee{width:auto;margin-left:auto;margin-right:auto;overflow:visible}}
.usecases{position:relative;z-index:0;box-sizing:border-box;display:flex;flex-direction:column;height:100dvh;padding:clamp(8px,1.4vh,16px) 0 0;overflow:hidden;background:#5D1F72}
.uc-top{flex:none;max-width:1180px;margin:0 auto;padding:18px 5vw 0;text-align:center}
.usecases h2{margin:0 auto;max-width:16em;text-align:center;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:var(--type-h);line-height:1.2;letter-spacing:-.03em;color:#fff}
.uc-lead{margin:4px auto 0;max-width:520px;font-family:"Public Sans",system-ui,sans-serif;font-size:var(--type-body);line-height:1.5;color:rgba(255,255,255,.8)}
.cs{flex:1;min-height:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;width:100%;overflow:clip;user-select:none;-webkit-user-select:none}
.cs__stage{position:relative;z-index:1;flex:none;width:100%;max-width:1280px;height:340px;display:flex;align-items:center;justify-content:center}
.cs__stage:focus-visible{outline:2px solid #fff;outline-offset:4px}
.cs__drag{position:absolute;inset:0;z-index:500;cursor:grab;touch-action:pan-y}
.cs__drag:active{cursor:grabbing}
.cs-card{position:absolute;width:223px;height:333px;border-radius:0;overflow:hidden;background:#fff url(/card-wave-white.svg?v=1) center/cover no-repeat;pointer-events:none;box-shadow:0 24px 44px -20px rgba(0,0,0,.45)}
.cs-card:nth-child(even){background:#fdfcf7 url(/card-wave.svg?v=alt) center/cover no-repeat}
.cs-card::before{content:"";position:absolute;inset:0;background:none;pointer-events:none}
.cs-card__dim{position:absolute;inset:0;background:#f4f4f4;pointer-events:none}
.cs-card:nth-child(even) .cs-card__dim{background:#f7f2e4}
.cs-card__body{position:relative;z-index:1;height:100%;box-sizing:border-box;display:flex;flex-direction:column;padding:16px 14px 14px;color:#5D1F72}
.cs-card__badge{align-self:flex-start;padding:2px 8px;border-radius:999px;border:1px solid #5D1F72;background:transparent;font-family:"Public Sans",system-ui,sans-serif;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#5D1F72}
.cs-card__text{display:flex;flex-direction:column;justify-content:space-between;flex:1;min-height:0;margin-top:16px;text-align:left}
.cs-card__title{margin:0;max-width:none;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:15px;line-height:1.25;letter-spacing:-.02em;color:#5D1F72}
.cs-card__title .uc-g{color:#00A276}
.cs-card__desc{margin:0;max-width:none;font-family:"Public Sans",system-ui,sans-serif;font-size:12px;font-style:italic;font-weight:500;line-height:1.4;color:#6f5a78}
.cs-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px 10px;margin:0;padding:0}
.cs-stats div{min-width:0}
.cs-stats b{display:block;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:16px;line-height:1.15;letter-spacing:-.02em;color:#5D1F72}
.cs-stats b.uc-g{color:#00A276}
.cs-stats span{display:block;margin-top:2px;font-family:"Public Sans",system-ui,sans-serif;font-size:10px;font-style:normal;font-weight:500;line-height:1.3;color:#6f5a78}
@media (min-width:640px){
  .cs__stage{height:386px}
  .cs-card{width:303px;height:373px}
  .cs-card__body{padding:18px 22px 16px}
  .cs-card__badge{padding:4px 12px;font-size:11px}
  .cs-card__title{font-size:16px}
  .cs-stats{gap:6px 8px}
  .cs-stats b{font-size:16px}
  .cs-stats span{font-size:11px}
}
@media (min-width:1024px){
  .cs__stage{height:378px}
  .cs-card{width:343px;height:370px}
  .cs-card__body{padding:20px 26px 18px}
  .cs-card__title{font-size:17px}
}
@media (max-width:760px){
  .uc-top{padding:16px 16px 0}
  .usecases h2{max-width:none}
}
@media (max-width:639px){
  .cs-card__body{padding:14px 16px 12px}
  .cs-card__text{margin-top:12px}
  .cs-card__title{font-size:13px;line-height:1.2}
  .cs-stats{gap:4px 6px}
  .cs-stats b{font-size:14px}
}
.story{max-width:720px;margin:0 auto;padding:var(--section-y) 5vw}
.story-back{margin:0 0 18px;max-width:none}
.story-back a{color:#5D1F72;font-size:var(--type-body);font-weight:500;text-decoration:none}
.story-back a:hover{text-decoration:underline}
.story h1{margin:0;max-width:none;text-align:left;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:var(--type-h);line-height:1.2;letter-spacing:-.03em;color:#1a1424}
.story h2{margin:32px 0 0;max-width:none;text-align:left;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:var(--type-h);line-height:1.2;letter-spacing:-.03em;color:#1a1424}
.story p{margin:16px 0 0;max-width:none;text-align:left;font-family:"Public Sans",system-ui,sans-serif;font-size:var(--type-body);line-height:1.5;color:#1a1424}
.story .story-lead{color:#6b7280}
.story ul{margin:8px 0 0;padding-left:1.2em}
.story li{margin-top:8px;font-family:"Public Sans",system-ui,sans-serif;font-size:var(--type-body);line-height:1.5;color:#1a1424}
@media (max-width:760px){.story{padding-left:16px;padding-right:16px}}
.touch{isolation:isolate;background:#fff;padding:var(--section-y) 5vw 28px;font-family:"Public Sans",system-ui,sans-serif;color:#1a1424}
.touch-wrap{max-width:1080px;margin:0 auto}
.touch h2{margin:0;max-width:none;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:var(--type-h);line-height:1.2;letter-spacing:-.03em;color:#1a1424}
.touch h2 em{font-style:inherit;text-decoration:none;border-bottom:5px solid #00BF88;padding-bottom:1px}
.touch h3{margin:0;font-family:"Public Sans",system-ui,sans-serif;font-style:normal;font-weight:600;font-size:var(--type-sub);line-height:1.3;letter-spacing:-.02em;color:#1a1424}
