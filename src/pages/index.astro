  const wrap=board.parentElement;
  if(mode==='mobile'&&wrap){
    const s=parseFloat((board.style.transform.match(/scale\(([^)]+)\)/)||[])[1])||1;
    wrap.style.overflow='hidden';
    wrap.style.height=(box.bottom+10)*s+'px';
