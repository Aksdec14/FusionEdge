let gAlt=0;const icMemo={};
function icSet(t){if(t[1]==='p')return'p';if(!(t[0] in icMemo))icMemo[t[0]]=(gAlt++%2)?'g2':'g1';return icMemo[t[0]];}

function hexVerts(c,R){return[0,60,120,180,240,300].map(a=>{const r=a*Math.PI/180;return[c.x+R*Math.cos(r),c.y+R*Math.sin(r)];});}
function outlinePath(centers,R){
  const k=p=>p[0].toFixed(1)+','+p[1].toFixed(1);const edges=new Map();
  centers.forEach(c=>{const v=hexVerts(c,R);for(let i=0;i<6;i++){const a=v[i],b=v[(i+1)%6];
    const key=[k(a),k(b)].sort().join('|');const e=edges.get(key);if(e)e.n++;else edges.set(key,{a,b,n:1});}});
  const outer=[...edges.values()].filter(e=>e.n===1);const adj=new Map();
  outer.forEach((e,i)=>[k(e.a),k(e.b)].forEach(key=>{if(!adj.has(key))adj.set(key,[]);adj.get(key).push(i);}));
  const used=new Set();let d='';
  outer.forEach((e,i)=>{if(used.has(i))return;used.add(i);let cur=e.b;d+=`M${e.a[0]},${e.a[1]}L${cur[0]},${cur[1]}`;
    for(;;){const n=(adj.get(k(cur))||[]).find(j=>!used.has(j));if(n===undefined)break;used.add(n);
      const ne=outer[n];cur=k(ne.a)===k(cur)?ne.b:ne.a;d+=`L${cur[0]},${cur[1]}`;}d+='Z';});
  return d;
}

function build(){
    const m=innerWidth<=760?'mobile':'desktop';
  if(m!==mode){
    mode=m;stage.innerHTML='';
    const R=m==='desktop'?84:76,gap=m==='desktop'?16:10,rS=R,hS=Math.sqrt(3)*rS,pitch=rS+gap/Math.sqrt(3),dx=1.5*pitch,row=Math.sqrt(3)*pitch,LH=46,GAP=10,TOP=m==='desktop'?132:24,BOT=m==='desktop'?150:24;
    modules.classList.toggle('compact',m!=='desktop');
    const MC=[];[7,6,7,6].forEach((n,c)=>{for(let r=0;r<n;r++)MC.push([c,r]);});
    MC.sort((a,b)=>(a[1]+(a[0]%2?.5:0))-(b[1]+(b[0]%2?.5:0))||a[0]-b[0]);
    const pos=(t,i)=>m==='desktop'?[t[3],t[4]]:MC[i];
    const wrap=document.createElement('div');wrap.className='board-wrap';
    board=document.createElement('div');board.className='board';
    let W=0,H=0;
    TILES.forEach((t,i)=>{
      const[c,r]=pos(t,i);const cx=c*dx+rS,cy=TOP+r*row+(c%2?row/2:0)+hS/2;
      W=Math.max(W,cx+rS);H=Math.max(H,cy+hS/2+BOT);
      const el=document.createElement('div');el.className='tile';el.dataset.name=t[0];el._c={x:cx,y:cy};
      el._home={left:(cx-rS)+'px',top:(cy-hS/2)+'px',x:cx,y:cy};
      el.style.cssText+=`left:${cx-rS}px;top:${cy-hS/2}px;width:${2*rS}px;height:${hS}px`;
      el.innerHTML=`<div class="hex"></div><svg class="ic ${icSet(t)}" viewBox="2 2.5 45 44" aria-hidden="true">${byName[t[0]][1]}</svg><span>${t[0]}</span>`;
      board.appendChild(el);
    });
    board.style.width=W+'px';board.style.height=H+'px';
    const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.setAttribute('class','outline');
    svg.setAttribute('viewBox',`0 0 ${W} ${H}`);svg.setAttribute('width',W);svg.setAttribute('height',H);
    board.appendChild(svg);
    LAYERS=[...VIEWS.products.map((_,i)=>'s'+i),'pick'].map(id=>{
