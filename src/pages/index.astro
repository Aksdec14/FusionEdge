}
async function play(v,delay=0){
  const me=++run;
  await runView(v,me,delay);
}
async function tour(delay){
  const me=++run;
  const order=['products','industries','roles'];
  let step=0,gap=delay;
  while(me===run){
    if(!await runView(order[step],me,gap)||me!==run)return;
    gap=400;
    step=(step+1)%order.length;
  }
}
tabs.forEach(t=>t.addEventListener('click',()=>{ if(!entered)enter(true); play(t.dataset.view,200); }));

function enter(noLoop){
  if(entered)return;entered=true;
  const tiles=board.querySelectorAll('.tile');
  if(reduced){tiles.forEach(t=>{t.style.transition='none';t.classList.add('in');});if(!noLoop)play('products');return;}
  tiles.forEach((t,i)=>setTimeout(()=>t.classList.add('in'),i*35));
  if(!noLoop)tour(1300);
}

build();
addEventListener('resize',build);
new IntersectionObserver((ents,obs)=>{if(ents.some(e=>e.isIntersecting)){enter();obs.disconnect();}},{threshold:.2})
  .observe(modules);
(function(){
const row=document.querySelector(".uc-row");
if(!row)return;
const cards=[...row.querySelectorAll(".uc-card")];
const prev=document.querySelector(".uc-prev"),next=document.querySelector(".uc-next");
let page=0,shown=-1;
const per=()=>1;
const reduce=matchMedia("(prefers-reduced-motion: reduce)");
function count(dt){
if(!dt.dataset.n)dt.dataset.n=dt.textContent.trim();
const m=dt.dataset.n.match(/^(.*?)([\d,.]+)(.*)$/);
if(!m||reduce.matches){dt.textContent=dt.dataset.n;return}
if(dt._raf)cancelAnimationFrame(dt._raf);
const raw=m[2].replace(/,/g,""),decimals=(raw.split(".")[1]||"").length,target=parseFloat(raw),commas=m[2].includes(","),start=performance.now();
const text=v=>{const num=decimals?v.toFixed(decimals):(commas?Math.round(v).toLocaleString("en-US"):String(Math.round(v)));return m[1]+num+m[3]};
const tick=now=>{const t=Math.min(1,(now-start)/900),eased=1-Math.pow(1-t,3);dt.textContent=t<1?text(target*eased):dt.dataset.n;if(t<1)dt._raf=requestAnimationFrame(tick)};
dt.textContent=text(0);
dt._raf=requestAnimationFrame(tick);
}
const show=()=>{const n=per(),max=Math.max(0,Math.ceil(cards.length/n)-1);if(page>max)page=max;const fresh=page!==shown;shown=page;cards.forEach((card,i)=>{const on=i>=page*n&&i<page*n+n;card.classList.toggle("is-off",!on);if(on&&fresh)card.querySelectorAll("dt").forEach(count)});prev.disabled=page===0;next.disabled=page>=max};
prev.addEventListener("click",()=>{page--;show()});
next.addEventListener("click",()=>{page++;show()});
addEventListener("resize",show);
show();
})();
</script>
<script is:inline>
(function(){
  var root=document.querySelector('.esg-banner');
  if(!root)return;
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  var phone=matchMedia('(max-width:860px)');
  var card=root.querySelector('.card');
  var vcard=root.querySelector('.v-card');
  var vline=root.querySelector('.v-line');
  var vnodes=[].slice.call(root.querySelectorAll('.v-node'));
  var vlbls=[].slice.call(root.querySelectorAll('.v-lbl'));
  var len=0;
  var desk;
  function measure(){
    if(!vline||!phone.matches)return;
    var n=vline.getTotalLength();
    if(!n)return;
    len=n;
    vline.style.strokeDasharray=String(len);
  }
  function armDesktop(){
    if(root.classList.contains('in')||desk)return;
    desk=new IntersectionObserver(function(ents,obs){
      if(!ents.some(function(e){return e.isIntersecting}))return;
      root.classList.add('in');
      obs.disconnect();
      desk=null;
    },{threshold:.25});
    desk.observe(card);
  }
  function onScroll(){
    if(!phone.matches||!vcard)return;
    if(!len)measure();
    var r=vcard.getBoundingClientRect();
    var trigger=innerHeight*.72;
    var p=(trigger-(r.top+r.height*.2))/(r.height*.72);
    if(p<0)p=0;
    if(p>1)p=1;
    if(len)vline.style.strokeDashoffset=String(len*(1-p));
    vnodes.forEach(function(n,i){
      var nr=n.getBoundingClientRect();
      var on=nr.top+nr.height*.5<trigger;
      n.classList.toggle('on',on);
      if(vlbls[i])vlbls[i].classList.toggle('on',on);
    });
    root.classList.toggle('grown',p>.92);
  }
  function apply(){
    if(phone.matches){
      if(desk){desk.disconnect();desk=null}
      root.classList.remove('in');
      measure();
      onScroll();
    }else{
      root.classList.remove('grown');
      vnodes.forEach(function(n,i){n.classList.remove('on');if(vlbls[i])vlbls[i].classList.remove('on')});
      armDesktop();
    }
  }
  addEventListener('scroll',onScroll,{passive:true});
  addEventListener('resize',function(){measure();apply()});
  if(phone.addEventListener)phone.addEventListener('change',apply);
  apply();
})();
</script>
