        }

        root.addEventListener("click", function (e) {
          var t = e.target;
          var nav = t.closest("[data-nav]");
          if (nav) { root.querySelectorAll("[data-nav]").forEach(function (b) { b.classList.toggle("on", b === nav); }); $("d-crumb").textContent = nav.getAttribute("data-nav") === "Overview" ? "Dashboard" : nav.getAttribute("data-nav"); return; }
          if (t.closest("#d-collapse")) { root.classList.toggle("collapsed"); return; }
          var ut = t.closest("[data-ut]");
