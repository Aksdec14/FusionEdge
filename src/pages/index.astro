          $("d-ucount").innerHTML = "<b>" + list.length + "</b> " + (uq ? "matching" : "new") + " activities " + (utab === "week" ? "this week" : utab);
          $("d-ulist").innerHTML = list.length ? list.map(function (u) {
            return '<li class="u-item"><span class="u-ic"><i style="background:' + u[0] + '"></i></span><div><strong>' + esc(u[1]) + "</strong><small>" + esc(u[3]) + "</small></div><time>" + u[2] + "</time></li>";
          }).join("") : '<li class="u-empty">No activities found</li>';
        }
