---
// Fusionedge landing page — wireframe version (images and videos are placeholders; hero module icons are real SVGs)
const nav = ["Apps", "Industries", "Community", "Pricing", "Help"];
const cards = {
  left: [
    { t: "Open source", d: "Behind the technology is a community of developers collaborating worldwide, united by a common vision: to transform companies and empower employees.", extra: ["Community: Open Source, 100% free.", "Enterprise: extra apps, infrastructure and professional services."], btn: "Compare Editions" },
    { t: "Open Source + AI", d: "Develop or vibe-code tailored modules. As we are open source, LLMs are already trained on our source code.", ph: "Code editor screenshot" },
    { t: "Community apps", d: "Thanks to its open source model, Fusionedge grows into a large business apps store. Imagine getting an app for every business need.", btn: "Browse Community Apps" },
    { t: "No corporate nonsense", q: "“With most systems, you get 70% of what you hoped. With Fusionedge, you get more than you expected.” — Anonymous competitor" },
  ],
  right: [
    { t: "No vendor lock-in", d: "No proprietary data format, just PostgreSQL: you own your data. Get the source code, GitHub access, and the flexibility to host with us or on premise.", btn: "Follow us on GitHub" },
    { t: "Fair pricing", d: "No usage-based pricing, no feature upselling, no long term contracts, no hosting limits, no surprises. Just a single price per user, all inclusive.", btn: "View Pricing" },
    { t: "A unique value proposition", ph: "Positioning chart" },
  ],
};
// Hero modules: [module, what teams use without Fusionedge]
const modules = [
  ["Asset Register", "Excel sheets"], ["Work Orders", "WhatsApp groups"], ["PPM", "Paper checklists"],
  ["Smart Ticketing", "Email threads"], ["Utilities", "Manual meter logs"], ["Visitor Management", "Paper logbook"],
  ["Room Booking", "Shared calendars"], ["Inbox", "Email approvals"], ["Inventory", "Stock registers"], ["ESG", "Consultant reports"],
];
// Two-tone brand icons (24x24 viewBox) for each hero module
const P = "#5D1F71", G = "#00BE87";
const icons = {
  "Asset Register": `<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z" stroke="${P}"/><path d="M4 7.5l8 4.5 8-4.5" stroke="${G}"/><path d="M12 12v9" stroke="${P}"/>`,
  "Work Orders": `<rect x="5" y="4" width="14" height="17" rx="2.5" stroke="${P}"/><path d="M9 4h6v3H9z" stroke="${P}"/><path d="M8.5 14l2.5 2.5 4.5-5" stroke="${G}"/>`,
  "PPM": `<rect x="3.5" y="5" width="17" height="15" rx="2.5" stroke="${P}"/><path d="M3.5 10h17M8 3v4M16 3v4" stroke="${P}"/><path d="M9 15l2 2 4-4" stroke="${G}"/>`,
  "Smart Ticketing": `<path d="M4 7h16v3a2 2 0 0 0 0 4v3H4v-3a2 2 0 0 0 0-4z" stroke="${P}"/><path d="M14 7v10" stroke="${G}" stroke-dasharray="2 2"/>`,
  "Utilities": `<path d="M13 2.5L5 13.5h6l-1 8 8-11h-6z" stroke="${P}"/><path d="M19 3.5c1.2 1.6 1.8 2.6 1.8 3.4a1.8 1.8 0 0 1-3.6 0c0-.8.6-1.8 1.8-3.4z" stroke="${G}"/>`,
  "Visitor Management": `<rect x="3" y="5" width="18" height="14" rx="2.5" stroke="${P}"/><circle cx="9" cy="11" r="2" stroke="${G}"/><path d="M6.5 16c.4-1.4 1.4-2 2.5-2s2.1.6 2.5 2M14.5 10h4M14.5 13.5h3" stroke="${P}"/>`,
  "Room Booking": `<rect x="3.5" y="4" width="17" height="16" rx="2.5" stroke="${P}"/><path d="M3.5 9h17" stroke="${P}"/><rect x="7" y="12" width="4" height="4" rx="1" stroke="${G}"/>`,
  "Inbox": `<path d="M3.5 13l2.7-7.5A2 2 0 0 1 8 4.2h8a2 2 0 0 1 1.9 1.3L20.5 13v4.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z" stroke="${P}"/><path d="M3.5 13h5l1.2 2.5h4.6l1.2-2.5h5" stroke="${G}"/>`,
  "Inventory": `<path d="M3 8l9-4.5 9 4.5-9 4.5z" stroke="${P}"/><path d="M3 12.5l9 4.5 9-4.5" stroke="${G}"/><path d="M3 17l9 4.5 9-4.5" stroke="${P}"/>`,
  "ESG": `<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z" stroke="${P}"/><path d="M5 19c3-4 6-6.5 9-8" stroke="${G}"/>`,
};
// Icons for the "without Fusionedge" side of each card (muted gray + purple accent)
const M = "#6B6670", A = "#5D1F71";
const altIcons = {
  "Excel sheets": `<rect x="4" y="4" width="16" height="16" rx="2.5" stroke="${M}"/><path d="M4 9.5h16M4 14.5h16" stroke="${M}"/><path d="M10 4v16" stroke="${A}"/>`,
  "WhatsApp groups": `<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5H10l-4 4v-4H5.5A1.5 1.5 0 0 1 4 14.5z" stroke="${M}"/><path d="M8.5 10h.01M12 10h.01M15.5 10h.01" stroke="${A}" stroke-width="2.4"/>`,
  "Paper checklists": `<path d="M6 3h12v18H6z" stroke="${M}"/><path d="M9 8h6M9 12h6M9 16h3" stroke="${M}"/><path d="M13.5 16.5l1.3 1.3 2.4-2.8" stroke="${A}"/>`,
  "Email threads": `<rect x="3" y="6" width="18" height="13" rx="2.5" stroke="${M}"/><path d="M3.5 8l8.5 6 8.5-6" stroke="${A}"/><path d="M6 3.5h12" stroke="${M}"/>`,
  "Manual meter logs": `<rect x="5" y="3" width="14" height="18" rx="2" stroke="${M}"/><circle cx="12" cy="10.5" r="3.5" stroke="${A}"/><path d="M12 10.5l1.6-1.6" stroke="${A}"/><path d="M8.5 17h7" stroke="${M}"/>`,
  "Paper logbook": `<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v15H6.5A2.5 2.5 0 0 0 4 20.5z" stroke="${M}"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H19v-5" stroke="${M}"/><path d="M9 8h6M9 11.5h4" stroke="${A}"/>`,
  "Shared calendars": `<rect x="3.5" y="5" width="17" height="15" rx="2.5" stroke="${M}"/><path d="M3.5 10h17M8 3v4M16 3v4" stroke="${M}"/><circle cx="9.5" cy="14.5" r="1.4" stroke="${A}"/><circle cx="14.5" cy="14.5" r="1.4" stroke="${A}"/>`,
  "Email approvals": `<rect x="3" y="6" width="18" height="13" rx="2.5" stroke="${M}"/><path d="M3.5 8l8.5 6 8.5-6" stroke="${M}"/><path d="M15 16l1.7 1.7 3.3-3.7" stroke="${A}"/>`,
  "Stock registers": `<path d="M12 3l8 4v10l-8 4-8-4V7z" stroke="${M}"/><path d="M4 7l8 4 8-4" stroke="${M}"/><path d="M12 11v10" stroke="${A}"/>`,
  "Consultant reports": `<path d="M6 3h9l4 4v14H6z" stroke="${M}"/><path d="M15 3v4h4" stroke="${M}"/><path d="M9.5 17v-3M12.5 17v-5M15.5 17v-2" stroke="${A}"/>`,
};
const groups = [
  { h: "Assets & Maintenance", m: ["Asset Register", "Asset Audit", "Asset Readings", "PPM", "Digital Checklists", "Work Orders", "Vendors"] },
  { h: "Service & Approvals", m: ["Tickets", "Smart Ticketing", "Inbox", "Incidents", "Mailroom", "Communication Studio"] },
  { h: "Workplace", m: ["Visitor Management", "Parking", "Room Booking", "Attendance", "Cafeteria"] },
  { h: "Utilities & Sustainability", m: ["Utilities", "Readings", "ESG", "Compliance"] },
  { h: "Procurement & Records", m: ["Inventory", "Purchase Orders", "Vault"] },
  { h: "Insights & Control", m: ["CXO", "Presentation", "DMR", "Exports", "Billing Enforcement"] },
];
const links = [
  ["Asset Register", "Asset Audit, Asset Readings, Tickets, PPM, Vendors", "Shared asset record"],
  ["Digital Checklists and PPM", "Work Orders", "Execution generates orders"],
  ["PPM and Work Orders", "Inbox", "Bulk and single approvals"],
  ["Utilities", "Smart Ticketing", "“Suggest ticket” on an alert"],
  ["Readings, Attendance, Incidents, PPM, Vault, Compliance", "ESG", "Connectors"],
  ["Utilities", "ESG", "Period totals"],
  ["Visitor Management", "Parking", "Optional overlap guard"],
  ["Room Booking", "Outlook and Teams", "Calendar sync"],
  ["Attendance", "Cafeteria", "Roster sync"],
  ["Visitor Management", "Cafeteria", "Optional visitor pick list"],
  ["Inventory", "Purchase Orders", "Same order tables"],
  ["Purchase Orders", "Vault", "Optional OCR"],
  ["Communication Studio", "Mailroom, Visitors, Tickets, Work Orders", "Template variables"],
  ["Billing Enforcement", "Exports, Communications, DMR", "Blocks"],
  ["Enabled modules", "CXO, Presentation, DMR", "Widgets and slides"],
];
const pattern = ["gray", "purple", "light", "gray", "green", "light", "gray", "purple", "light", "gray", "green", "light"];
const faces = Array.from({ length: 36 }, (_, i) => {
  const c = pattern[(i + Math.floor(i / 12) * 4) % 12];
  return c + (c === "purple" || c === "green" ? (i % 2 ? " swap" : "") : "");
});
const footerCols = [
  { h: "Product", l: ["Apps", "AI", "Integrations", "Pricing"] },
  { h: "Solutions", l: ["Industries", "Accounting", "CRM", "Inventory"] },
  { h: "Resources", l: ["Blog", "Guides", "Community", "Help"] },
  { h: "Company", l: ["About", "Careers", "Contact", "Partners"] },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;500&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>Fusionedge — All your business on one platform</title>
  </head>
  <body>
    <div class="wrap">
      <!-- NAV -->
      <header class="nav" id="site-nav">
        <a class="logo" href="/"><img src="/logo.png" alt="Fusionedge" width="400" height="127" loading="eager" /></a>
        <nav class="nav-links" id="nav-links" aria-label="Main">
          {nav.map((n) => <a href="#">{n}</a>)}
          <a class="nav-links-cta" href="#">Try it free</a>
        </nav>
        <div class="nav-cta">
          <a class="signin" href="#">Sign in</a>
          <a class="btn btn-primary" href="#">Try it free</a>
          <button class="menu-btn" id="menu-btn" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links"><span></span><span></span><span></span></button>
        </div>
      </header>

      <!-- HERO -->
      <section class="hero">
        <div class="hero-in">
          <p class="ratings">
            <span><i class="mini"></i>4.6 Google</span>
            <span><i class="mini star"></i>4.9 Trustpilot</span>
          </p>
          <h1>All your business on <span class="hl">one platform _</span></h1>
          <p class="h1-sub">Simple, efficient, yet <span class="ul-b">affordable!</span></p>
          <div class="btn-row">
            <a class="btn btn-primary btn-lg" href="#">Start now - It's free</a>
            <button class="btn btn-outline btn-lg" type="button" data-explore>Explore platform</button>
            
          </div>
          <div class="hero-toggle">
            <button class="toggle" data-without type="button" role="switch" aria-checked="false">
              <span class="sparks" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="sw"></span> Imagine without Fusionedge
            </button>
          </div>
        </div>
        <ul class="flipgrid">
          {modules.map(([n, alt], i) => (
            <li class="fc" style={`--i:${i}`}>
              <div class="fc-in">
                <div class="fc-f">
                  <span class="tile"><svg class="oi" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[n]}></svg></span>
                  <span class="fc-name">{n}</span>
                </div>
                <div class="fc-b" aria-hidden="true">
                  <span class="tile off"><svg class="oi" viewBox="0 0 24 24" aria-hidden="true" set:html={altIcons[alt]}></svg></span>
                  <span class="fc-alt"><small>Without Fusionedge</small><b>{alt}</b></span>
                </div>
              </div>
            </li>
          ))}
          <li class="more"><button type="button" data-explore>and <b>44</b> more apps →</button></li>
        </ul>
      </section>

      <dialog class="mods" id="mods" aria-labelledby="mods-title">
        <div class="mods-head">
          <h3 id="mods-title">One platform, every module</h3>
          <button type="button" class="mods-x" data-close aria-label="Close">×</button>
        </div>
        <div class="mods-body">
          <div class="mods-groups">
            {groups.map((g) => (
              <div>
                <p class="mono">{g.h}</p>
                <ul class="chips">{g.m.map((m) => <li>{m}</li>)}</ul>
              </div>
            ))}
          </div>
          <p class="mono" style="margin-top:24px">How modules work together</p>
          <ul class="links">
            {links.map(([f, t, h]) => (
              <li><span>{f}</span><i>→</i><span>{t}</span><em>{h}</em></li>
            ))}
          </ul>
        </div>
      </dialog>

      <!-- VIDEO 1 -->
      <section class="section center">
        <h2>Level up your quality of work</h2>
        <div class="frame"><div class="ph ph-video">Video placeholder</div></div>
        <div class="player"><span class="pbtn"></span><span class="bar"></span></div>
      </section>

      <!-- PRODUCTIVITY -->
      <section class="section center">
        <h2>Optimized for productivity</h2>
        <div class="dash" id="dash">
          <aside class="dside" id="d-side">
            <div class="d-brand"><button type="button" class="d-collapse" id="d-collapse" aria-label="Collapse sidebar">⇤</button></div>
            <p class="d-label">Main navigation</p>
            <nav class="d-nav" id="d-nav">
              <button type="button" class="on" data-nav="Overview"><i class="ic"></i><span>Overview</span></button>
              <button type="button" data-nav="Tickets"><i class="ic"></i><span>Tickets</span></button>
              <button type="button" data-nav="Clients"><i class="ic"></i><span>Clients</span></button>
              <button type="button" data-nav="Agents &amp; Teams"><i class="ic"></i><span>Agents &amp; Teams</span></button>
              <button type="button" data-nav="Knowledge Base"><i class="ic"></i><span>Knowledge Base</span></button>
              <button type="button" data-nav="Integrations"><i class="ic"></i><span>Integrations</span></button>
            </nav>
            <p class="d-label">Analytics &amp; insights</p>
            <nav class="d-nav" data-group>
              <button type="button" data-nav="SLA Compliance"><i class="ic"></i><span>SLA Compliance</span></button>
              <button type="button" data-nav="CSAT &amp; NPS"><i class="ic"></i><span>CSAT &amp; NPS</span></button>
              <button type="button" data-nav="Workload Analytics"><i class="ic"></i><span>Workload Analytics</span></button>
              <button type="button" data-nav="Reports"><i class="ic"></i><span>Reports</span></button>
            </nav>
            <div class="d-user"><span class="av a1">AM</span><div><strong>Alex Morgan</strong><small>alex@fusionedge.com</small></div></div>
          </aside>
          <div class="dmain-wrap">
            <div class="d-top">
              <p class="crumb"><span>Overview</span> / <b id="d-crumb">Dashboard</b></p>
            </div>
            <div class="d-head">
              <div><h3>Hello, Alex Morgan 👋</h3><p>Here are the latest insights from your customer interactions.</p></div>
              <select id="d-range" aria-label="Date range"><option value="week">Last week</option><option value="month">Last month</option></select>
            </div>
            <div class="dmain">
              <div class="g-kpis" id="d-kpis"></div>
              <section class="dbox g-chart">
                <header><span>Ticket Volume Trend</span></header>
                <div class="chart-top"><strong id="d-total">0</strong><small id="d-tdelta"></small></div>
                <div class="plot"><div class="yax" id="d-yax"></div><div class="bars" id="d-bars"></div><div class="guide" id="d-guide"></div><div class="tip" id="d-tip"></div></div>
                <div class="xax" id="d-xax"></div>
              </section>
              <section class="dbox g-upd">
                <header><span>Latest Updates</span></header>
                <div class="u-tabs" id="d-utabs"><button type="button" class="on" data-ut="today">Today</button><button type="button" data-ut="yesterday">Yesterday</button><button type="button" data-ut="week">This week</button></div>
                <input id="d-usearch" type="search" placeholder="Search activities" aria-label="Search activities" />
                <p class="u-count" id="d-ucount"></p>
                <ul class="u-list" id="d-ulist"></ul>
              </section>
              <section class="dbox g-table">
                <header><span>SLA Monitoring</span>
                  <div class="t-tools"><input id="d-tsearch" type="search" placeholder="Search ticket" aria-label="Search ticket" /><select id="d-tfilter" aria-label="Filter priority"><option value="">All priorities</option><option>High</option><option>Medium</option><option>Low</option></select></div>
                </header>
                <div class="t-scroll"><table class="tbl"><thead id="d-thead"></thead><tbody id="d-tbody"></tbody></table></div>
              </section>
            </div>
          </div>
        </div>
      </section>

      <!-- ENTERPRISE -->
      <section class="section enterprise">
        <h2>Enterprise software done right</h2>
        <div class="ent-grid">
          {[cards.left, cards.right].map((col) => (
            <div class="ent-col">
              {col.map((c) => (
                <article class="card">
                  <h3>{c.t}</h3>
                  {c.d && <p>{c.d}</p>}
                  {c.extra && <ul class="bul">{c.extra.map((e) => <li>{e}</li>)}</ul>}
                  {c.q && <p class="q">{c.q}</p>}
                  {c.ph && <div class="ph ph-card">{c.ph}</div>}
                  {c.btn && <a class="btn btn-primary" href="#">{c.btn}</a>}
                </article>
              ))}
            </div>
          ))}
        </div>
      </section>

      <!-- USERS -->
      <section class="users">
        <div class="mosaic">{faces.map((f, i) => <span class={`m ${f}`} style={`--i:${i}`}></span>)}</div>
        <div class="users-card">
          <h2>Join 28 million users</h2>
          <p>who grow their business with Fusionedge</p>
        </div>
      </section>

      <!-- TESTIMONIAL -->
      <section class="testimonial">
        <div class="t-text">
          <span class="qm">“</span>
          <p>The processing time for our documents has been noticeably reduced, in certain cases from 2 days to only 5 hours. As a result we can now focus on what matters.</p>
        </div>
        <div class="t-person">
          <div class="ph ph-avatar">Photo</div>
          <strong>Name Surname</strong>
          <span>CEO, Company</span>
          <div class="ph ph-logo">Logo</div>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta">
        <h2>Unleash your <span class="accent">growth potential</span></h2>
        <a class="btn btn-primary btn-lg" href="#">Start now - It's free</a>
        <p class="tiny">No credit card required<br />Instant access</p>
      </section>

      <!-- FOOTER -->
      <footer class="footer">
        <div class="foot-top">
          <div class="letter">
            <a class="logo" href="/"><img src="/logo.png" alt="Fusionedge" width="400" height="127" loading="eager" /></a>
            <h4>The Fusionedge letter</h4>
            <p class="muted">Product updates and ideas from teams running their business on one platform. Once a month.</p>
            <form class="subf" onsubmit="return false">
              <input type="email" placeholder="you@company.com" aria-label="Email address" />
              <button type="button">Subscribe</button>
            </form>
          </div>
          <div class="cols">
            {footerCols.map((c) => (
              <div><p class="mono">{c.h}</p><ul>{c.l.map((l) => <li><a href="#">{l}</a></li>)}</ul></div>
            ))}
          </div>
        </div>
        <div class="foot-bottom">
          <span>© 2026 Fusionedge. All rights reserved.</span>
          <span class="socials"><i class="sq"></i><i class="sq"></i><i class="sq"></i><i class="sq"></i></span>
        </div>
      </footer>
    </div>
    <script is:inline>
      (function () {
        var root = document.getElementById("dash");
        if (!root) return;
        function $(id) { return document.getElementById(id); }
        function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
        var range = "week", active = 2, utab = "today", uq = "", tq = "", tf = "", sortKey = "id", sortDir = 1, selected = {};
        var data = {
          week: {
            kpis: [
              { t: "Current Tickets", v: "3,484", d: 7.1, good: true, s: [8, 10, 7, 12, 18, 11, 16, 9, 14, 17, 12, 15] },
              { t: "Daily Avg. Resolution", v: "486", u: " min", d: 2, good: true, s: [10, 9, 12, 11, 14, 10, 13, 17, 12, 15, 11, 14] },
              { t: "SLA Compliance Rate", v: "92%", d: -1.3, good: false, s: [12, 17, 9, 15, 11, 18, 10, 14, 8, 13, 9, 11] }
            ],
            total: "4,790", td: 8, labels: ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"], vals: [290, 570, 584, 440, 730, 640, 420]
          },
          month: {
            kpis: [
              { t: "Current Tickets", v: "14,210", d: 5.4, good: true, s: [6, 8, 9, 12, 11, 14, 13, 16, 15, 18, 17, 19] },
              { t: "Daily Avg. Resolution", v: "472", u: " min", d: -3.1, good: true, s: [16, 15, 14, 15, 12, 13, 11, 12, 10, 11, 9, 10] },
              { t: "SLA Compliance Rate", v: "94%", d: 1.1, good: true, s: [9, 10, 12, 11, 13, 12, 14, 15, 14, 16, 15, 17] }
            ],
            total: "18,940", td: 11, labels: ["D4", "D8", "D12", "D16", "D20", "D24", "D28", "D30"], vals: [1450, 1820, 2210, 1960, 2480, 2290, 2640, 2100]
          }
        };
        var updates = {
          today: [
            ["#5D1F71", "Ticket Updated", "11:20 AM", "Ticket #2319 SLA updated"],
            ["#00BE87", "New Client Added", "11:15 AM", "PT. Alpha Indonesia registered"],
            ["#8a4fe0", "Agent Reassigned", "11:00 AM", "Ticket #2322 moved to Michael Wong"],
            ["#e0384a", "SLA Breach Risk", "10:45 AM", "Ticket #2320 “Login issue”"],
            ["#12a5b4", "Knowledge Base", "10:30 AM", "New article published: “Login Troubleshooting”"],
            ["#f0a020", "Customer Feedback", "10:30 AM", "“Great support response, thanks Sarah!”"]
          ],
          yesterday: [
            ["#3a6fd8", "Ticket Updated", "5:40 PM", "Ticket #2311 status set to Delivered"],
            ["#e0384a", "SLA Breach Risk", "3:10 PM", "Ticket #2308 “Invoice mismatch”"],
            ["#0a9a6a", "New Client Added", "1:25 PM", "Northwind Traders registered"],
            ["#f0a020", "Customer Feedback", "10:05 AM", "“Quick fix, very helpful.”"]
          ],
          week: []
        };
        updates.week = updates.today.concat(updates.yesterday, [
          ["#8a4fe0", "Agent Reassigned", "Mon", "Ticket #2301 moved to Sarah Lee"],
          ["#12a5b4", "Knowledge Base", "Mon", "Article updated: “Exporting reports”"]
        ]);
        var tickets = [
          { id: 2319, s: "Payment failed on invoice", p: "High", a: "John Doe", c: "a1", st: "Review", cr: "2026-10-18", dl: "2h left", dh: 2 },
          { id: 2320, s: "Login issue", p: "Medium", a: "Sarah Lee", c: "a2", st: "Delivered", cr: "2026-10-19", dl: "1h left", dh: 1 },
          { id: 2321, s: "Feature request export", p: "Low", a: "John Doe", c: "a1", st: "Progress", cr: "2026-10-19", dl: "1d left", dh: 24 },
          { id: 2322, s: "Contract renewal issue", p: "Medium", a: "Michael Wong", c: "a3", st: "Progress", cr: "2026-10-20", dl: "9h left", dh: 9 },
          { id: 2323, s: "Dashboard not loading", p: "High", a: "Sarah Lee", c: "a2", st: "Progress", cr: "2026-10-20", dl: "4h left", dh: 4 },
          { id: 2324, s: "Update billing address", p: "Low", a: "Michael Wong", c: "a3", st: "Review", cr: "2026-10-21", dl: "2d left", dh: 48 },
          { id: 2325, s: "API rate limit question", p: "Medium", a: "Priya Nair", c: "a4", st: "Progress", cr: "2026-10-21", dl: "6h left", dh: 6 }
        ];
        var stLabel = { Review: "In Review", Delivered: "Delivered", Progress: "In Progress" }, prank = { High: 3, Medium: 2, Low: 1 };

        function spark(s, col) {
          var w = 100, h = 36, mx = Math.max.apply(null, s), mn = Math.min.apply(null, s), pts = s.map(function (v, i) { return [(i / (s.length - 1)) * w, h - 3 - ((v - mn) / (mx - mn || 1)) * (h - 8)]; });
          var line = pts.map(function (p, i) { return (i ? "L" : "M") + p[0].toFixed(1) + " " + p[1].toFixed(1); }).join(" ");
          return '<svg class="spark" viewBox="0 0 100 36" preserveAspectRatio="none"><path d="' + line + ' L100 36 L0 36 Z" fill="' + col + '" opacity=".12"/><path d="' + line + '" fill="none" stroke="' + col + '" stroke-width="1.6" vector-effect="non-scaling-stroke"/></svg>';
        }
        function renderKpis() {
          var h = "";
          data[range].kpis.forEach(function (k) {
            var col = k.good ? "#00BE87" : "#e0384a", sign = k.d >= 0 ? "+" : "";
            h += '<div class="kpi"><span>' + k.t + '</span><div class="kpi-in"><div><strong>' + k.v + (k.u ? '<small>' + k.u + "</small>" : "") + '</strong><small><b class="' + (k.good ? "up" : "down") + '">' + sign + k.d + "%</b> vs last " + range + "</small></div>" + spark(k.s, col) + "</div></div>";
          });
          $("d-kpis").innerHTML = h;
        }
        var axMax = 800;
        function renderChart() {
          var d = data[range], mx = Math.max.apply(null, d.vals), step = mx > 1000 ? 1000 : 200;
          axMax = Math.ceil(mx / step) * step;
          $("d-total").textContent = d.total; $("d-tdelta").innerHTML = '<b class="up">+' + d.td + "%</b> vs last " + range;
          var y = ""; for (var i = 4; i >= 0; i--) y += "<span>" + Math.round((axMax / 4) * i) + "</span>";
          $("d-yax").innerHTML = y;
          $("d-bars").innerHTML = d.vals.map(function (v, i) { return '<div class="bar' + (i === active ? " on" : "") + '" data-i="' + i + '" style="height:' + Math.round((v / axMax) * 100) + '%"></div>'; }).join("");
          $("d-xax").innerHTML = d.labels.map(function (l) { return "<span>" + l + "</span>"; }).join("");
          placeTip();
        }
        function placeTip() {
          var d = data[range], bars = $("d-bars"), el = bars.children[active];
