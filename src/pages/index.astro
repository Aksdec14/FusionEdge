CK=p('M33.5 36l2.5 2.5 4.5-5','N sG'),
PR=function(x,y,s){return '<g transform="translate('+x+' '+y+') scale('+s+')">'+c(0,0,4.2,'D o')+p('M-9 14c0-6 4-9 9-9s9 3 9 9z','D o')+'</g>'},
GEAR=function(x,y,q){var t=2*Math.PI*q/8;return c(x,y,q,'N sD" style="stroke-width:'+q*.55+';stroke-dasharray:'+(t*.55).toFixed(1)+' '+(t*.45).toFixed(1))+c(x,y,q*.85,'D')+c(x,y,q*.35,'W')},
DN=function(x,y){return c(x,y,5,'N sM" style="stroke-width:4')+c(x,y,5,'N sD" style="stroke-width:4;stroke-dasharray:11 20.4" transform="rotate(-90 '+x+' '+y+')')},
