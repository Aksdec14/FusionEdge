}
let LAYERS=[];
function drawLayer(L,item,animate,line){
  const pick=L===pickL();
  L.p.getAnimations().forEach(a=>a.cancel());
  L.p.classList.remove('dim');
  if(pick&&L.l.classList.contains('on')){L.l.style.transition='none';L.l.classList.remove('on','dim');void L.l.offsetWidth;}
  else L.l.classList.remove('on','dim');
  if(!item){L.p.setAttribute('d','');L.l.innerHTML='';return;}
  const cs=[...board.querySelectorAll('.tile')].filter(t=>item.mods.includes(t.dataset.name)).map(t=>t._c);
  const showLine=line!==false;
  if(showLine){
    L.p.setAttribute('d',outlinePath(cs,geo.R));
    L.p.setAttribute('stroke',item.color==='p'?'#5D1F72':'#00BF88');
    if(reduced||!animate)L.p.style.strokeDashoffset=0;
    else{L.p.style.strokeDashoffset=1;L.p.animate([{strokeDashoffset:1},{strokeDashoffset:0}],{duration:2000,easing:'ease-in-out',fill:'forwards'});}
  }else L.p.setAttribute('d','');
  const below=item.pos?item.pos==='bottom':item.color==='g';
  let x;
  if(item.slot)x=geo.W*{left:0.159,center:0.5,right:0.841}[item.slot];
  else{const xs=cs.map(c=>c.x);x=(Math.min(...xs)+Math.max(...xs))/2;x=Math.max(210,Math.min(geo.W-84,x));}
  L.l.className='label '+item.color;L.l.innerHTML=`<b>${item.name}</b><small>${item.full}</small>`;
  L.l.style.left=x+'px';
  L.l.style.top=(below?geo.labelBottom:geo.labelTop)+'px';
  L.l.style.transition='none';
  if(!(animate&&!reduced)){L.l.classList.add('on');requestAnimationFrame(()=>L.l.style.transition='');return;}
  void L.l.offsetWidth;L.l.style.transition='opacity .35s ease';L.l.classList.add('on');
}
const suites=()=>LAYERS.slice(0,-1), pickL=()=>LAYERS[LAYERS.length-1];
let state={mode:'idle',step:-1};
function redraw(){
  markHot(state.mode==='pick'?VIEWS[view][current]:state.mode==='intro'?VIEWS.products[state.step]:null);
  if(state.mode==='pick'){
    suites().forEach(L=>drawLayer(L,null));
    drawLayer(pickL(),null);
    if(VIEWS[view]&&VIEWS[view][current]){
      if(view==='roles')showPointers(VIEWS[view][current],compile(VIEWS[view][current],{center:true,detail:false}));
      else compile(VIEWS[view][current]);
    }
    return;
  }
  suites().forEach((L,i)=>{const show=state.mode==='done'||i<=state.step;drawLayer(L,show?VIEWS.products[i]:null,false);
    if(state.mode==='intro'&&i<state.step){L.p.classList.add('dim');L.l.classList.add('dim');}});
}
function showAllSuites(){
  state={mode:'done',step:VIEWS.products.length-1};current=null;
  drawLayer(pickL(),null);
  suites().forEach((L,i)=>drawLayer(L,VIEWS.products[i],false));markHot(null);
  syncUI(null);
}
function spotlight(i){
  current=i;state={mode:'pick',step:-1};
  suites().forEach(L=>drawLayer(L,null));
  drawLayer(pickL(),null);
  markHot(VIEWS[view][i]);
  if(view==='roles')showPointers(VIEWS[view][i],compile(VIEWS[view][i],{center:true,detail:false}));
  else compile(VIEWS[view][i]);
  syncUI(VIEWS[view][i]);
}
const chipsEl=document.getElementById('chips'), tabs=[...document.querySelectorAll('#tabs button')];
function renderChips(){
  chipsEl.innerHTML=VIEWS[view].map((g,i)=>`<button type="button" class="${g.color}" data-i="${i}">${g.name}</button>`).join('');
  chipsEl.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{run++;spotlight(+b.dataset.i);}));
}
const capEl=document.getElementById('cap');
function updateCaption(){
  let html='';
  if(state.mode==='done') html='<div class="legend">'+VIEWS.products.map(p=>`<span class="${p.color}"><i></i>${p.name}</span>`).join('')+'</div>';
  else{const it=state.mode==='intro'?VIEWS.products[state.step]:state.mode==='pick'?VIEWS[view][current]:null;
    if(it){const lines=HELP[it.name]||[];html=`<div class="one ${it.color}"><b>${it.name}</b><small>${it.full}</small>${lines.length?`<ul>${lines.map(l=>`<li>${l}</li>`).join('')}</ul>`:''}</div>`;}}
  if(capEl.innerHTML!==html)capEl.innerHTML=html;
}
function syncUI(item){
  updateCaption();
  const all=state.mode==='done';
  chipsEl.querySelectorAll('button').forEach(b=>b.classList.toggle('on',all||(+b.dataset.i===current&&item!=null)||(state.mode==='intro'&&+b.dataset.i<=state.step)));
}
const wait=ms=>new Promise(r=>setTimeout(r,ms));
let run=0;
async function runView(v,me,delay){
  view=v;current=null;
  tabs.forEach(t=>t.setAttribute('aria-selected',t.dataset.view===v));
  renderChips();
  releaseTiles(true);
  LAYERS.forEach(L=>drawLayer(L,null));
  state={mode:'idle',step:-1};markHot(null);syncUI(null);
  if(v==='products'){
    if(reduced){showAllSuites(false);return me===run;}
    await wait(delay);
    const n=VIEWS.products.length;
    for(let i=0;i<n;i++){
      if(me!==run)return false;
      state={mode:'intro',step:i};
      suites().slice(0,i).forEach(L=>{L.p.classList.add('dim');L.l.classList.add('dim');});
      drawLayer(suites()[i],VIEWS.products[i],true);markHot(VIEWS.products[i]);syncUI(null);
      await wait(2000);
    }
    if(me!==run)return false;
    await wait(2000);
    if(me!==run)return false;
    state={mode:'done',step:n-1};
    suites().forEach(L=>{L.p.classList.remove('dim');L.l.style.transition='opacity .6s ease';L.l.classList.remove('dim');});
    markHot(null);syncUI(null);
    await wait(2000);
    return me===run;
  }
  if(v==='roles'){
    if(reduced){spotlight(0);return me===run;}
    await wait(delay);
    for(let i=0;i<VIEWS.roles.length;i++){
      if(me!==run)return false;
      const item=VIEWS.roles[i];
      current=i;state={mode:'pick',step:-1};
      suites().forEach(L=>drawLayer(L,null));
      drawLayer(pickL(),null);
      clearPointers();
      markHot(item);
      const box=compile(item,{center:true,detail:false});
      syncUI(item);
      await wait(780);
      if(me!==run)return false;
      showPointers(item,box);
      await wait(2200);
    }
    return me===run;
  }
  if(reduced){spotlight(0);return me===run;}
  await wait(delay);
  for(let i=0;i<VIEWS[v].length;i++){
    if(me!==run)return false;
    current=i;state={mode:'pick',step:-1};
    suites().forEach(L=>drawLayer(L,null));
    drawLayer(pickL(),null);
    markHot(VIEWS[v][i]);compile(VIEWS[v][i]);syncUI(VIEWS[v][i]);
    await wait(2200);
