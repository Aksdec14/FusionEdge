<script is:inline>
(function(){
  var fan = document.querySelector(".uc-fan");
  if (!fan || fan.dataset.ucReady) return;
  fan.dataset.ucReady = "1";
  var originals = Array.prototype.slice.call(fan.querySelectorAll(".uc-card"));
  var n = originals.length;
  var mq = window.matchMedia("(max-width: 760px)");
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  var holdMs = 2000;
  var slideMs = 700;
  var phase = "hold";
  var fromOff = 0;
  var toOff = 0;
  var holdAt = 0;
  var slideAt = 0;
  var i = 0;
  var timer = 0;
  var drag = null;
  var moved = false;
  var offset = 0;
  var raf = 0;
  var lastT = 0;
  var arcDrag = null;
  var hovering = false;
  var seen = true;
  var clones = [];

  function place(index, px){
    var next = (index % n + n) % n;
    var wrap = !px && ((next === 0 && i === n - 1) || (next === n - 1 && i === 0));
    i = next;
    if (wrap) fan.classList.add("is-jump");
    fan.style.setProperty("--uc", i);
    fan.style.setProperty("--drag", (px || 0) + "px");
    if (wrap) { fan.offsetWidth; fan.classList.remove("is-jump"); }
  }
  function stop(){ clearInterval(timer); timer = 0; }
  function start(){
    stop();
    if (!mq.matches || reduce.matches || document.hidden) return;
    timer = setInterval(function(){ place(i + 1, 0); }, 3000);
  }
  function clearClones(){
    clones.forEach(function(el){ el.remove(); });
    clones = [];
  }
  function clearArcInline(){
    originals.forEach(function(card){
      card.style.transform = "";
      card.style.zIndex = "";
      card.style.opacity = "";
      card.style.pointerEvents = "";
    });
    fan.style.height = "";
  }
  function pose(slot){
    var a = Math.abs(slot);
    var scale, x;
    if (a <= 1) {
      scale = 1 + (0.94 - 1) * a;
      x = 300 * a;
    } else if (a <= 2) {
      var t = a - 1;
      scale = 0.94 + (0.88 - 0.94) * t;
      x = 300 + 250 * t;
    } else {
      var t = Math.min(a - 2, 1.2);
      scale = Math.max(0.84, 0.88 - 0.04 * t);
      x = 550 + 140 * t;
    }
    var fade = a <= 2.25 ? 1 : Math.max(0, 1 - (a - 2.25) / 0.65);
    return { x: slot < 0 ? -x : x, scale: scale, z: 300 - Math.round(a * 40), fade: fade };
  }
  function layoutCover(){
    for (var c = 0; c < n; c++) {
      var slot = c - offset;
      slot = ((slot % n) + n) % n;
      if (slot > n / 2) slot -= n;
      var p = pose(slot);
      var card = originals[c];
      card.style.transform = "translate3d(calc(-50% + " + p.x.toFixed(2) + "px),0,0) scale(" + p.scale.toFixed(4) + ")";
      card.style.zIndex = String(p.z);
      card.style.opacity = p.fade < 0.02 ? "0" : p.fade.toFixed(3);
      card.style.pointerEvents = p.fade < 0.25 ? "none" : "";
    }
  }
  function ease(p){
    return p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2;
  }
  var pauseAt = 0;
  function frame(now){
    var frozen = arcDrag || hovering || !seen || reduce.matches || document.hidden;
    if (frozen) {
      if (!pauseAt) pauseAt = now;
      layoutCover();
      raf = requestAnimationFrame(frame);
      return;
    }
    if (pauseAt) {
      var drift = now - pauseAt;
      pauseAt = 0;
      if (phase === "slide") slideAt += drift;
      else if (holdAt) {
        var elapsed = now - drift - holdAt;
        if (elapsed >= holdMs) holdAt = now - holdMs;
        else holdAt += drift;
      }
    }
    if (phase === "hold") {
      offset = toOff;
      if (!holdAt) holdAt = now;
      if (now - holdAt >= holdMs) {
        phase = "slide";
        fromOff = toOff;
        toOff = toOff + 1;
        slideAt = now;
      }
    } else {
      var p = Math.min(1, (now - slideAt) / slideMs);
      offset = fromOff + (toOff - fromOff) * ease(p);
      if (p >= 1) {
        toOff = ((toOff % n) + n) % n;
        fromOff = toOff;
        offset = toOff;
        phase = "hold";
        holdAt = now;
      }
    }
    layoutCover();
    raf = requestAnimationFrame(frame);
  }
  function stopArc(){
    if (raf) cancelAnimationFrame(raf);
    raf = 0;
    lastT = 0;
  }
  function startArc(){
    stopArc();
    clearClones();
    toOff = ((Math.round(offset) % n) + n) % n;
    fromOff = toOff;
    offset = toOff;
    phase = "hold";
    holdAt = 0;
    layoutCover();
    if (!reduce.matches) raf = requestAnimationFrame(frame);
  }
  function enable(){
    arcDrag = null;
    drag = null;
    fan.classList.remove("is-drag");
    if (mq.matches) {
      stopArc();
      clearClones();
      clearArcInline();
      place(i, 0);
      start();
    } else {
      stop();
      fan.style.removeProperty("--uc");
      fan.style.removeProperty("--drag");
      startArc();
    }
  }

  function capture(id){
    try { fan.setPointerCapture(id); } catch (err) {}
  }
  fan.addEventListener("pointerdown", function(e){
    if (e.button > 0) return;
    moved = false;
    if (mq.matches) {
      drag = {x: e.clientX, i: i, t: performance.now(), id: e.pointerId};
      stop();
    } else {
      arcDrag = {x: e.clientX, offset: offset, id: e.pointerId};
    }
  });
  fan.addEventListener("pointermove", function(e){
    if (drag) {
      var dx = e.clientX - drag.x;
      if (!moved && Math.abs(dx) > 8) {
        moved = true;
        fan.classList.add("is-drag");
        capture(drag.id);
      }
      if (moved) place(drag.i, dx);
      return;
    }
    if (!arcDrag) return;
    var adx = e.clientX - arcDrag.x;
    if (!moved && Math.abs(adx) > 8) {
      moved = true;
      fan.classList.add("is-drag");
      capture(arcDrag.id);
    }
    if (!moved) return;
    offset = arcDrag.offset - adx / 300;
    layoutCover();
  });
  function endDrag(e){
    if (drag) {
      var dx = e.clientX - drag.x;
      var w = fan.clientWidth || 1;
      var quick = performance.now() - drag.t < 320;
      var next = drag.i;
      if (dx < -w * 0.18 || (quick && dx < -28)) next += 1;
      else if (dx > w * 0.18 || (quick && dx > 28)) next -= 1;
      drag = null;
      fan.classList.remove("is-drag");
      place(next, 0);
      start();
      return;
    }
    if (!arcDrag) return;
    arcDrag = null;
    fan.classList.remove("is-drag");
    toOff = ((Math.round(offset) % n) + n) % n;
    fromOff = toOff;
    offset = toOff;
    phase = "hold";
    holdAt = 0;
    layoutCover();
  }
  fan.addEventListener("pointerup", endDrag);
  fan.addEventListener("pointercancel", function(){
    if (mq.matches) {
      drag = null;
      fan.classList.remove("is-drag");
      place(i, 0);
      start();
      return;
    }
    arcDrag = null;
    fan.classList.remove("is-drag");
    toOff = ((Math.round(offset) % n) + n) % n;
    fromOff = toOff;
    offset = toOff;
    phase = "hold";
    holdAt = 0;
    layoutCover();
  });
  fan.addEventListener("click", function(e){
    if (!moved) return;
    e.preventDefault();
    moved = false;
  }, true);
  var pointerOver = false;
  var pointerFocus = false;
  function syncHover(){
    hovering = pointerOver || pointerFocus;
    if (hovering) stop();
    else if (mq.matches) start();
  }
  fan.addEventListener("mouseenter", function(){ pointerOver = true; syncHover(); });
  fan.addEventListener("mouseleave", function(){ pointerOver = false; syncHover(); });
  fan.addEventListener("focusin", function(){ pointerFocus = true; syncHover(); });
  fan.addEventListener("focusout", function(e){
    if (fan.contains(e.relatedTarget)) return;
    pointerFocus = false;
    syncHover();
  });
  mq.addEventListener("change", enable);
  window.addEventListener("resize", function(){
    if (mq.matches) return;
    layoutCover();
  });
  document.addEventListener("visibilitychange", function(){
    if (document.hidden) stop();
    else if (mq.matches) start();
    holdAt = 0;
    lastT = 0;
  });
  if (!reduce.matches && "IntersectionObserver" in window) {
    seen = false;
    var watch = new IntersectionObserver(function(entries){
      seen = entries[0].isIntersecting;
      lastT = 0;
    }, {threshold: 0.15});
    watch.observe(fan);
  }
  enable();
})();
</script>
