<li><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 160" aria-hidden="true"><defs><clipPath id="waf-bricks"><path d="M80 14l52 18v38c0 34-22 60-52 74z"/></clipPath></defs><path d="M80 14L28 32v38c0 34 22 60 52 74" fill="none" stroke="#5D1F72" stroke-width="9" stroke-linejoin="round"/><path d="M80 14l52 18v38c0 34-22 60-52 74z" fill="#F3EAF6"/><g clip-path="url(#waf-bricks)"><rect x="84" y="36" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="112" y="36" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="140" y="36" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="70" y="55" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="98" y="55" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="126" y="55" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="84" y="74" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="112" y="74" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="140" y="74" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="70" y="93" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="98" y="93" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="126" y="93" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="84" y="112" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="112" y="112" width="24" height="15" rx="2.5" fill="#5D1F72"/><rect x="140" y="112" width="24" height="15" rx="2.5" fill="#5D1F72"/></g><path d="M14 64h132v34H14z" fill="#00BF88"/><path d="M14 98l12 10V98zM146 98l-12 10V98z" fill="#008a62"/><text x="80" y="90" font-family="Public Sans,Arial,sans-serif" font-weight="700" font-size="25" fill="#fff" text-anchor="middle" letter-spacing="1">WAF</text></svg><p>Web App Firewall (WAF)</p></li>
<li><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 160" aria-hidden="true"><rect x="10" y="22" width="104" height="72" rx="9" fill="#5D1F72"/><rect x="18" y="30" width="88" height="56" rx="4" fill="#F3EAF6"/><path d="M50 112h24l-3-18H53z" fill="#5D1F72"/><rect x="38" y="110" width="48" height="8" rx="4" fill="#5D1F72"/><path d="M34 58l12 12 22-22" fill="none" stroke="#00BF88" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/><rect x="94" y="46" width="56" height="102" rx="11" fill="#5D1F72"/><rect x="100" y="56" width="44" height="78" rx="4" fill="#F3EAF6"/><rect x="114" y="139" width="16" height="4" rx="2" fill="#F3EAF6"/><path d="M112 98l7 7 13-13" fill="none" stroke="#00BF88" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/><g transform="translate(92 82)"><path d="M-10 -2v-9a10 10 0 0 1 20 0" fill="none" stroke="#1b1325" stroke-width="5" stroke-linecap="round"/><rect x="-17" y="-3" width="34" height="27" rx="6" fill="#E5A100" stroke="#fff" stroke-width="3"/><circle cx="0" cy="7" r="3.8" fill="#1b1325"/><rect x="-1.8" y="8" width="3.6" height="8" rx="1.8" fill="#1b1325"/></g></svg><p>Two-factor Authentication</p></li>
<li><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 160" aria-hidden="true"><rect x="10" y="20" width="140" height="96" rx="10" fill="#5D1F72"/><rect x="18" y="28" width="124" height="80" rx="4" fill="#F3EAF6"/><rect x="64" y="116" width="32" height="18" fill="#5D1F72"/><rect x="44" y="132" width="72" height="9" rx="4.5" fill="#5D1F72"/><path d="M80 34l30 10v20c0 19-12.5 32-30 40-17.5-8-30-21-30-40V44l30-10z" fill="#5D1F72"/><path d="M80 34v70c17.5-8 30-21 30-40V44z" fill="#43134F" opacity=".45"/><g transform="translate(80 66) scale(1.05)"><path d="M-9 0v-7a9 9 0 0 1 18 0v7" fill="none" stroke="#00BF88" stroke-width="4.5" stroke-linecap="round"/><rect x="-14" y="-1" width="28" height="22" rx="5" fill="#00BF88"/><circle cx="0" cy="8" r="3.4" fill="#5D1F72"/><rect x="-1.6" y="9" width="3.2" height="7" rx="1.6" fill="#5D1F72"/></g><circle cx="31" cy="50" r="7" fill="#5D1F72"/><path d="M19 74c0-8 5.5-13 12-13s12 5 12 13z" fill="#5D1F72"/><circle cx="129" cy="50" r="7" fill="#5D1F72" opacity=".55"/><path d="M117 74c0-8 5.5-13 12-13s12 5 12 13z" fill="#5D1F72" opacity=".55"/><circle cx="40" cy="80" r="8" fill="#00BF88" stroke="#fff" stroke-width="2.2"/><path d="M36.6 80.0l2.4 2.4 4.5-4.6" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg><p>Access Control Management</p></li>
<li><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 160" aria-hidden="true"><rect x="34" y="22" width="92" height="124" rx="10" fill="#5D1F72"/><rect x="42" y="34" width="76" height="104" rx="4" fill="#fff"/><rect x="62" y="14" width="36" height="16" rx="6" fill="#43134F"/><circle cx="80" cy="20" r="3" fill="#fff"/><rect x="48" y="48" width="26" height="6" rx="3" fill="#5D1F72"/><rect x="82" y="48" width="30" height="6" rx="3" fill="#5D1F72"/><rect x="48" y="64" width="26" height="6" rx="3" fill="#5D1F72"/><rect x="82" y="64" width="30" height="6" rx="3" fill="#5D1F72"/><rect x="48" y="80" width="26" height="6" rx="3" fill="#5D1F72"/><rect x="82" y="80" width="30" height="6" rx="3" fill="#5D1F72"/><rect x="48" y="96" width="26" height="6" rx="3" fill="#5D1F72"/><rect x="82" y="96" width="30" height="6" rx="3" fill="#5D1F72"/><rect x="48" y="112" width="26" height="6" rx="3" fill="#5D1F72"/><rect x="82" y="112" width="30" height="6" rx="3" fill="#5D1F72"/><path d="M4 34h40a6 6 0 0 1 6 6v20a6 6 0 0 1-6 6H22l-8 9v-9H4z" fill="#1b1325"/><circle cx="27" cy="50" r="9" fill="#E5A100"/><rect x="25.4" y="44" width="3.2" height="8" rx="1.6" fill="#1b1325"/><circle cx="27" cy="55.5" r="1.8" fill="#1b1325"/><path d="M156 84h-40a6 6 0 0 0-6 6v20a6 6 0 0 0 6 6h22l8 9v-9h10z" fill="#1b1325"/><g transform="translate(133 100)"><path d="M-6 -1v-5a6 6 0 0 1 12 0v5" fill="none" stroke="#00BF88" stroke-width="3" stroke-linecap="round"/><rect x="-9" y="-2" width="18" height="13" rx="3" fill="#00BF88"/><path d="M-2.5 2.5l5 5M2.5 2.5l-5 5" stroke="#1b1325" stroke-width="2.2" stroke-linecap="round"/></g></svg><p>Logging &amp; Monitoring</p></li>
