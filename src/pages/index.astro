          var dn = t.closest("[data-done]");
          if (dn) { var id = +dn.closest("tr").getAttribute("data-id"); tickets.forEach(function (x) { if (x.id === id) x.st = "Delivered"; }); renderTable(); return; }
          if (t.id === "d-all") {
            var on = t.checked; tickets.forEach(function (x) { if ((!tf || x.p === tf) && (("#" + x.id + " " + x.s).toLowerCase().indexOf(tq) > -1)) selected[x.id] = on; });
            renderTable(); return;
