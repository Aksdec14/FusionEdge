<script is:inline>
(() => {
  const board = document.querySelector('.wall__board');
  if (!board) return;
  const notes = [...board.querySelectorAll('.note')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const center = el => { const r = el.getBoundingClientRect(); return [r.left + r.width / 2, r.top + r.height / 2, r.width]; };
  const open = n => {
    if (reduce) return;
    const [cx, cy, w] = center(n), reach = w * 1.35, strength = w * .28;
    notes.forEach(o => {
      if (o === n) return;
      const [ox, oy] = center(o); let dx = ox - cx, dy = oy - cy;
      const d = Math.hypot(dx, dy) || 1;
      const k = Math.max(0, 1 - d / reach);
      o.style.setProperty('--px', (dx / d * strength * k).toFixed(1) + 'px');
      o.style.setProperty('--py', (dy / d * strength * k * .45).toFixed(1) + 'px');
    });
  };
  const close = () => notes.forEach(o => { o.style.removeProperty('--px'); o.style.removeProperty('--py'); });
  notes.forEach(n => {
    n.addEventListener('pointerenter', () => open(n));
    n.addEventListener('focus', () => open(n));
    n.addEventListener('blur', close);
  });
  board.addEventListener('pointerleave', close);
})();
</script>
