["Tenants",r(6,8,22,32,2,'W sD')+r(6,8,22,6,2,'D')+r(10,18,5,4,1,'M')+r(19,18,5,4,1,'M')+r(10,25,5,4,1,'M')+r(19,25,5,4,1,'M')+r(14,33,6,7,1,'D')+r(28,20,10,20,2,'L sD')+B(c(35,34.5,2.2,'N sG')+p('M36.5 36l4 4M39 38l1.5-1.5','N sG'))],
["Cafeteria Management",c(23,24,11.500,'W sD')+c(23,24,7,'L')+c(23,24,2.4,'D')+p('M5 8v7a3 3 0 006 0V8M8 17v21','N sD')+p('M40 8c-3 2.500-4 7-4 12h4v18','N sD')]
];
const GROUPS=[
{k:"CAFM",full:"Computer-Aided Facility Management",m:["Smart Ticketing","Preventive Maintenance","Digital Checklist","Inspect","Incident Reporting","Asset Reading & Logs","Compliance","SLA"]},
{k:"IWFM",full:"Integrated Workplace & Facility Management",m:["Desk Booking","Visitor Management","Mailroom","Attendance Management","Pantry Management","Shops","Feedback & Survey Module","CXO Dashboard","Tenants","Cafeteria Management"]},
{k:"EAM",full:"Enterprise Asset Management",m:["Digital Asset Register","Asset Audit","Asset AMC Tracker","Asset Health Monitoring"]},
{k:"CAMS",full:"Computerized Asset Maintenance System",m:["Dashboard","Purchase Orders","Inventory Management","Vendor"]}];
const byName={};M.forEach(x=>byName[x[0]]=x);
const host=document.getElementById("grid");
host.innerHTML='<div class="cat"><div class="hexwrap"><svg class="lines" aria-hidden="true"></svg></div></div>';
const cat=host.firstChild,wrap=cat.firstChild,svg=wrap.firstChild;
const cells=[];GROUPS.forEach((g,gi)=>g.m.forEach(n=>cells.push({n,g:gi})));
const hexes=cells.map(m=>{const d=document.createElement("div");d.className="hex";d.title=m.n;d.innerHTML='<svg class="mod p" viewBox="2 2.5 45 44" aria-hidden="true">'+byName[m.n][1]+'</svg><span>'+m.n+'</span>';wrap.appendChild(d);return d});
const N=hexes.length,rows=2,cols=Math.ceil(N/2);
let act=-1,timer,order=cells.map((_,i)=>i),kept=[];
function clearKept(){kept=[];act=-1;svg.querySelectorAll(".gseg").forEach(el=>el.classList.remove("on","drawn"));wrap.querySelectorAll(".lbl").forEach(el=>el.classList.remove("on"))}
function reveal(gi){act=gi;cat.classList.add("focus");hexes.forEach((x,i)=>x.classList.toggle("act",cells[i].g===gi));
const el=svg.querySelector('.gseg[data-g="'+gi+'"]');if(el){el.classList.remove("on","drawn");void el.getBoundingClientRect();el.classList.add("on","drawn")}
const lbl=wrap.querySelector('.lbl[data-g="'+gi+'"]');if(lbl)lbl.classList.add("on");if(kept.indexOf(gi)<0)kept.push(gi)}
function restore(){kept.forEach(gi=>{const el=svg.querySelector('.gseg[data-g="'+gi+'"]');if(el)el.classList.add("on","drawn");const lbl=wrap.querySelector('.lbl[data-g="'+gi+'"]');if(lbl)lbl.classList.add("on")})}

/* ---------- Stacked honeycomb (phones + tablets) ----------
   One continuous honeycomb of 4 columns holding 7,6,7,6 hexagons (26 in total).
   Columns 0 and 2 start at the top, columns 1 and 3 are indented by half a hexagon,
   so the top AND the bottom edge are a clean zig-zag.
   Each group is a connected cluster of cells: [column,row]. */
const LAY=[
[[0,0],[1,0],[0,1],[1,1],[0,2],[1,2],[0,3],[1,3]],                                 /* CAFM (8)  */
[[2,0],[3,0],[2,1],[3,1],[2,2],[3,2],[2,3],[3,3],[2,4],[3,4]],                     /* IWFM (10) */
[[0,4],[1,4],[0,5],[0,6]],                                                         /* EAM  (4)  */
[[2,5],[1,5],[3,5],[2,6]]                                                          /* CAMS (4)  */
];
const LC=[.875,2.375,.875,2.375]; /* label centre, in hexagon widths */
function placeMobile(drawLines,stagger){
const avail=host.clientWidth,band=66,bot=56;
const w=Math.max(64,Math.min(avail/3.25,190)),h=w*.866,lw=1.5*w;
const ww=3.25*w,foot=band+7*h,hh=foot+bot+4;
wrap.style.width=ww+"px";wrap.style.height=hh+"px";svg.setAttribute("width",ww);svg.setAttribute("height",hh);
const pos=[],key={};let idx=0;
LAY.forEach((g,gi)=>g.forEach(q=>{const c=q[0],r=q[1];pos[idx]={c,r,gi,x:c*.75*w,y:band+r*h+(c%2?h/2:0)};key[c+","+r]=idx;idx++}));
const nbr=P=>{const c=P.c,r=P.r,o=c%2;return [[c,r-1],[c+1,o?r:r-1],[c+1,o?r+1:r],[c,r+1],[c-1,o?r+1:r],[c-1,o?r:r-1]].map(q=>{const k=key[q[0]+","+q[1]];return k==null?-1:k})};
const cnt={p:0,n:0,w:0},col=[];
for(let slot=0;slot<N;slot++){const i=order[slot],P=pos[i],bad=nbr(P).filter(j=>j>=0&&pos[j].gi===P.gi).map(j=>col[j]),k=["p","n","w"].sort((a,b)=>((bad.filter(z=>z==a).length*100+cnt[a]*(a=="p"?1:2))-(bad.filter(z=>z==b).length*100+cnt[b]*(b=="p"?1:2))))[0];col[i]=k;cnt[k]++;
const el=hexes[i],st=el.style;el.firstChild.setAttribute("class","mod "+k);
st.width=w+"px";st.height=h+"px";st.left=P.x+"px";st.top=P.y+"px";st.fontSize=Math.max(9,w*.056)+"px";st.transitionDelay=(stagger?slot*stagger:0)+"ms";
const v=el.firstChild.style;v.width=v.height=(w*.2+7)+"px"}
if(!drawLines)return;
const outs=["","","",""];
for(let i=0;i<N;i++){const P=pos[i],x0=P.x,y0=P.y,V=[[.25,0],[.75,0],[1,.5],[.75,1],[.25,1],[0,.5]].map(q=>[x0+q[0]*w,y0+q[1]*h]),NB=nbr(P),g=P.gi;
for(let e=0;e<6;e++){const j=NB[e];if(j>=0&&pos[j].gi===g)continue;const A=V[e],B=V[(e+1)%6];outs[g]+='<line class="seg" pathLength="1" x1="'+A[0].toFixed(1)+'" y1="'+A[1].toFixed(1)+'" x2="'+B[0].toFixed(1)+'" y2="'+B[1].toFixed(1)+'"/>'}}
svg.innerHTML=outs.map((s,g)=>'<g class="gseg'+(g%2?' green':'')+'" data-g="'+g+'">'+s+"</g>").join("");
wrap.querySelectorAll(".lbl").forEach(n=>n.remove());
GROUPS.forEach((g,gi)=>{const d=document.createElement("div"),below=gi>1;d.className="lbl"+(gi%2?" green":"");d.style.left=LC[gi]*w+"px";d.style.width=lw+"px";d.dataset.g=gi;d.style.bottom="auto";d.style.height=(below?bot-12:band-12)+"px";d.style.display="flex";d.style.flexDirection="column";d.style.justifyContent=below?"flex-start":"flex-end";d.style.top=(below?foot+12:0)+"px";d.innerHTML='<span class="chip">'+g.k+'</span><small>'+g.full+'</small>';wrap.appendChild(d)});restore()}
function place(drawLines,stagger){
if(matchMedia("(max-width:1100px)").matches){cat.classList.add("stack");placeMobile(drawLines,stagger);return}
cat.classList.remove("stack");
const avail=host.clientWidth,w=Math.max(Math.min(avail/(.75*(cols-1)+1),170),90),h=w*.866,ww=.75*(cols-1)*w+w,hh=rows*h+h/2;
wrap.style.width=ww+"px";wrap.style.height=hh+"px";svg.setAttribute("width",ww);svg.setAttribute("height",hh);
const col=[],cnt={p:0,n:0,w:0};
for(let slot=0;slot<N;slot++){const c=Math.floor(slot/rows),r=slot%rows,nb=[[c,r-1]].concat(c%2?[[c-1,r],[c-1,r+1]]:[[c-1,r-1],[c-1,r]]).filter(q=>q[0]>=0&&q[1]>=0&&q[1]<rows),bad=nb.map(q=>col[q[0]*rows+q[1]]),k=["p","n","w"].sort((a,b)=>((bad.filter(z=>z==a).length*100+cnt[a]*(a=="p"?1:2))-(bad.filter(z=>z==b).length*100+cnt[b]*(b=="p"?1:2))))[0];col[slot]=k;cnt[k]++;
const x=hexes[order[slot]],st=x.style;x.firstChild.setAttribute("class","mod "+k);
st.width=w+"px";st.height=h+"px";st.left=c*.75*w+"px";st.top=r*h+(c%2?h/2:0)+"px";st.fontSize=Math.max(10,w*.07)+"px";st.transitionDelay=(stagger?slot*stagger:0)+"ms";
const v=x.firstChild.style;v.width=v.height=(w*.24+10)+"px"}
if(!drawLines)return;
const at=(c,r)=>{if(c<0||r<0||r>=rows)return -1;const i=c*rows+r;return i<N?i:-1};
const outs=["","","",""];
for(let slot=0;slot<N;slot++){const c=Math.floor(slot/rows),r=slot%rows,x0=c*.75*w,y0=r*h+(c%2?h/2:0),V=[[.25,0],[.75,0],[1,.5],[.75,1],[.25,1],[0,.5]].map(q=>[x0+q[0]*w,y0+q[1]*h]),o=c%2,
NB=[at(c,r-1),at(c+1,o?r:r-1),at(c+1,o?r+1:r),at(c,r+1),at(c-1,o?r+1:r),at(c-1,o?r:r-1)],g=cells[order[slot]].g;
for(let e=0;e<6;e++){const j=NB[e];if(j>=0&&cells[order[j]].g===g)continue;
const A=V[e],B=V[(e+1)%6];outs[g]+='<line class="seg" pathLength="1" x1="'+A[0].toFixed(1)+'" y1="'+A[1].toFixed(1)+'" x2="'+B[0].toFixed(1)+'" y2="'+B[1].toFixed(1)+'"/>'}}
svg.innerHTML=outs.map((s,g)=>'<g class="gseg'+(g%2?' green':'')+'" data-g="'+g+'">'+s+"</g>").join("");
wrap.querySelectorAll(".lbl").forEach(n=>n.remove());
GROUPS.forEach((g,gi)=>{const cs=[];order.forEach((cell,slot)=>{if(cells[cell].g===gi)cs.push(Math.floor(slot/rows))});
const c0=Math.min.apply(null,cs),c1=Math.max.apply(null,cs),x1=c0*.75*w,x2=c1*.75*w+w,d=document.createElement("div");
d.className="lbl"+(gi%2?" green":"");d.style.left=(x1+x2)/2+"px";d.style.width=(x2-x1)+"px";d.dataset.g=gi;
d.innerHTML='<span class="chip">'+g.k+'</span><small>'+g.full+'</small>';wrap.appendChild(d)});restore()}
function cycle(i){if(i===0)clearKept();reveal(i);timer=setTimeout(()=>cycle((i+1)%GROUPS.length),i===GROUPS.length-1?2600:1500)}
place(true,35);
let lastW=innerWidth;
addEventListener("resize",()=>{if(innerWidth===lastW)return;lastW=innerWidth;place(true,0)});
if("IntersectionObserver"in window){const io=new IntersectionObserver(es=>es.forEach(en=>{if(en.isIntersecting){cat.classList.add("in");io.disconnect();if(!matchMedia("(prefers-reduced-motion: reduce)").matches)setTimeout(()=>{hexes.forEach(x=>x.style.transitionDelay="0ms");cycle(0)},1500)}}),{threshold:.2});io.observe(cat)}else{cat.classList.add("in");cycle(0)}
document.querySelectorAll(".origin-btn").forEach(b=>{
b.innerHTML='<span class="fill"></span><span class="z">'+b.innerHTML+'</span>';
const fill=b.firstChild;
const set=(x,y)=>{const w=b.offsetWidth,h=b.offsetHeight,d=Math.ceil(2*Math.max(Math.hypot(x,y),Math.hypot(w-x,y),Math.hypot(x,h-y),Math.hypot(w-x,h-y)));
fill.style.left=x+"px";fill.style.top=y+"px";fill.style.width=fill.style.height=d+"px"};
const ptr=e=>{const r=b.getBoundingClientRect();set(e.clientX-r.left,e.clientY-r.top)};
const ctr=()=>set(b.offsetWidth/2,b.offsetHeight/2);
b.addEventListener("pointerenter",e=>{ptr(e);b.classList.add("on")});
b.addEventListener("pointerleave",()=>b.classList.remove("on","down"));
b.addEventListener("pointerdown",e=>{if(e.button===0){ptr(e);b.classList.add("on","down")}});
b.addEventListener("pointerup",()=>b.classList.remove("down"));
b.addEventListener("pointercancel",()=>b.classList.remove("down"));
b.addEventListener("focus",()=>{if(b.matches(":focus-visible")){ctr();b.classList.add("on")}});
b.addEventListener("blur",()=>b.classList.remove("on","down"));
b.addEventListener("keydown",e=>{if((e.key==" "||e.key=="Enter")&&!e.repeat){ctr();b.classList.add("on","down")}});
b.addEventListener("keyup",e=>{if(e.key==" "||e.key=="Enter"){b.classList.remove("down");if(!b.matches(":focus-visible"))b.classList.remove("on")}});
});
let navY=scrollY;
addEventListener("scroll",()=>{const y=scrollY,nav=document.querySelector("nav.top");if(!nav)return;if(y<=8)nav.classList.remove("hide");else if(y>navY+6)nav.classList.add("hide");else if(y<navY-6)nav.classList.remove("hide");navY=y},{passive:true});

/* ---- Mobile menu ---- */
const navEl=document.querySelector("nav.top"),burger=navEl.querySelector(".burger");
const setMenu=o=>{navEl.classList.toggle("open",o);burger.setAttribute("aria-expanded",o)};
burger.addEventListener("click",()=>setMenu(!navEl.classList.contains("open")));
navEl.querySelectorAll(".links a").forEach(a=>a.addEventListener("click",()=>setMenu(false)));
addEventListener("keydown",e=>{if(e.key==="Escape")setMenu(false)});
addEventListener("resize",()=>{if(innerWidth>900)setMenu(false)});
addEventListener("scroll",()=>{if(navEl.classList.contains("hide"))setMenu(false)},{passive:true});
</script>
