<Layout>
<section class="hero">
<div class="hero-copy">
<h1>Digitize, Optimize and scale</h1>
<p class="tag">One platform. <em>One source of truth.</em></p>
</div>
</section>
<section class="wrap" id="modules" aria-label="Modules by system">
  <div id="chips"></div>
  <div id="cap" aria-live="polite"></div>
  <div id="stage"></div>
  <div id="tabs" role="tablist">
    <button type="button" role="tab" data-view="products" aria-selected="true">Software</button>
    <button type="button" role="tab" data-view="industries" aria-selected="false">Industries</button>
    <button type="button" role="tab" data-view="roles" aria-selected="false">Roles</button>
  </div>
</section>
<section class="customers" aria-labelledby="customers-title">
<h2 id="customers-title">Our Customers</h2>
