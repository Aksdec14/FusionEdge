let gAlt=0;const icMemo={};
function icSet(t){if(t[1]==='p')return'p';if(!(t[0] in icMemo))icMemo[t[0]]=(gAlt++%2)?'g2':'g1';return icMemo[t[0]];}

function hexVerts(c,R){return[0,60,120,180,240,300].map(a=>{const r=a*Math.PI/180;return[c.x+R*Math.cos(r),c.y+R*Math.sin(r)];});}
function outlinePath(centers,R){
  const k=p=>p[0].toFixed(1)+','+p[1].toFixed(1);const edges=new Map();
  centers.forEach(c=>{const v=hexVerts(c,R);for(let i=0;i<6;i++){const a=v[i],b=v[(i+1)%6];
    const key=[k(a),k(b)].sort().join('|');const e=edges.get(key);if(e)e.n++;else edges.set(key,{a,b,n:1});}});
  const outer=[...edges.values()].filter(e=>e.n===1);const adj=new Map();
  outer.forEach((e,i)=>[k(e.a),k(e.b)].forEach(key=>{if(!adj.has(key))adj.set(key,[]);adj.get(key).push(i);}));
  const used=new Set();let d='';
  outer.forEach((e,i)=>{if(used.has(i))return;used.add(i);let cur=e.b;d+=`M${e.a[0]},${e.a[1]}L${cur[0]},${cur[1]}`;
    for(;;){const n=(adj.get(k(cur))||[]).find(j=>!used.has(j));if(n===undefined)break;used.add(n);
      const ne=outer[n];cur=k(ne.a)===k(cur)?ne.b:ne.a;d+=`L${cur[0]},${cur[1]}`;}d+='Z';});
  return d;
}

function build(){
    const m=innerWidth<=760?'mobile':'desktop';
  if(m!==mode){
    mode=m;stage.innerHTML='';
    const R=m==='desktop'?84:76,gap=m==='desktop'?16:10,rS=R,hS=Math.sqrt(3)*rS,pitch=rS+gap/Math.sqrt(3),dx=1.5*pitch,row=Math.sqrt(3)*pitch,LH=46,GAP=10,TOP=m==='desktop'?132:24,BOT=m==='desktop'?150:24;
    modules.classList.toggle('compact',m!=='desktop');
    const MC=[];[7,6,7,6].forEach((n,c)=>{for(let r=0;r<n;r++)MC.push([c,r]);});
    MC.sort((a,b)=>(a[1]+(a[0]%2?.5:0))-(b[1]+(b[0]%2?.5:0))||a[0]-b[0]);
    const pos=(t,i)=>m==='desktop'?[t[3],t[4]]:MC[i];
    const wrap=document.createElement('div');wrap.className='board-wrap';
    board=document.createElement('div');board.className='board';
    let W=0,H=0;
    TILES.forEach((t,i)=>{
      const[c,r]=pos(t,i);const cx=c*dx+rS,cy=TOP+r*row+(c%2?row/2:0)+hS/2;
      W=Math.max(W,cx+rS);H=Math.max(H,cy+hS/2+BOT);
      const el=document.createElement('div');el.className='tile';el.dataset.name=t[0];el._c={x:cx,y:cy};
      el.style.cssText+=`left:${cx-rS}px;top:${cy-hS/2}px;width:${2*rS}px;height:${hS}px`;
      el.innerHTML=`<div class="hex"></div><svg class="ic ${icSet(t)}" viewBox="2 2.5 45 44" aria-hidden="true">${byName[t[0]][1]}</svg><span>${t[0]}</span>`;
      board.appendChild(el);
    });
    board.style.width=W+'px';board.style.height=H+'px';
    const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.setAttribute('class','outline');
    svg.setAttribute('viewBox',`0 0 ${W} ${H}`);svg.setAttribute('width',W);svg.setAttribute('height',H);
    board.appendChild(svg);
    LAYERS=[...VIEWS.products.map((_,i)=>'s'+i),'pick'].map(id=>{
      const p=document.createElementNS('http://www.w3.org/2000/svg','path');p.setAttribute('pathLength','1');svg.appendChild(p);
      const l=document.createElement('div');l.className='label';board.appendChild(l);
      return {id,p,l};});
    geo={R:rS,h:hS,W,labelTop:8,labelBottom:H-BOT+36,lift:LH+6};
    wrap.appendChild(board);stage.appendChild(wrap);
    wrap._fit=()=>{
      const video=document.querySelector('.video-frame');
      const vw=video?video.getBoundingClientRect().width:0;
      const box=stage.clientWidth||1;
      const byWidth=m==='desktop'?(vw>0?vw/W:box/W):Math.min(1,box/W);
      const tabs=document.getElementById('tabs');
      const s=byWidth;
      const px=v=>(v/s).toFixed(2)+'px';
      const hexV=2*rS*s;
      const icoV=hexV*(m==='desktop'?0.36:0.32);
      board.style.zoom='';
      board.style.transform=`scale(${s})`;
      board.style.setProperty('--name',px(hexV*(m==='desktop'?0.1:0.108)));
      board.style.setProperty('--title',px(16));
      board.style.setProperty('--sub',px(14));
      board.style.setProperty('--name-w',px(hexV*(m==='desktop'?0.46:0.5)));
      board.style.setProperty('--ico',px(icoV));
      board.style.setProperty('--ico-h',px(icoV));
      board.style.setProperty('--gap-in',px(hexV*0.012));
      board.style.setProperty('--tile-pad',(hS*0.1).toFixed(2)+'px');
      board.style.setProperty('--tile-side',(rS*0.22).toFixed(2)+'px');
      wrap.style.width=W*s+'px';wrap.style.height=H*s+'px';
      if(tabs){
        if(m==='desktop'){
          tabs.style.width='fit-content';
          tabs.style.marginLeft=((stage.clientWidth-W*s)/2)+'px';
          tabs.style.marginRight='auto';
        }else{
          tabs.style.width='';
          tabs.style.marginLeft='';
          tabs.style.marginRight='';
        }
      }
    };
    if(entered)board.querySelectorAll('.tile').forEach(t=>t.classList.add('in'));
    redraw();
  }
  if(stage.firstChild)stage.firstChild._fit();
}

function markHot(item){
  if(!board)return;
  board.classList.toggle('marking',!!item);
  board.querySelectorAll('.tile').forEach(t=>t.classList.toggle('hot',!!item&&item.mods.includes(t.dataset.name)));
}
let LAYERS=[];
function drawLayer(L,item,animate,line){
  const pick=L===pickL();
  L.p.getAnimations().forEach(a=>a.cancel());
  L.p.classList.remove('dim');
  if(pick&&L.l.classList.contains('on')){L.l.style.transition='none';L.l.classList.remove('on','dim');void L.l.offsetWidth;}
  else L.l.classList.remove('on','dim');
  if(!item){L.p.setAttribute('d','');L.l.innerHTML='';return;}
  const cs=[...board.querySelectorAll('.tile')].filter(t=>item.mods.includes(t.dataset.name)).map(t=>t._c);
  const showLine=line!==false;
  if(showLine){
    L.p.setAttribute('d',outlinePath(cs,geo.R));
    L.p.setAttribute('stroke',item.color==='p'?'#5D1F72':'#00BF88');
    if(reduced||!animate)L.p.style.strokeDashoffset=0;
    else{L.p.style.strokeDashoffset=1;L.p.animate([{strokeDashoffset:1},{strokeDashoffset:0}],{duration:2000,easing:'ease-in-out',fill:'forwards'});}
  }else L.p.setAttribute('d','');
  const below=item.pos?item.pos==='bottom':item.color==='g';
  let x;
  if(item.slot)x=geo.W*{left:0.159,center:0.5,right:0.841}[item.slot];
  else{const xs=cs.map(c=>c.x);x=(Math.min(...xs)+Math.max(...xs))/2;x=Math.max(210,Math.min(geo.W-84,x));}
  L.l.className='label '+item.color;L.l.innerHTML=`<b>${item.name}</b><small>${item.full}</small>`;
  L.l.style.left=x+'px';
  L.l.style.top=(below?geo.labelBottom:geo.labelTop)+'px';
  L.l.style.transition='none';
  if(!(animate&&!reduced)){L.l.classList.add('on');requestAnimationFrame(()=>L.l.style.transition='');return;}
  void L.l.offsetWidth;L.l.style.transition='opacity .35s ease';L.l.classList.add('on');
}
const suites=()=>LAYERS.slice(0,-1), pickL=()=>LAYERS[LAYERS.length-1];
let state={mode:'idle',step:-1};
function redraw(){
  markHot(state.mode==='pick'?VIEWS[view][current]:state.mode==='intro'?VIEWS.products[state.step]:null);
  if(state.mode==='pick'){drawLayer(pickL(),VIEWS[view][current],false);return;}
  suites().forEach((L,i)=>{const show=state.mode==='done'||i<=state.step;drawLayer(L,show?VIEWS.products[i]:null,false);
    if(state.mode==='intro'&&i<state.step){L.p.classList.add('dim');L.l.classList.add('dim');}});
}
function showAllSuites(){
  state={mode:'done',step:VIEWS.products.length-1};current=null;
  drawLayer(pickL(),null);
  suites().forEach((L,i)=>drawLayer(L,VIEWS.products[i],false));markHot(null);
  syncUI(null);
}
function spotlight(i){
  current=i;state={mode:'pick',step:-1};
  suites().forEach(L=>drawLayer(L,null));
  drawLayer(pickL(),VIEWS[view][i],true);markHot(VIEWS[view][i]);
  syncUI(VIEWS[view][i]);
}
const chipsEl=document.getElementById('chips'), tabs=[...document.querySelectorAll('#tabs button')];
function renderChips(){
  chipsEl.innerHTML=VIEWS[view].map((g,i)=>`<button type="button" class="${g.color}" data-i="${i}">${g.name}</button>`).join('');
  chipsEl.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{run++;spotlight(+b.dataset.i);}));
}
const capEl=document.getElementById('cap');
function updateCaption(){
  let html='';
  if(state.mode==='done') html='<div class="legend">'+VIEWS.products.map(p=>`<span class="${p.color}"><i></i>${p.name}</span>`).join('')+'</div>';
  else{const it=state.mode==='intro'?VIEWS.products[state.step]:state.mode==='pick'?VIEWS[view][current]:null;
    if(it)html=`<div class="one ${it.color}"><b>${it.name}</b><small>${it.full}</small></div>`;}
  if(capEl.innerHTML!==html)capEl.innerHTML=html;
}
function syncUI(item){
  updateCaption();
  const all=state.mode==='done';
  chipsEl.querySelectorAll('button').forEach(b=>b.classList.toggle('on',all||(+b.dataset.i===current&&item!=null)||(state.mode==='intro'&&+b.dataset.i<=state.step)));
}
const wait=ms=>new Promise(r=>setTimeout(r,ms));
let run=0;
async function runView(v,me,delay){
  view=v;current=null;
  tabs.forEach(t=>t.setAttribute('aria-selected',t.dataset.view===v));
  renderChips();
  LAYERS.forEach(L=>drawLayer(L,null));
  state={mode:'idle',step:-1};markHot(null);syncUI(null);
  if(v==='products'){
    if(reduced){showAllSuites(false);return me===run;}
    await wait(delay);
    const n=VIEWS.products.length;
    for(let i=0;i<n;i++){
      if(me!==run)return false;
      state={mode:'intro',step:i};
      suites().slice(0,i).forEach(L=>{L.p.classList.add('dim');L.l.classList.add('dim');});
      drawLayer(suites()[i],VIEWS.products[i],true);markHot(VIEWS.products[i]);syncUI(null);
      await wait(2000);
    }
    if(me!==run)return false;
    await wait(2000);
    if(me!==run)return false;
    state={mode:'done',step:n-1};
    suites().forEach(L=>{L.p.classList.remove('dim');L.l.style.transition='opacity .6s ease';L.l.classList.remove('dim');});
    markHot(null);syncUI(null);
    await wait(2000);
    return me===run;
  }
  if(reduced){spotlight(0);return me===run;}
  await wait(delay);
  for(let i=0;i<VIEWS[v].length;i++){
    if(me!==run)return false;
    current=i;state={mode:'pick',step:-1};
    drawLayer(pickL(),VIEWS[v][i],true);markHot(VIEWS[v][i]);syncUI(VIEWS[v][i]);
    await wait(2000);
  }
  return me===run;
}
async function play(v,delay=0){
  const me=++run;
  await runView(v,me,delay);
}
async function tour(delay){
  const me=++run;
  const order=['products','industries','roles'];
  let step=0,gap=delay;
  while(me===run){
    if(!await runView(order[step],me,gap)||me!==run)return;
    gap=400;
    step=(step+1)%order.length;
  }
}
tabs.forEach(t=>t.addEventListener('click',()=>{ if(!entered)enter(true); play(t.dataset.view,200); }));

function enter(noLoop){
  if(entered)return;entered=true;
  const tiles=board.querySelectorAll('.tile');
  if(reduced){tiles.forEach(t=>{t.style.transition='none';t.classList.add('in');});if(!noLoop)play('products');return;}
  tiles.forEach((t,i)=>setTimeout(()=>t.classList.add('in'),i*35));
  if(!noLoop)tour(1300);
}

build();
addEventListener('resize',build);
new IntersectionObserver((ents,obs)=>{if(ents.some(e=>e.isIntersecting)){enter();obs.disconnect();}},{threshold:.2})
  .observe(modules);
(function(){
const row=document.querySelector(".uc-row");
if(!row)return;
const cards=[...row.querySelectorAll(".uc-card")];
const prev=document.querySelector(".uc-prev"),next=document.querySelector(".uc-next");
let page=0,shown=-1;
const per=()=>1;
const reduce=matchMedia("(prefers-reduced-motion: reduce)");
function count(dt){
if(!dt.dataset.n)dt.dataset.n=dt.textContent.trim();
const m=dt.dataset.n.match(/^(.*?)([\d,.]+)(.*)$/);
if(!m||reduce.matches){dt.textContent=dt.dataset.n;return}
if(dt._raf)cancelAnimationFrame(dt._raf);
const raw=m[2].replace(/,/g,""),decimals=(raw.split(".")[1]||"").length,target=parseFloat(raw),commas=m[2].includes(","),start=performance.now();
const text=v=>{const num=decimals?v.toFixed(decimals):(commas?Math.round(v).toLocaleString("en-US"):String(Math.round(v)));return m[1]+num+m[3]};
const tick=now=>{const t=Math.min(1,(now-start)/900),eased=1-Math.pow(1-t,3);dt.textContent=t<1?text(target*eased):dt.dataset.n;if(t<1)dt._raf=requestAnimationFrame(tick)};
dt.textContent=text(0);
dt._raf=requestAnimationFrame(tick);
}
const show=()=>{const n=per(),max=Math.max(0,Math.ceil(cards.length/n)-1);if(page>max)page=max;const fresh=page!==shown;shown=page;cards.forEach((card,i)=>{const on=i>=page*n&&i<page*n+n;card.classList.toggle("is-off",!on);if(on&&fresh)card.querySelectorAll("dt").forEach(count)});prev.disabled=page===0;next.disabled=page>=max};
prev.addEventListener("click",()=>{page--;show()});
next.addEventListener("click",()=>{page++;show()});
addEventListener("resize",show);
show();
})();
</script>
</Layout>
