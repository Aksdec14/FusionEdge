function packTiles(names,center){
  const hot=[...board.querySelectorAll('.tile')].filter(t=>names.includes(t.dataset.name));
  const cols=mode==='mobile'?Math.min(4,Math.max(1,hot.length)):Math.max(2,Math.ceil(hot.length/2));
  const raw=hot.map((el,i)=>{
    const c=i%cols,r=Math.floor(i/cols);
    return {el,cx:c*geo.dx+geo.rS,cy:r*geo.row+(c%2?geo.row/2:0)+geo.h/2};
  });
  let minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity;
  raw.forEach(p=>{
    minX=Math.min(minX,p.cx-geo.rS);maxX=Math.max(maxX,p.cx+geo.rS);
    minY=Math.min(minY,p.cy-geo.h/2);maxY=Math.max(maxY,p.cy+geo.h/2);
