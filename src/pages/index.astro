        });
        $("d-bars").addEventListener("mouseover", function (e) { var b = e.target.closest(".bar"); if (b) setActive(+b.getAttribute("data-i")); });
        $("d-bars").addEventListener("click", function (e) { var b = e.target.closest(".bar"); if (b) setActive(+b.getAttribute("data-i")); });
        $("d-range").addEventListener("change", function (e) { range = e.target.value; active = Math.min(active, data[range].vals.length - 1); renderKpis(); renderChart(); });
        $("d-usearch").addEventListener("input", function (e) { uq = e.target.value.toLowerCase().trim(); renderUpdates(); });
        $("d-tsearch").addEventListener("input", function (e) { tq = e.target.value.toLowerCase().replace("#", "").trim(); renderTable(); });
        $("d-tfilter").addEventListener("change", function (e) { tf = e.target.value; renderTable(); });
        window.addEventListener("resize", placeTip);
        renderKpis(); renderChart(); renderUpdates(); renderTable();
      })();
      (function () {
        var d = document.getElementById("mods"), os = document.querySelectorAll("[data-explore]");
        if (!d || !os.length) return;
        os.forEach(function (o) { o.addEventListener("click", function () { if (d.showModal) d.showModal(); else d.setAttribute("open", ""); }); });
        d.addEventListener("click", function (e) { if (e.target === d || e.target.closest("[data-close]")) d.close(); });
      })();
