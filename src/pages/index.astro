    p.setAttribute('stroke',stroke);
    p.setAttribute('d',`M${tx.toFixed(1)},${ty.toFixed(1)} Q${qx.toFixed(1)},${qy.toFixed(1)} ${ax.toFixed(1)},${ay.toFixed(1)} M${(ax+Math.cos(a1)*L).toFixed(1)},${(ay+Math.sin(a1)*L).toFixed(1)} L${ax.toFixed(1)},${ay.toFixed(1)} L${(ax+Math.cos(a2)*L).toFixed(1)},${(ay+Math.sin(a2)*L).toFixed(1)}`);
    svg.appendChild(p);
    if(reduced){p.style.strokeDashoffset='0';tag.classList.add('on');}
    else{
      p.animate([{strokeDashoffset:1},{strokeDashoffset:0}],{duration:700,delay:i*80,easing:'ease-out',fill:'forwards'});
      setTimeout(()=>{if(tag.isConnected)tag.classList.add('on');},i*80+80);
    }
