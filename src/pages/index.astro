  const lines=(HELP[item.name]||[]).filter(Boolean);
  const spots=[
    {side:'top',html:`<b>${item.name}</b>`},
    {side:'right',html:lines[0]||''},
    {side:'bottom',html:lines[1]||''},
    {side:'left',html:lines[2]||''}
  ].filter(s=>s.html);
  const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');
  svg.setAttribute('class','pointers');
  svg.setAttribute('viewBox',`0 0 ${geo.W} ${geo.H}`);
  svg.setAttribute('width',geo.W);svg.setAttribute('height',geo.H);
  board.appendChild(svg);
  const stroke=item.color==='p'?'#5D1F72':'#00BF88';
  const cx=(box.left+box.right)/2,cy=(box.top+box.bottom)/2,sideArrow=88,bottomArrow=40;
  const fitWidth=tag=>{
    const lh=parseFloat(getComputedStyle(tag).lineHeight)||1;
    tag.style.maxWidth='none';tag.style.width='max-content';
    const full=tag.offsetWidth;let lo=160,hi=Math.max(160,full),ans=full;
    while(lo<=hi){const mid=(lo+hi)>>1;tag.style.width=mid+'px';tag.style.maxWidth=mid+'px';if(tag.offsetHeight<=lh*2+1){ans=mid;hi=mid-1;}else lo=mid+1;}
    return ans+12;
  };
  spots.forEach((s,i)=>{
    const tag=document.createElement('div');
    tag.className='pointer '+item.color+' '+s.side;
    tag.innerHTML=s.html;
    board.appendChild(tag);
    if(s.side!=='top'){const want=fitWidth(tag);tag.style.width=want+'px';tag.style.maxWidth=want+'px';}
    const w=tag.offsetWidth,h=tag.offsetHeight;
    let ax,ay,tx,ty;
    if(s.side==='top'){tag.style.left=cx+'px';tag.style.top=Math.max(4,box.top-48-h)+'px';tag.style.transform='translateX(-50%)';}
    else if(s.side==='bottom'){tag.style.left=cx+'px';tag.style.top=(box.bottom+bottomArrow)+'px';tag.style.transform='translateX(-50%)';ax=cx;ay=box.bottom+bottomArrow;tx=cx;ty=box.bottom+8;}
    else if(s.side==='left'){const left=Math.max(12,box.left-sideArrow-w);tag.style.left=left+'px';tag.style.top=(cy-h/2)+'px';ax=left+w;ay=cy;tx=box.left-12;ty=cy;}
    else{const left=Math.min(geo.W-w-12,box.right+sideArrow);tag.style.left=left+'px';tag.style.top=(cy-h/2)+'px';ax=left;ay=cy;tx=box.right+12;ty=cy;}
    if(s.side==='top'){if(reduced)tag.classList.add('on');else setTimeout(()=>{if(tag.isConnected)tag.classList.add('on');},80);return;}
    const dx=ax-tx,dy=ay-ty,len=Math.hypot(dx,dy)||1;
    const mx=(ax+tx)/2,my=(ay+ty)/2,bow=Math.min(16,len*0.2)*(i%2?1:-1);
    const qx=mx+(-dy/len)*bow,qy=my+(dx/len)*bow;
    const ang=Math.atan2(ay-qy,ax-qx),L=14,a1=ang+Math.PI-0.42,a2=ang+Math.PI+0.42;
