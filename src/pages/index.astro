<script is:inline>

(() => {
  const stage = document.getElementById('csStage');
  const drag = document.getElementById('csDrag');
  if (!stage || !drag) return;
  const cards = [...stage.querySelectorAll('.cs-card')].map(el => ({
    el,
    dim: el.querySelector('.cs-card__dim'),
    text: el.querySelector('.cs-card__text')
  }));
  const total = cards.length;
  if (!total) return;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const phone = matchMedia('(max-width: 760px)');
  const getConfig = w =>
    w < 640  ? { distanceDivisor: 120, velocityDivisor: 500, sensitivity: 180, xMultiplier: 90,  yMultiplier: 6, rotationMultiplier: 4, scaleReduction: .06 } :
    w < 1024 ? { distanceDivisor: 160, velocityDivisor: 650, sensitivity: 220, xMultiplier: 130, yMultiplier: 10, rotationMultiplier: 5, scaleReduction: .09 } :
               { distanceDivisor: 200, velocityDivisor: 800, sensitivity: 250, xMultiplier: 170, yMultiplier: 10, rotationMultiplier: 6, scaleReduction: .12 };
  let config = getConfig(innerWidth);
  const lerpRange = (v, input, output) => {
    if (v <= input[0]) return output[0];
    for (let i = 1; i < input.length; i++) {
      if (v <= input[i]) {
        const t = (v - input[i - 1]) / (input[i] - input[i - 1]);
        return output[i - 1] + t * (output[i] - output[i - 1]);
      }
    }
    return output[output.length - 1];
  };
  let progress = 0;
  function render() {
    cards.forEach((c, index) => {
      let diff = (index - progress) % total;
      if (diff > total / 2) diff -= total;
      if (diff < -total / 2) diff += total;
      const abs = Math.abs(diff);
      const x = diff * config.xMultiplier;
      const rot = abs < .05 ? 0 : diff * config.rotationMultiplier;
      const y = abs < .05 ? 0 : abs * config.yMultiplier;
      const scale = 1 - abs * config.scaleReduction;
      c.el.style.transform = `translate(${x}px, ${y}px) rotate(${rot}deg) scale(${scale})`;
      c.el.style.opacity = String(lerpRange(abs, [0, 2, 2.35], [1, 1, 0]));
      c.el.style.zIndex = String(Math.round(100 - abs * 10));
      c.el.classList.toggle('is-front', abs < .5);
      if (c.dim) c.dim.style.opacity = String(lerpRange(diff, [-2, -.5, 0, .5, 2], [.5, .2, 0, .2, .5]));
      if (c.text) c.text.style.opacity = String(lerpRange(diff, [-.5, 0, .5], [0, 1, 0]));
    });
  }
  let raf = 0, velocity = 0;
  function springTo(target) {
    if (reduce.matches) { progress = target; velocity = 0; render(); return; }
    cancelAnimationFrame(raf);
    let last = performance.now();
    const step = now => {
      const dt = Math.min(.032, (now - last) / 1000); last = now;
      const force = -200 * (progress - target) - 30 * velocity;
      velocity += force * dt;
      progress += velocity * dt;
      render();
      if (Math.abs(progress - target) > .0005 || Math.abs(velocity) > .0005) raf = requestAnimationFrame(step);
      else { progress = target; velocity = 0; render(); }
    };
    raf = requestAnimationFrame(step);
  }
  let dragging = false, armed = false, startX = 0, startY = 0, lastX = 0, startProgress = 0, samples = [];
  let auto = 0;
  let inView = false;
  const arm = () => {
    clearInterval(auto);
    if (reduce.matches || !inView) return;
    auto = setInterval(() => { if (!dragging) springTo(Math.round(progress) + 1); }, 3000);
  };
  const showSwipe = () => {
    if (reduce.matches || dragging) return;
    springTo(Math.round(progress) + 1);
    arm();
  };
  const frontCardAt = (x, y) => {
    const card = stage.querySelector('.cs-card.is-front');
    if (!card) return null;
    const r = card.getBoundingClientRect();
    return x >= r.left && x <= r.right && y >= r.top && y <= r.bottom ? card : null;
  };
  const hold = () => {
    clearInterval(auto);
    cancelAnimationFrame(raf); velocity = 0;
    startProgress = progress;
  };
  drag.addEventListener('pointerdown', e => {
    if (e.button != null && e.button !== 0) return;
    armed = true;
    startX = lastX = e.clientX; startY = e.clientY; samples = [[performance.now(), e.clientX]];
    if (phone.matches) return;
    dragging = true;
    hold();
    try { drag.setPointerCapture(e.pointerId); } catch (err) {}
  });
  drag.addEventListener('pointermove', e => {
    if (phone.matches && armed && !dragging) {
      const dx = e.clientX - startX, dy = e.clientY - startY;
      if (Math.hypot(dx, dy) < 10) return;
      armed = false;
      if (Math.abs(dy) >= Math.abs(dx)) return;
      dragging = true;
      hold();
      lastX = e.clientX;
      samples = [[performance.now(), e.clientX]];
      try { drag.setPointerCapture(e.pointerId); } catch (err) {}
    }
    if (!dragging) { drag.style.cursor = frontCardAt(e.clientX, e.clientY) ? 'pointer' : ''; return; }
    progress += -(e.clientX - lastX) / config.sensitivity;
    lastX = e.clientX;
    samples.push([performance.now(), e.clientX]); if (samples.length > 6) samples.shift();
    render();
  });
  const endDrag = (e, allowLink) => {
    const movedX = Math.abs(e.clientX - startX);
    const movedY = Math.abs(e.clientY - startY);
    const tapped = movedX < 10 && movedY < 10;
    armed = false;
    if (!dragging) {
      if (allowLink && tapped) {
        const card = frontCardAt(e.clientX, e.clientY);
        if (card) { location.href = card.dataset.href; return; }
      }
      if (!phone.matches) arm();
      return;
    }
    dragging = false;
    const dragDistance = e.clientX - startX;
    if (allowLink && tapped) {
      const card = frontCardAt(e.clientX, e.clientY);
      if (card) { location.href = card.dataset.href; return; }
    }
    const [t0, x0] = samples[0], [t1, x1] = samples[samples.length - 1];
    const vel = t1 > t0 ? (x1 - x0) / ((t1 - t0) / 1000) : 0;
    let shift = Math.round(-dragDistance / config.distanceDivisor + -vel / config.velocityDivisor);
    shift = Math.max(-3, Math.min(3, shift));
    springTo(Math.round(startProgress) + shift);
    arm();
  };
  drag.addEventListener('pointerup', e => endDrag(e, true));
  drag.addEventListener('pointercancel', e => endDrag(e, false));
  stage.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight') { e.preventDefault(); springTo(Math.round(progress) + 1); arm(); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); springTo(Math.round(progress) - 1); arm(); }
    if (e.key === 'Enter') {
      const card = stage.querySelector('.cs-card.is-front');
      if (card && card.dataset.href) location.href = card.dataset.href;
    }
  });
  addEventListener('resize', () => { config = getConfig(innerWidth); render(); });
  render();
  new IntersectionObserver(ents => {
    const on = ents.some(e => e.isIntersecting);
    if (on === inView) return;
    inView = on;
    if (on) showSwipe();
    else clearInterval(auto);
  }, { threshold: 0.45 }).observe(stage);
})();
</script>
<script is:inline>
(function(){
  var root=document.querySelector('.esg-banner');
  if(!root)return;
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  var phone=matchMedia('(max-width:860px)');
  var card=root.querySelector('.card');
  var vcard=root.querySelector('.v-card');
  var vline=root.querySelector('.v-line');
  var vnodes=[].slice.call(root.querySelectorAll('.v-node'));
  var vlbls=[].slice.call(root.querySelectorAll('.v-lbl'));
  var len=0;
  var desk;
  function measure(){
    if(!vline||!phone.matches)return;
    var n=vline.getTotalLength();
    if(!n)return;
    len=n;
    vline.style.strokeDasharray=String(len);
  }
  function armDesktop(){
    if(root.classList.contains('in')||desk)return;
    desk=new IntersectionObserver(function(ents,obs){
      if(!ents.some(function(e){return e.isIntersecting}))return;
      root.classList.add('in');
      obs.disconnect();
      desk=null;
    },{threshold:.25});
    desk.observe(card);
  }
  function onScroll(){
    if(!phone.matches||!vcard)return;
    if(!len)measure();
    var r=vcard.getBoundingClientRect();
    var trigger=innerHeight*.72;
    var p=(trigger-(r.top+r.height*.2))/(r.height*.72);
    if(p<0)p=0;
    if(p>1)p=1;
    if(len)vline.style.strokeDashoffset=String(len*(1-p));
    vnodes.forEach(function(n,i){
      var nr=n.getBoundingClientRect();
      var on=nr.top+nr.height*.5<trigger;
      n.classList.toggle('on',on);
      if(vlbls[i])vlbls[i].classList.toggle('on',on);
    });
    root.classList.toggle('grown',p>.92);
  }
  function apply(){
    if(phone.matches){
      if(desk){desk.disconnect();desk=null}
      root.classList.remove('in');
      measure();
      onScroll();
    }else{
      root.classList.remove('grown');
      vnodes.forEach(function(n,i){n.classList.remove('on');if(vlbls[i])vlbls[i].classList.remove('on')});
      armDesktop();
    }
  }
  addEventListener('scroll',onScroll,{passive:true});
  addEventListener('resize',function(){measure();apply()});
  if(phone.addEventListener)phone.addEventListener('change',apply);
  apply();
})();
</script>
</Layout>
