---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Hospitality — Fusionedge">
<div class="ix">
  <!-- Hero -->
  <section class="ix-w ix-hero">
    <span class="ix-kick">Operations software for hotels and resorts</span>
    <h1><span>Guests remember the stay.</span><span class="ix-c">We handle everything behind it.</span></h1>
    <p class="ix-lead">Rooms turned on time, requests closed before the guest calls again, and kitchens, laundries and plant rooms that never let service slip.</p>
    <div class="ix-btns">
      <a class="ix-btn pri" href="https://fusionedge.io/request-demo/">Book a demo</a>
      <a class="ix-btn" href="https://fusionedge.io/contact/">Talk to our team</a>
    </div>
    <div class="ix-trust"><span><b>All 26 apps</b> in one plan</span><span>QR requests, no app download</span><span>No card needed</span></div>
    <div class="ix-stage">
      <div class="ix-app" role="img" aria-label="Illustration of a FusionEdge Hospitality dashboard">
        <div class="ix-chrome"><i></i><i></i><i></i><span class="u">app.fusionedge.io/requests</span></div>
        <div class="ix-scroll"><div class="ix-ui">
          <div class="ix-side"><span class="">Overview</span><span class="on">Requests</span><span class="">Rooms</span><span class="">Engineering</span><span class="">Checklists</span><span class="">Reports</span></div>
          <div class="db"><div class="db-h"><div><b>Guest requests</b><small>Grand Hotel · 186 rooms · 142 occupied</small></div><div class="sp"><span class="db-pill">All floors ▾</span><span class="db-pill">Today</span><span class="db-btn">New request</span></div></div><div class="db-k"><div><small>Requests today</small><strong>64</strong><em class="">all by QR</em></div><div><small>Avg. time to close</small><strong>9 min</strong><em class="">▼ 4 min</em></div><div><small>Guest rating</small><strong>4.8</strong><em class="">from 41 ratings</em></div><div><small>Running late</small><strong>1</strong><em class="r">Room 316</em></div></div><div class="db-kb"><div class="db-col"><b>New<em>3</em></b><div class="db-cd"><div class="t"><b>Extra towels</b><i class="db-st p">2 min</i></div><small>Room 402</small></div><div class="db-cd"><div class="t"><b>Iron and board</b><i class="db-st p">4 min</i></div><small>Room 218</small></div><div class="db-cd"><div class="t"><b>Late checkout</b><i class="db-st w">6 min</i></div><small>Room 509</small></div></div><div class="db-col"><b>In progress<em>3</em></b><div class="db-cd"><div class="t"><b>AC not cooling</b><i class="db-st r">14 min</i></div><small>Room 316 · Engineering</small></div><div class="db-cd"><div class="t"><b>Room service tray</b><i class="db-st g">8 min</i></div><small>Room 120</small></div><div class="db-cd"><div class="t"><b>Pillow change</b><i class="db-st g">5 min</i></div><small>Room 611</small></div></div><div class="db-col"><b>Done today<em>3</em></b><div class="db-cd"><div class="t"><b>Wi-Fi help</b><i class="db-st g">★ 5.0</i></div><small>Room 204 · 6 min</small></div><div class="db-cd"><div class="t"><b>Extra blanket</b><i class="db-st g">★ 4.8</i></div><small>Room 330 · 9 min</small></div><div class="db-cd"><div class="t"><b>Kettle swap</b><i class="db-st g">★ 5.0</i></div><small>Room 415 · 7 min</small></div></div></div></div>
        </div></div>
      </div>
      <div class="ix-re"><div><b>All 26 apps in one plan</b><p>From asset management to visitor management, with no hidden add-ons.</p></div><div><b>No card, no setup fee</b><p>Book a demo and see it working on your own sites and assets.</p></div><div><b>ISO 27001:2022 certified</b><p>AES-256 encryption, two-factor login and role-based access.</p></div><div><b>Web, mobile and QR</b><p>Technicians work on their phones. Anyone can report an issue by QR.</p></div></div>
    </div>
  </section>
  <hr class="ix-rule">

  <!-- Segments -->
  <section class="ix-w ix-sec">
    <div class="ix-head">
      <div><h2>Which kind of property is yours?</h2><p class="ix-p">A city hotel, a resort and a serviced apartment all run differently. FusionEdge fits the way each one works.</p></div>
      <a class="ix-link" href="/industries/">All industries →</a>
    </div>
    <div class="ix-segs"><article class="ix-seg"><div class="ix-ph"><img src="https://images.unsplash.com/photo-1621293954908-907159247fc8?auto=format&fit=crop&w=600&q=70" srcset="https://images.unsplash.com/photo-1621293954908-907159247fc8?auto=format&fit=crop&w=600&q=70 1x, https://images.unsplash.com/photo-1621293954908-907159247fc8?auto=format&fit=crop&w=1200&q=60 2x" alt="Modern hotel lobby" loading="lazy" decoding="async" onerror="this.remove()"></div><h3>City hotels</h3><p>Business and transit</p><small><b>Fits</b> · fast room turnover</small></article><article class="ix-seg"><div class="ix-ph"><img src="https://images.unsplash.com/photo-1623718649591-311775a30c43?auto=format&fit=crop&w=600&q=70" srcset="https://images.unsplash.com/photo-1623718649591-311775a30c43?auto=format&fit=crop&w=600&q=70 1x, https://images.unsplash.com/photo-1623718649591-311775a30c43?auto=format&fit=crop&w=1200&q=60 2x" alt="Resort swimming pool with palm trees" loading="lazy" decoding="async" onerror="this.remove()"></div><h3>Resorts</h3><p>Leisure and destinations</p><small><b>Fits</b> · large grounds, many assets</small></article><article class="ix-seg"><div class="ix-ph"><img src="https://images.unsplash.com/photo-1758448511322-8bfc73daf606?auto=format&fit=crop&w=600&q=70" srcset="https://images.unsplash.com/photo-1758448511322-8bfc73daf606?auto=format&fit=crop&w=600&q=70 1x, https://images.unsplash.com/photo-1758448511322-8bfc73daf606?auto=format&fit=crop&w=1200&q=60 2x" alt="Serviced apartment living room" loading="lazy" decoding="async" onerror="this.remove()"></div><h3>Serviced apartments</h3><p>Longer stays</p><small><b>Fits</b> · in-room requests</small></article><article class="ix-seg"><div class="ix-ph"><img src="https://images.unsplash.com/photo-1763429338698-439aa108e7fb?auto=format&fit=crop&w=600&q=70" srcset="https://images.unsplash.com/photo-1763429338698-439aa108e7fb?auto=format&fit=crop&w=600&q=70 1x, https://images.unsplash.com/photo-1763429338698-439aa108e7fb?auto=format&fit=crop&w=1200&q=60 2x" alt="Event hall set for a banquet" loading="lazy" decoding="async" onerror="this.remove()"></div><h3>Banquets and events</h3><p>Weddings and conferences</p><small><b>Fits</b> · setups on time</small></article></div>

    <!-- Feature photo -->
    <div class="ix-feat">
      <div class="ix-ph"><img src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=1400&q=70" srcset="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=1400&q=70 1x, https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=2800&q=60 2x" alt="Hotel bed with white linen" loading="lazy" decoding="async" onerror="this.remove()"></div>
      <div class="ix-feat-card"><h2>Every request timed, from QR scan to closed</h2><p class="ix-p">Guests scan a QR code in the room. The request goes straight to the right team member, the timer starts, and supervisors are alerted if it runs late.</p><a class="ix-link" href="/industries/hospitality#faq-0">See guest requests →</a></div>
    </div>
  </section>

  <!-- How it runs -->
  <section class="ix-runs">
    <div class="ix-w ix-runs-g">
      <div class="ix-ph"><img src="https://images.unsplash.com/photo-1762779943673-fcb177e7fe56?auto=format&fit=crop&w=800&q=70" srcset="https://images.unsplash.com/photo-1762779943673-fcb177e7fe56?auto=format&fit=crop&w=800&q=70 1x, https://images.unsplash.com/photo-1762779943673-fcb177e7fe56?auto=format&fit=crop&w=1600&q=60 2x" alt="Long hotel hallway with wall lamps" loading="lazy" decoding="async" onerror="this.remove()"></div>
      <div>
        <h2>How a hotel day runs</h2>
        <p class="ix-p">The same five jobs every day, now in one place and in the order they happen.</p>
        <div class="ix-rows"><div class="ix-row"><b>Arrival</b><p>Rooms are marked ready only after inspection, so check-in is never held up.</p></div><div class="ix-row"><b>In the room</b><p>Guests scan a QR code for towels, repairs or anything else.</p></div><div class="ix-row"><b>Dining</b><p>Kitchen equipment, cold rooms and hygiene checklists are kept on schedule.</p></div><div class="ix-row"><b>Events</b><p>Banquet halls are set up, AV tested and handed over on time.</p></div><div class="ix-row"><b>Checkout</b><p>Feedback is captured, and the room goes straight into the turnover queue.</p></div></div>
        <div class="ix-btns"><a class="ix-btn dark" href="https://fusionedge.io/request-demo/">See the platform</a></div>
      </div>
    </div>
  </section>

  <!-- Side by side -->
  <section class="ix-w ix-sec ix-sbs">
    <div>
      <h2>Two weeks, side by side</h2>
      <p class="ix-p">Same hotel, same rooms, same full house on Saturday. The difference is what guests notice.</p>
      <div class="ix-ph"><img src="https://images.unsplash.com/photo-1758193783649-13371d7fb8dd?auto=format&fit=crop&w=600&q=70" srcset="https://images.unsplash.com/photo-1758193783649-13371d7fb8dd?auto=format&fit=crop&w=600&q=70 1x, https://images.unsplash.com/photo-1758193783649-13371d7fb8dd?auto=format&fit=crop&w=1200&q=60 2x" alt="Hotel lobby with reception desk" loading="lazy" decoding="async" onerror="this.remove()"></div>
    </div>
    <div class="ix-tbl"><div class="th"></div><div class="th">A week on the phone</div><div class="th hi">A week with FusionEdge</div><div class="d">Monday</div><div class="o">Guests call the front desk for towels. Some calls are missed.</div><div class="n">Guests scan a QR code. Towels arrive in minutes.</div><div class="d">Tuesday</div><div class="o">Room 512 needs a deep clean, but nobody is assigned.</div><div class="n">The task is in the queue with an owner and a time.</div><div class="d">Wednesday</div><div class="o">Room 316’s AC fails. The guest calls three times.</div><div class="n">A ticket opens, the timer starts and the engineer is alerted.</div><div class="d">Thursday</div><div class="o">Room inspections are ticked on paper.</div><div class="n">Inspections are logged with photos before rooms go live.</div><div class="d">Friday</div><div class="o">The banquet hall setup runs late.</div><div class="n">The setup was scheduled and checked off on time.</div><div class="d">Saturday</div><div class="o">Full house. Requests pile up at the desk.</div><div class="n">Requests flow to teams directly, and nothing is lost.</div><div class="d">Sunday</div><div class="o">The GM learns about problems from online reviews.</div><div class="n">One dashboard shows every request and every rating.</div></div>
  </section>

  <!-- Customer story -->
  <section class="ix-story">
    <div class="ix-w">
      <h2>300 calls a day, down to almost zero</h2>
      <p class="ix-p">How a global logistics leader replaced pantry phone orders with QR ordering in 3 weeks.</p>
      <div class="ix-card">
        <div class="ix-ph"><img src="https://images.unsplash.com/photo-1785136589016-eac02670e8a3?auto=format&fit=crop&w=900&q=70" srcset="https://images.unsplash.com/photo-1785136589016-eac02670e8a3?auto=format&fit=crop&w=900&q=70 1x, https://images.unsplash.com/photo-1785136589016-eac02670e8a3?auto=format&fit=crop&w=1800&q=60 2x" alt="Office coffee station with cups and a coffee maker" loading="lazy" decoding="async" onerror="this.remove()"></div>
        <div class="ix-cb">
          <span class="who">Pantry Management &amp; QR Ordering</span>
          <p class="sum">A global logistics leader’s pantry was flooded with 300+ phone orders a day, and many arrived late. FusionEdge replaced the calls with a QR scan and automatic escalation.</p>
          <div class="ix-stats"><div><b>8 min</b><span>average delivery, down from 22</span></div><div><b>97%</b><span>orders on time, up from 68%</span></div><div><b>3</b><span>escalations a month, down from 40</span></div></div>
          <blockquote>“Late orders are escalated automatically at 5 and 10 minutes. Escalations to management are down 92%.”</blockquote>
          <div class="ix-btns"><a class="ix-btn dark" href="/stories/pantry-management">Read the story</a></div>
        </div>
      </div>
      <div class="ix-also"><b>Also running on FusionEdge:</b><div><span>City hotels</span><span>Resorts</span><span>Serviced apartments</span><span>Hotel groups</span><span>Banquet and event venues</span><span>Clubs</span></div></div>
    </div>
  </section>


  <!-- CTA -->
  <section class="ix-cta">
    <div class="ix-w">
      <h2>Run tomorrow’s full house <span>on FusionEdge.</span></h2>
      <p class="ix-p">Book a demo and we will walk you through the modules for your rooms, kitchens, engineering and guest requests. No card and no setup fee.</p>
      <div class="ix-btns">
        <a class="ix-btn pri" href="https://fusionedge.io/request-demo/">Book a demo</a>
        <a class="ix-btn" href="https://fusionedge.io/contact/">Contact sales</a>
      </div>
    </div>
  </section>
</div>
</Layout>

<style>
.ix{--brand:#5D1F72;--ink:#1a1424;--mut:#6b6478;--line:rgba(93,31,114,0.1);--soft:rgba(93,31,114,0.05);--soft2:#f5f5f7;--mint:#eef8f3;--green:#00BF88;--green-ink:#008a62;
  --w:1080px;--pad:clamp(20px,4vw,40px);--sec:clamp(72px,10vw,120px);
  font-family:"Public Sans",sans-serif;color:var(--ink);line-height:1.6;background:#fff;overflow-x:clip}
.ix *,.ix *::before,.ix *::after{box-sizing:border-box;font-family:"Public Sans",sans-serif}
.ix h1,.ix h2,.ix h3,.ix p{margin:0;max-width:none}
.ix a{color:inherit}
.ix-w{max-width:calc(var(--w) + var(--pad)*2);margin:0 auto;padding:0 var(--pad)}
.ix h1{font-size:clamp(19px,4.8vw,58px);line-height:1.05;letter-spacing:-.035em;font-weight:700;color:var(--ink)}
.ix h2{font-size:clamp(22px,3.2vw,38px);line-height:1.15;letter-spacing:-.03em;font-weight:700;color:var(--ink);text-wrap:balance}
.ix h3{font-size:16px;line-height:1.35;letter-spacing:-.01em;font-weight:600;color:var(--ink)}
.ix .ix-c{color:var(--brand)}
.ix .ix-p{font-size:15px;color:var(--mut);line-height:1.65}
.ix-kick{display:inline-block;font-size:13px;font-weight:600;color:var(--brand);letter-spacing:.01em}
.ix-btns{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
.ix a.ix-btn,.ix a.ix-btn:visited{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 22px;border-radius:99px;font-size:14px;font-weight:600;text-decoration:none!important;border:1px solid rgba(93,31,114,0.18);background:#fff;color:var(--ink)!important;transition:transform .15s,box-shadow .15s,background .15s}
.ix a.ix-btn:hover{transform:translateY(-1px);box-shadow:0 6px 16px rgba(93,31,114,.12)}
.ix a.ix-btn.pri,.ix a.ix-btn.pri:visited{background:var(--brand);border-color:var(--brand);color:#fff!important}
.ix a.ix-btn.pri:hover{background:var(--brand-d)}
.ix a.ix-btn.dark,.ix a.ix-btn.dark:visited{background:var(--ink);border-color:var(--ink);color:#fff!important}
.ix a.ix-link{font-size:14px;font-weight:600;color:var(--ink)!important;text-decoration:none}
.ix a.ix-link:hover{color:var(--brand)!important}
.ix-ph{position:relative;display:grid;place-items:center;overflow:hidden;border-radius:14px;color:#8d83a0;font-size:12px;text-align:center;padding:16px;
  background:linear-gradient(135deg,rgba(93,31,114,0.1),#e6f4ee)}
.ix-ph span{max-width:26ch;line-height:1.4;opacity:.85}
.ix-ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}

/* Hero */
.ix-hero{text-align:center;padding-top:clamp(48px,7vw,88px)}
.ix-hero h1{margin:14px auto 0;max-width:none}
.ix-hero h1 span{display:block;white-space:nowrap}
.ix-hero .ix-lead{max-width:540px;margin:20px auto 28px;font-size:16px;color:var(--mut);line-height:1.6}
.ix-trust{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 20px;margin-top:20px;font-size:13px;color:var(--mut)}
.ix-trust b{color:var(--ink);font-weight:600}
.ix-trust span+span::before{content:"";display:inline-block;width:4px;height:4px;border-radius:50%;background:rgba(93,31,114,0.25);margin:0 14px 2px 0;vertical-align:middle}
.ix-stage{position:relative;margin-top:clamp(36px,5vw,52px)}
.ix-stage::before{content:"";position:absolute;left:-50vw;right:-50vw;top:12%;bottom:0;background:var(--soft);z-index:0}

/* App mock */
.ix-app{position:relative;z-index:1;background:#fff;border:1px solid rgba(93,31,114,0.12);border-radius:14px;box-shadow:0 30px 60px -24px rgba(93,31,114,.25);overflow:hidden;text-align:left}
.ix-chrome{display:flex;align-items:center;gap:12px;height:34px;padding:0 12px;background:rgba(93,31,114,0.03);border-bottom:1px solid rgba(93,31,114,0.1)}
.ix-chrome i{width:9px;height:9px;border-radius:50%;background:rgba(93,31,114,0.18);display:inline-block}
.ix-chrome .u{margin:0 auto;font-size:10.5px;color:#8d83a0;background:#fff;border:1px solid rgba(93,31,114,0.1);border-radius:6px;padding:2px 14px}
.ix-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
.ix-ui{display:grid;grid-template-columns:150px minmax(0,1fr);min-width:900px;font-size:11px}
.ix-side{border-right:1px solid rgba(93,31,114,0.07);padding:14px 10px;display:flex;flex-direction:column;gap:2px}
.ix-side span{display:flex;justify-content:space-between;align-items:center;padding:6px 8px;border-radius:7px;color:#4b4357}
.ix-side span.on{background:var(--soft);color:var(--brand);font-weight:600}
.ix-side em{font-style:normal;font-size:9.5px;font-weight:700;color:#fff;background:#e5483b;border-radius:99px;padding:0 6px}
.ix-main{padding:12px 14px 6px}
.ix-top{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.ix-top b{display:block;font-size:13px;color:var(--ink)}
.ix-top small{display:block;font-size:10px;color:var(--mut)}
.ix-tog{display:flex;background:rgba(93,31,114,0.06);border-radius:7px;padding:2px;margin-left:6px}
.ix-tog span{padding:3px 10px;border-radius:5px;color:var(--mut);font-weight:600;font-size:10px}
.ix-tog span.on{background:#fff;color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.08)}
.ix-prog{margin-left:auto;text-align:right;font-size:10px;color:var(--mut)}
.ix-prog b{display:inline;font-size:11px}
.ix-prog em{display:block;width:150px;height:5px;border-radius:99px;background:rgba(93,31,114,0.09);margin-top:4px;overflow:hidden}
.ix-prog em i{display:block;height:100%;background:var(--green);border-radius:99px}
.ix-pub{background:var(--brand);color:#fff;font-weight:600;font-size:10.5px;padding:6px 12px;border-radius:99px;white-space:nowrap}
.ix-grid{display:grid;grid-template-columns:170px repeat(7,minmax(0,1fr));border-top:1px solid rgba(93,31,114,0.07)}
.ix-grid>div{border-bottom:1px solid rgba(93,31,114,0.06);border-left:1px solid rgba(93,31,114,0.06);min-height:46px;padding:5px}
.ix-grid>div:nth-child(8n+1){border-left:0;display:flex;align-items:center;gap:8px;padding-left:2px}
.ix-gh{min-height:28px!important;font-size:10px;color:var(--mut);font-weight:600;display:flex;align-items:center}
.ix-gh.today{color:var(--brand)}
.ix-av{width:22px;height:22px;border-radius:50%;flex:none;display:grid;place-items:center;font-size:8.5px;font-weight:700;background:rgba(93,31,114,0.08);color:var(--brand)}
.ix-av.op{background:#fff;border:1.5px dashed rgba(93,31,114,0.4);color:var(--brand)}
.ix-rn b{display:block;font-size:10.5px;color:var(--ink);font-weight:600;line-height:1.2}
.ix-rn small{display:block;font-size:9px;color:var(--mut)}
.ix-ch{display:block;border-radius:6px;padding:4px 6px;line-height:1.25;font-size:9.5px;font-weight:600}
.ix-ch small{display:block;font-weight:500;font-size:8.5px;opacity:.8}
.ix-ch.ppm{background:rgba(93,31,114,0.08);color:#5D1F72}
.ix-ch.chk{background:#e8f8f1;color:#00754f}
.ix-ch.tkt{background:#fdecea;color:#b23a2b}
.ix-ch.ins{background:#fdf1e2;color:#9a5c0d}
.ix-ch.opn{background:#fff;border:1.5px dashed rgba(93,31,114,0.35);color:#5D1F72}
.ix-ch .flag{display:inline-block;margin-top:3px;background:#5D1F72;color:#fff;border-radius:99px;padding:1px 6px;font-size:8px}

/* Reassure row */
.ix-re{position:relative;z-index:1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(16px,3vw,32px);padding:28px 0 clamp(40px,5vw,56px);text-align:left}
.ix-re b{display:block;font-size:14px;color:var(--ink)}
.ix-re p{font-size:13px;color:var(--mut);margin-top:4px;line-height:1.55}
.ix-rule{border:0;border-top:1px solid var(--line);margin:0}

/* Section heads */
.ix-sec{padding-top:var(--sec)}
.ix-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:clamp(24px,3vw,36px)}
.ix-head h2{max-width:24ch}
.ix-head .ix-p{max-width:480px;margin-top:14px}

/* Segment cards */
.ix-segs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(12px,1.6vw,18px)}
.ix-seg .ix-ph{aspect-ratio:4/5;border-radius:12px}
.ix-seg h3{margin-top:14px}
.ix-seg p{font-size:13px;color:var(--mut);margin-top:2px}
.ix-seg small{display:block;font-size:12px;color:var(--mut);margin-top:6px}
.ix-seg small b{color:var(--ink);font-weight:600}

/* Feature photo */
.ix-feat{position:relative;margin-top:var(--sec);border-radius:16px;overflow:hidden;min-height:clamp(360px,40vw,440px);display:flex;align-items:flex-end}
.ix-feat>.ix-ph{position:absolute;inset:0;border-radius:0;background:linear-gradient(120deg,rgba(93,31,114,0.14),#dff1e8)}
.ix-feat-card{position:relative;z-index:1;margin:0 0 clamp(20px,3vw,32px) clamp(20px,3vw,32px);background:#fff;border-radius:14px;padding:clamp(20px,2.4vw,28px);max-width:460px;box-shadow:0 20px 40px -18px rgba(93,31,114,.35)}
.ix-feat-card h2{font-size:clamp(20px,2.4vw,28px)}
.ix-feat-card .ix-p{margin:12px 0 16px;font-size:14px}

/* How it runs */
.ix-runs{margin-top:var(--sec);background:var(--soft);padding:var(--sec) 0}
.ix-runs-g{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(32px,5vw,64px);align-items:start}
.ix-runs .ix-ph{aspect-ratio:4/5;border-radius:14px;background:linear-gradient(160deg,#fff,rgba(93,31,114,0.1))}
.ix-runs .ix-p{margin:12px 0 22px;max-width:440px}
.ix-rows{border-top:1px solid rgba(93,31,114,0.14)}
.ix-row{display:grid;grid-template-columns:120px minmax(0,1fr);gap:20px;padding:16px 0;border-bottom:1px solid rgba(93,31,114,0.14)}
.ix-row b{font-size:14px}
.ix-row p{font-size:14px;color:var(--mut);line-height:1.6}
.ix-runs .ix-btns{justify-content:flex-start;margin-top:28px}

/* Side by side */
.ix-sbs{display:grid;grid-template-columns:minmax(0,.62fr) minmax(0,1.38fr);gap:clamp(28px,4vw,48px);align-items:start}
.ix-sbs h2{max-width:none}
.ix-sbs .ix-p{margin:14px 0 22px}
.ix-sbs .ix-ph{aspect-ratio:4/5;border-radius:14px}
.ix-tbl{display:grid;grid-template-columns:96px minmax(0,1fr) minmax(0,1fr);border-radius:14px;overflow:hidden}
.ix-tbl>div{padding:14px 16px;font-size:13px;line-height:1.55;border-bottom:1px solid var(--line)}
.ix-tbl .th{font-weight:700;font-size:13px;color:var(--ink);border-bottom:1px solid var(--line)}
.ix-tbl .th.hi{color:var(--brand)}
.ix-tbl .d{font-weight:600;font-size:12.5px}
.ix-tbl .o{color:var(--mut)}
.ix-tbl .n{background:rgba(93,31,114,0.07);color:var(--ink);font-weight:500}
.ix-tbl .th.hi,.ix-tbl .n{background:rgba(93,31,114,0.07)}
.ix-tbl>div:nth-last-child(-n+3){border-bottom:0}

/* Story */
.ix-story{margin-top:var(--sec);background:var(--soft2);padding:var(--sec) 0}
.ix-story h2{max-width:26ch}
.ix-story .ix-p{margin-top:12px;max-width:520px}
.ix-card{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);background:#fff;border-radius:16px;overflow:hidden;margin-top:clamp(24px,3vw,36px);box-shadow:0 16px 40px -24px rgba(93,31,114,.3)}
.ix-card>.ix-ph{border-radius:0;min-height:340px}
.ix-cb{padding:clamp(22px,3vw,36px);display:flex;flex-direction:column;gap:18px}
.ix-cb .who{font-size:12.5px;font-weight:600;color:var(--brand)}
.ix-cb .sum{font-size:14px;color:var(--mut)}
.ix-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;padding:16px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.ix-stats b{display:block;font-size:clamp(24px,2.6vw,32px);font-weight:700;letter-spacing:-.03em;color:var(--brand);line-height:1.05}
.ix-stats span{display:block;font-size:12px;color:var(--mut);margin-top:6px;line-height:1.4}
.ix-cb blockquote{margin:0;font-size:clamp(16px,1.6vw,19px);line-height:1.45;font-weight:600;letter-spacing:-.01em;color:var(--ink)}
.ix-cb .ix-btns{justify-content:flex-start}
.ix-also{margin-top:22px}
.ix-also b{display:block;font-size:12.5px;margin-bottom:8px}
.ix-also div{display:flex;flex-wrap:wrap;gap:8px}
.ix-also span{font-size:12px;color:var(--mut);background:#fff;border:1px solid var(--line);border-radius:99px;padding:4px 12px}


/* CTA */
.ix-cta{position:relative;background:#5D1F72;color:#fff;text-align:center;padding:clamp(72px,10vw,112px) 0;overflow:hidden}
.ix-cta::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 15% 25%,rgba(255,255,255,.08),transparent 40%),radial-gradient(circle at 85% 75%,rgba(0,191,136,.16),transparent 40%)}
.ix-cta>*{position:relative}
.ix-cta h2{color:#fff;max-width:26ch;margin:0 auto}
.ix-cta h2 span{color:#7ff0c9}
.ix-cta .ix-p{color:rgba(255,255,255,.82);max-width:460px;margin:16px auto 26px}
.ix-cta a.ix-btn.pri{background:#fff;border-color:#fff;color:var(--brand)!important}
.ix-cta a.ix-btn:not(.pri){background:transparent;border-color:rgba(255,255,255,.35);color:#fff!important}

/* Responsive */
@media (max-width:960px){
  .ix-segs{grid-template-columns:repeat(2,minmax(0,1fr))}
  .ix-re{grid-template-columns:repeat(2,minmax(0,1fr))}
  .ix-sbs{grid-template-columns:1fr}
  .ix-sbs h2{max-width:none}
  .ix-sbs .ix-ph{display:none}
}
@media (max-width:760px){
  .ix-ui{grid-template-columns:1fr;min-width:700px}
  .ix-side{display:none}
  .ix-head{flex-direction:column;align-items:flex-start}
  .ix-runs-g,.ix-card{grid-template-columns:1fr}
  .ix-runs .ix-ph{aspect-ratio:16/10}
  .ix-card>.ix-ph{min-height:220px}
  .ix-row{grid-template-columns:1fr;gap:4px}
  .ix-tbl{grid-template-columns:1fr 1fr}
  .ix-tbl .th:first-child{display:none}
  .ix-tbl .d{grid-column:1/-1;background:#faf9fb;padding:10px 14px}
  .ix-feat-card{margin:16px;max-width:none}
}
@media (max-width:560px){
  .ix-segs{grid-template-columns:1fr 1fr;gap:12px}
  .ix-re{grid-template-columns:1fr}
  .ix-stats{grid-template-columns:1fr 1fr 1fr;gap:10px}
  .ix-hero .ix-btns{flex-direction:column;align-items:stretch;max-width:340px;margin:0 auto}
  .ix-trust span+span::before{display:none}
  .ix-tbl>div{padding:12px}
}
@media (prefers-reduced-motion:reduce){.ix *{transition:none!important}}

