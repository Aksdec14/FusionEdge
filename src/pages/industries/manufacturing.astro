---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Manufacturing Solutions — Fusionedge">
<div class="cs">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400..700;1,400..700&display=swap">

  <!-- Hero -->
  <div class="cs-w">
    <div class="mf-hero">
      <div>
        <h1>Run at full capacity — <span class="cs-ul">every minute counts</span></h1>
        <p class="cs-lead">Turn downtime into maximum uptime with FusionEdge's smart manufacturing intelligence. Ensure 100 % operational availability with the best asset-management solution built for the floor.</p>
        <div class="cs-btns">
          <a class="cs-btn cs-p" href="https://fusionedge.io/request-demo/">Request Demo <span class="cs-ar">→</span></a>
          <a class="cs-btn" href="https://fusionedge.io/contact/">Learn More</a>
        </div>
        <div class="mf-kpi">
          <div><b>99%</b><span>Uptime</span></div>
          <div><b>40%</b><span>Less Downtime</span></div>
          <div><b>500+</b><span>Facilities</span></div>
        </div>
      </div>

      <div class="mf-dash" role="img" aria-label="Illustration of a live factory dashboard">
        <div class="mf-dbar">
          <div class="mf-dots"><i></i><i></i><i></i></div>
          <span class="mf-dtitle">Live Factory Dashboard</span>
          <span class="mf-live">Live</span>
        </div>
        <div class="mf-dbody">
          <div class="mf-dmeta"><span>Plant 1 · All lines</span><span>Updated 2 s ago</span></div>
          <div class="mf-tiles">
            <div><small>Uptime</small><strong>99.2%</strong><em class="up">▲ 1.4%</em></div>
            <div><small>Open work orders</small><strong>12</strong><em class="dn">▼ 5</em></div>
            <div><small>Assets online</small><strong>248<span>/252</span></strong><em class="nt">4 in PM</em></div>
          </div>
          <div class="mf-chart">
            <div class="mf-ch-h"><b>Availability, last 12 h</b><span><i class="a"></i>Actual <i class="t"></i>Target</span></div>
            <svg viewBox="0 0 320 110" preserveAspectRatio="none">
              <g stroke="#efeaf3" stroke-width="1"><line x1="0" y1="10" x2="320" y2="10"/><line x1="0" y1="40" x2="320" y2="40"/><line x1="0" y1="70" x2="320" y2="70"/><line x1="0" y1="100" x2="320" y2="100"/></g>
              <line x1="0" y1="26" x2="320" y2="26" stroke="#00BF88" stroke-width="1.2" stroke-dasharray="4 4"/>
              <defs><linearGradient id="mfArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5D1F72" stop-opacity=".22"/><stop offset="1" stop-color="#5D1F72" stop-opacity="0"/></linearGradient></defs>
              <path d="M0 62 L29 55 L58 58 L87 46 L116 50 L145 38 L174 42 L203 30 L232 33 L261 22 L290 20 L320 16 L320 110 L0 110Z" fill="url(#mfArea)"/>
              <path d="M0 62 L29 55 L58 58 L87 46 L116 50 L145 38 L174 42 L203 30 L232 33 L261 22 L290 20 L320 16" fill="none" stroke="#5D1F72" stroke-width="2" stroke-linejoin="round"/>
              <circle cx="320" cy="16" r="3.5" fill="#5D1F72" stroke="#fff" stroke-width="1.5"/>
            </svg>
            <div class="mf-xl"><span>06:00</span><span>09:00</span><span>12:00</span><span>15:00</span><span>Now</span></div>
          </div>
          <div class="mf-tbl">
            <div class="mf-tr mf-th"><span>Line</span><span>OEE</span><span>Status</span></div>
            <div class="mf-tr"><span>Line A · Press</span><span>96%</span><span><i class="s ok">Running</i></span></div>
            <div class="mf-tr"><span>Line B · CNC</span><span>91%</span><span><i class="s ok">Running</i></span></div>
            <div class="mf-tr"><span>Line C · Packing</span><span>88%</span><span><i class="s pm">PM due</i></span></div>
          </div>
        </div>
      </div>
    </div>
    <p class="mf-scroll">Scroll</p>
  </div>

  <!-- Ticker -->
  <div class="mf-marquee" aria-label="40% Less Downtime, Real-Time Asset Tracking, Automated Preventive Maintenance, 24/7 Support Coverage, Smart Inventory Management, Enterprise-Grade Security">
    <div class="mf-track" aria-hidden="true"><span>40% Less Downtime</span><span>Real-Time Asset Tracking</span><span>Automated Preventive Maintenance</span><span>24/7 Support Coverage</span><span>Smart Inventory Management</span><span>Enterprise-Grade Security</span><span>40% Less Downtime</span><span>Real-Time Asset Tracking</span><span>Automated Preventive Maintenance</span><span>24/7 Support Coverage</span><span>Smart Inventory Management</span><span>Enterprise-Grade Security</span></div>
  </div>

  <!-- Why -->
  <div class="cs-w">
    <section class="mf-why">
      <div class="cs-head">
        <div>
          <span class="cs-tag">Why FusionEdge</span>
          <h2>The antidote to potential breakdowns: FusionEdge</h2>
        </div>
        <p class="cs-lead">Manage operations smoothly with prompt maintenance alerts and analytical dashboards. Shift from reactive repairs to preventive care — boosting asset reliability and longevity.</p>
      </div>
      <div class="cs-grid3">
        <article class="cs-card"><div class="cs-b"><span class="mf-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/></svg></span><h3>Preventive Maintenance</h3><p>FusionEdge tracks every maintenance task automatically. Proactive checklists and scheduled preventive routines guarantee enhanced asset availability and consistent uptime across every facility.</p></div></article>
        <article class="cs-card"><div class="cs-b"><span class="mf-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg></span><h3>Spare Parts Inventory Planning</h3><p>Smart inventory tracking paired with automated reordering ensures critical parts are always on hand. Eliminate emergency expenses and production stoppages with fail-proof supply continuity.</p></div></article>
        <article class="cs-card"><div class="cs-b"><span class="mf-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/><path d="M12 8v4l3 2"/></svg></span><h3>Automated Maintenance Processes</h3><p>Automate workflows, minimize manual interventions, and empower teams with intelligent scheduling and reporting — achieving optimal efficiency without the overhead.</p></div></article>
      </div>
    </section>
  </div>

  <!-- How it works -->
  <div class="cs-tint mf-how-wrap">
    <div class="cs-w mf-how-inner">
      <div class="mf-bento-head">
        <span class="cs-tag">How It Works</span>
        <h2>Together, we achieve more</h2>
      </div>
      <div class="mf-bento">
        <article class="mf-b mf-a">
          <span class="mf-feat">Feature 01</span>
          <div class="mf-b-txt">
            <h3>Custom Dashboard, Automated Reports</h3>
            <p class="mf-kick">Know your assets with real-time insights</p>
            <p>Stay on top of maintenance performance by tracking and optimizing every activity. Our analytical insights surface the data you need to make focused, informed decisions for asset maintenance and repairs — at a glance.</p>
          </div>
        </article>
        <article class="mf-b mf-c">
          <span class="mf-feat">Feature 03</span>
          <div class="mf-b-txt">
            <h3>In a Jam? FusionEdge Has Your Back</h3>
            <p class="mf-kick">A friendly platform, round the clock</p>
            <p>A robust help centre, live support, and embedded how-to videos mean every question gets answered fast. No matter the plan, FusionEdge's customer-first service responds instantly — making maintenance effortless at every step.</p>
          </div>
        </article>
        <article class="mf-b mf-stat mf-g1"><div class="mf-glow"></div><div class="mf-stat-txt"><strong>99%</strong><span>Uptime</span></div></article>
        <article class="mf-b mf-stat mf-g2"><div class="mf-glow"></div><div class="mf-stat-txt"><strong>500+</strong><span>Facilities</span></div></article>
        <article class="mf-b mf-d">
          <span class="mf-feat">Feature 02</span>
          <div class="mf-b-txt">
            <h3>Maintenance Management at Your Fingertips</h3>
            <p class="mf-kick">A bespoke platform, under your command</p>
            <p>Run maintenance processes exactly how your operation demands. Customized work-request portals, QR codes, smart templates, and automated reports combine into a single command center — peak performance with maximum efficiency.</p>
          </div>
        </article>
        <article class="mf-b mf-e">
          <div class="cs-ph mf-e-img"></div>
          <div class="mf-e-txt">
            <span class="mf-feat">Feature 04</span>
            <h3>Scalable Solution for Any Team Size</h3>
            <p class="mf-kick">Big or small — the platform grows with you</p>
            <p>FusionEdge is purpose-built to elevate maintenance management at every scale. This future-ready, flexible solution adapts as your team expands — from a lean startup crew to full enterprise operations, without missing a beat.</p>
          </div>
        </article>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="cs-w">
    <div class="cs-cta">
      <span class="cs-tag" style="color:#e6d6ee">Get Started</span>
      <h2 class="mf-cta-h" style="margin-top:14px">Let's glimpse how FusionEdge is reshaping the future</h2>
      <p>Optimum maintenance for manufacturing companies and contractors — built for scale, designed for simplicity.</p>
      <div class="cs-btns">
        <a class="cs-btn cs-g" href="https://fusionedge.io/contact/">Start Your Journey <span class="cs-ar">→</span></a>
      </div>
    </div>
  </div>
</div>
</Layout>

<style>
.cs{
  --bg:#fff;--soft:#f4eff7;--ink:#1b1530;--mut:#6c6780;--line:#ebe6f0;--card:#fff;
  --brand:#5D1F72;--green:#00BF88;--green-ink:#00a576;--ph:#ece7f0;--phx:#9a91a6;
  --r:16px;--sec:clamp(72px,10vw,120px);color-scheme:light
}
.cs,.cs *{box-sizing:border-box}
.cs{background:var(--bg);color:var(--ink);font-family:"Public Sans",sans-serif;line-height:1.6;width:100%}
.cs,.cs *,.cs *::before,.cs *::after{font-family:"Public Sans",sans-serif!important}
.cs h1,.cs h2,.cs h3,.cs p{margin:0}
.cs h1,.cs h2,.cs h3{color:var(--ink)}
.cs-w{max-width:1160px;margin:0 auto;padding:0 clamp(20px,4vw,40px)}

/* Type — italic display headings like the main site */
.cs h1{font-size:clamp(28px,5.2vw,60px);line-height:1.05;letter-spacing:-.03em;font-weight:600;font-style:italic}
.cs h2{font-size:clamp(26px,3.2vw,38px);line-height:1.15;letter-spacing:-.025em;font-weight:600;font-style:italic;text-wrap:balance}
.cs h3{font-size:16.5px;line-height:1.35;font-weight:600;color:var(--brand)}
.cs-lead{font-size:clamp(15px,1.4vw,17px);color:var(--mut);line-height:1.7}
.cs-ul{color:var(--brand);text-decoration:underline;text-decoration-color:var(--green);text-decoration-thickness:3px;text-underline-offset:8px}

/* Bits */
.cs-tag{display:inline-flex;align-items:center;gap:8px;font-size:11.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--brand)}
.cs-tag::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.cs-pill{font-size:12.5px;padding:5px 12px;border-radius:99px;background:#fff;color:var(--brand);border:1px solid #dccde6}
.cs-btns{display:flex;gap:12px;flex-wrap:wrap}
.cs-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 26px;border-radius:99px;font:600 14px/1 "Public Sans",sans-serif;
  border:1px solid #d9cfe2;background:#fff;color:var(--brand);text-decoration:none;transition:transform .15s,background .15s,border-color .15s,box-shadow .15s}
.cs-btn:hover{transform:translateY(-1px);border-color:var(--brand)}
.cs-btn.cs-p,.cs-btn.cs-g{background:var(--brand);color:#fff;border-color:var(--brand)}
.cs-btn.cs-p:hover,.cs-btn.cs-g:hover{box-shadow:0 8px 20px rgba(93,31,114,.25)}
.cs-btn .cs-ar{transition:transform .15s}.cs-btn:hover .cs-ar{transform:translateX(3px)}

.cs-ph{background:var(--ph);color:var(--phx);display:flex;align-items:center;justify-content:center;font-size:12px;border-radius:var(--r);overflow:hidden}
.cs-ph::before{content:"Image"}

/* Hero */
.cs-hero{padding:clamp(56px,8vw,104px) 0 0;text-align:center}
.cs-hero h1{margin:0 auto;white-space:nowrap}
.cs-hero .cs-sub{font-size:clamp(15px,2.2vw,21px);font-weight:600;font-style:italic;margin:18px auto 0;white-space:nowrap}
.cs-hero .cs-lead{max-width:780px;margin:16px auto 32px;text-wrap:balance}
.cs-hero .cs-btns{justify-content:center}
.cs-checks{list-style:none;padding:0;margin:40px auto 0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;max-width:1040px;text-align:left}
.cs-checks li{display:flex;gap:10px;font-size:13.5px;line-height:1.45;color:var(--ink);padding:16px;border-radius:14px;background:#fff;border:1px solid var(--line);box-shadow:0 6px 18px rgba(93,31,114,.05)}
.cs-checks li::before{content:"✓";flex:none;width:20px;height:20px;border-radius:50%;background:var(--green);color:#fff;font-size:11px;font-weight:700;display:grid;place-items:center}
.cs-hero-img{aspect-ratio:16/7;margin-top:clamp(40px,6vw,64px);border-radius:24px}
@media (max-width:640px){.cs-hero .cs-sub{white-space:normal;max-width:30ch}}
@media (max-width:480px){.cs-hero h1{white-space:normal;max-width:12ch}}

/* Stats */
.cs-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:clamp(48px,7vw,80px) 0 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.cs-stats div{padding:28px clamp(16px,2.5vw,32px)}
.cs-stats div+div{border-left:1px solid var(--line)}
.cs-stats b{display:block;font-size:clamp(32px,4vw,48px);font-weight:600;letter-spacing:-.03em;line-height:1;color:var(--green-ink)}
.cs-stats span{display:block;font-size:14px;color:var(--mut);margin-top:10px}

/* Sections */
.cs section{margin-top:var(--sec)}
.cs-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(20px,5vw,80px);align-items:end;margin-bottom:clamp(32px,4vw,48px)}
.cs-head h2{margin-top:14px}

.cs-grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(16px,2vw,24px)}
.cs-grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(16px,2vw,24px)}
.cs-card{border:1px solid var(--line);border-radius:var(--r);overflow:hidden;background:var(--card);display:flex;flex-direction:column;
  box-shadow:0 8px 24px rgba(93,31,114,.06);transition:transform .2s,box-shadow .2s}
.cs-card:hover{transform:translateY(-3px);box-shadow:0 16px 36px rgba(93,31,114,.12)}
.cs-card .cs-ph{border-radius:0;aspect-ratio:16/10}
.cs-grid2 .cs-card .cs-ph{aspect-ratio:16/8}
.cs-card .cs-b{padding:22px 22px 24px;display:flex;flex-direction:column;gap:8px}
.cs-card p{font-size:14.5px;color:var(--mut);line-height:1.65}
.cs-card .cs-n{font-size:12px;font-weight:600;color:var(--green-ink);letter-spacing:.04em}

/* Purple band */
.cs-band{margin-top:var(--sec);background:var(--brand);color:#fff;padding:clamp(56px,8vw,96px) 0;text-align:center}
.cs-band h2{color:#fff}
.cs-band p{margin:14px auto 0;max-width:640px;font-size:clamp(15px,1.5vw,17px);color:#e6d6ee}

/* Feature rows */
.cs-feat{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:clamp(32px,6vw,88px);align-items:center}
.cs-feat.cs-rev{grid-template-columns:minmax(0,1fr) minmax(0,1.05fr)}
.cs-feat.cs-rev .cs-ph{order:2}
.cs-feat .cs-ph{aspect-ratio:5/4;border-radius:24px}
.cs-feat .cs-t{display:flex;flex-direction:column;gap:18px;align-items:flex-start}
.cs-feat .cs-t p{font-size:15.5px;color:var(--mut);line-height:1.75}
.cs-tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
.cs-chips{display:grid;grid-template-columns:1fr 1fr;gap:12px;width:100%;max-width:420px;margin-top:6px}
.cs-chip{border:1px solid var(--line);border-radius:14px;padding:16px 18px;font-size:13px;color:var(--mut);background:#fff;box-shadow:0 6px 18px rgba(93,31,114,.05)}
.cs-chip b{display:block;font-size:20px;color:var(--green-ink);font-weight:600;letter-spacing:-.01em;margin-bottom:2px}

/* Lavender section */
.cs-tint{background:var(--soft);margin-top:var(--sec);padding:var(--sec) 0}
.cs-tint section{margin-top:0}

/* CTA */
.cs-cta{margin:var(--sec) 0 clamp(56px,8vw,96px);background:var(--brand);color:#fff;border-radius:24px;text-align:center;
  padding:clamp(56px,8vw,88px) clamp(20px,4vw,48px)}
.cs-cta h2{max-width:20ch;margin:0 auto;color:#fff}
.cs-cta p{max-width:560px;margin:16px auto 32px;font-size:clamp(15px,1.5vw,17px);color:#e6d6ee}
.cs-cta .cs-btns{justify-content:center}
.cs-cta .cs-btn.cs-g{background:#fff;color:var(--brand);border-color:#fff}
.cs-cta .cs-btn:not(.cs-g){background:transparent;color:#fff;border-color:rgba(255,255,255,.4)}
.cs-cta .cs-btn:not(.cs-g):hover{border-color:#fff}

/* Responsive */
@media (max-width:960px){.cs-checks{grid-template-columns:1fr 1fr}.cs-grid3{grid-template-columns:1fr 1fr}}
@media (max-width:760px){
  .cs-stats{grid-template-columns:1fr 1fr}
  .cs-stats div:nth-child(3){border-left:0}
  .cs-stats div:nth-child(n+3){border-top:1px solid var(--line)}
  .cs-head{grid-template-columns:1fr;gap:14px}
  .cs-feat,.cs-feat.cs-rev{grid-template-columns:1fr;gap:28px}
  .cs-feat.cs-rev .cs-ph{order:0}
  .cs-hero-img{aspect-ratio:4/3}
}
@media (max-width:560px){.cs-checks,.cs-grid3,.cs-grid2{grid-template-columns:1fr}.cs-btns .cs-btn{flex:1 1 auto}}
@media (prefers-reduced-motion:reduce){.cs *{transition:none!important}}

/* Button colours locked so global link styles can't override them */
.cs a.cs-btn,.cs a.cs-btn:visited{color:var(--brand)!important;text-decoration:none!important}
.cs a.cs-btn.cs-p,.cs a.cs-btn.cs-p:visited,.cs a.cs-btn.cs-p:hover,
.cs a.cs-btn.cs-g,.cs a.cs-btn.cs-g:visited,.cs a.cs-btn.cs-g:hover{color:#fff!important}
.cs .cs-cta a.cs-btn.cs-g,.cs .cs-cta a.cs-btn.cs-g:visited,.cs .cs-cta a.cs-btn.cs-g:hover{color:var(--brand)!important}
.cs .cs-cta a.cs-btn:not(.cs-g),.cs .cs-cta a.cs-btn:not(.cs-g):visited{color:#fff!important}

/* Extra responsive polish */
.cs img,.cs svg{max-width:100%}
.cs{overflow-x:clip}
@media (max-width:760px){
  .cs-hero{padding-top:48px}
  .cs-checks{margin-top:28px}
  .cs-card .cs-b{padding:18px}
  .cs-feat .cs-t p{font-size:15px}
  .cs-chips{max-width:none}
}
@media (max-width:560px){
  .cs-btns{flex-direction:column;align-items:stretch;width:100%;max-width:360px;margin:0 auto}
  .cs-feat .cs-t .cs-btns{margin:0}
  .cs-btn{width:100%}
  .cs-stats b{font-size:32px}
  .cs-stats div{padding:20px 14px}
  .cs-hero-img,.cs-feat .cs-ph{border-radius:16px}
  .cs-cta{border-radius:18px}
}
@media (max-width:360px){
  .cs-stats{grid-template-columns:1fr}
  .cs-stats div{border-left:0!important}
  .cs-stats div+div{border-top:1px solid var(--line)}
  .cs-chips{grid-template-columns:1fr}
}

/* ===== Manufacturing page additions ===== */
.mf-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:clamp(32px,5vw,72px);align-items:center;padding:clamp(48px,7vw,96px) 0 0}
.mf-hero h1{font-size:clamp(34px,4.6vw,58px);line-height:1.06;max-width:14ch}
.mf-hero .cs-lead{margin:20px 0 30px;max-width:540px}
.mf-kpi{display:flex;gap:clamp(20px,3vw,40px);margin-top:36px;padding-top:24px;border-top:1px solid var(--line);flex-wrap:wrap}
.mf-kpi b{display:block;font-size:clamp(26px,3vw,34px);font-weight:600;letter-spacing:-.02em;line-height:1;color:var(--green-ink)}
.mf-kpi span{display:block;font-size:13px;color:var(--mut);margin-top:6px}

/* Dashboard mock — product UI */
.mf-dash{background:#fff;border:1px solid #e6e0ec;border-radius:16px;box-shadow:0 1px 2px rgba(27,21,48,.04),0 24px 60px -12px rgba(93,31,114,.18);overflow:hidden;font-size:12px}
.mf-dbar{display:flex;align-items:center;gap:12px;padding:10px 14px;border-bottom:1px solid #efeaf3;background:#fbfafc}
.mf-dots{display:flex;gap:5px}.mf-dots i{width:8px;height:8px;border-radius:50%;background:#e2dce8}
.mf-dtitle{font-size:12.5px;font-weight:600;color:var(--ink);flex:1}
.mf-live{display:inline-flex;align-items:center;gap:6px;font-size:10.5px;font-weight:600;color:#00875f;background:#e8f8f1;padding:3px 8px;border-radius:99px;letter-spacing:.02em}
.mf-live::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--green);animation:mf-pulse 1.6s infinite}
@keyframes mf-pulse{50%{opacity:.3}}
.mf-dbody{padding:clamp(14px,1.8vw,20px);display:grid;gap:14px}
.mf-dmeta{display:flex;justify-content:space-between;font-size:11px;color:var(--mut)}
