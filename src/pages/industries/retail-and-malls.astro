---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Retail &amp; Malls — Fusionedge">
<div class="cs">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400..700;1,400..700&display=swap">

  <!-- Hero -->
  <div class="cs-w">
    <div class="rt-hero">
      <div>
        <span class="cs-tag">Retail &amp; Malls</span>
        <h1><span class="rt-l">Shoppers notice when it breaks.</span> <span class="rt-l">Make sure <span class="cs-ul">it never does.</span></span></h1>
        <p class="cs-lead">Escalators, ACs, washrooms, lighting and fire systems across every floor and every store. FusionEdge keeps malls and retail chains running smoothly, from the busiest Saturday to the quietest Tuesday.</p>
        <div class="cs-btns">
          <a class="cs-btn cs-p" href="https://fusionedge.io/request-demo/">Book a Demo <span class="cs-ar">→</span></a>
          <a class="cs-btn" href="https://fusionedge.io/contact/">Talk to Sales</a>
        </div>
        <div class="rt-trust"><span>All 26 apps in one plan</span><span>Malls and store chains</span><span>Web, mobile and QR</span></div>
      </div>

      <div class="rt-map" role="img" aria-label="Illustration of a mall floor plan with live issue markers">
        <div class="rt-bar">
          <div class="rt-dots"><i></i><i></i><i></i></div>
          <span class="rt-crumb">Mall <i>/</i> <b>Floor plan</b></span>
          <div class="rt-tabs"><span>LG</span><span class="on">G</span><span>L1</span><span>L2</span></div>
          <span class="rt-live">Live</span>
        </div>
        <div class="rt-body">
          <div class="rt-plan"><svg viewBox="0 0 360 222" role="presentation">
            <rect x="10" y="10" width="340" height="190" rx="10" fill="#fcfbfd" stroke="#d9d1e1" stroke-width="1.2"/>
            <rect x="20" y="78" width="320" height="56" rx="6" fill="#f6f3f8"/>
            <text x="80" y="104" font-size="6" fill="#b3abbe" letter-spacing="2" font-family="Public Sans,sans-serif">CONCOURSE</text>
            <rect x="20" y="20" width="60" height="50" rx="4" fill="#fff" stroke="#e6e0ec" stroke-width="1"/><text x="27" y="34" font-size="8" font-weight="700" fill="#1b1530" font-family="Public Sans,sans-serif">G-01</text><text x="27" y="44" font-size="6.5" fill="#8a8399" font-family="Public Sans,sans-serif">Fashion</text><rect x="84" y="20" width="52" height="50" rx="4" fill="#fff" stroke="#e6e0ec" stroke-width="1"/><text x="91" y="34" font-size="8" font-weight="700" fill="#1b1530" font-family="Public Sans,sans-serif">G-02</text><text x="91" y="44" font-size="6.5" fill="#8a8399" font-family="Public Sans,sans-serif">Footwear</text><rect x="140" y="20" width="52" height="50" rx="4" fill="#fff" stroke="#e6e0ec" stroke-width="1"/><text x="147" y="34" font-size="8" font-weight="700" fill="#1b1530" font-family="Public Sans,sans-serif">G-03</text><text x="147" y="44" font-size="6.5" fill="#8a8399" font-family="Public Sans,sans-serif">Beauty</text><rect x="196" y="20" width="48" height="50" rx="4" fill="#fff" stroke="#e6e0ec" stroke-width="1"/><text x="203" y="34" font-size="8" font-weight="700" fill="#1b1530" font-family="Public Sans,sans-serif">G-04</text><text x="203" y="44" font-size="6.5" fill="#8a8399" font-family="Public Sans,sans-serif">Café</text><rect x="248" y="20" width="92" height="50" rx="4" fill="#f6f2f9" stroke="#e3d9ea" stroke-width="1"/><text x="255" y="34" font-size="8" font-weight="700" fill="#1b1530" font-family="Public Sans,sans-serif">Anchor</text><text x="255" y="44" font-size="6.5" fill="#8a8399" font-family="Public Sans,sans-serif">Hypermarket</text><rect x="20" y="140" width="84" height="50" rx="4" fill="#f6f2f9" stroke="#e3d9ea" stroke-width="1"/><text x="27" y="154" font-size="8" font-weight="700" fill="#1b1530" font-family="Public Sans,sans-serif">Food court</text><text x="27" y="164" font-size="6.5" fill="#8a8399" font-family="Public Sans,sans-serif">12 outlets</text><rect x="108" y="140" width="50" height="50" rx="4" fill="#fff" stroke="#e6e0ec" stroke-width="1"/><text x="115" y="154" font-size="8" font-weight="700" fill="#1b1530" font-family="Public Sans,sans-serif">G-11</text><text x="115" y="164" font-size="6.5" fill="#8a8399" font-family="Public Sans,sans-serif">Kids</text><rect x="162" y="140" width="50" height="50" rx="4" fill="#fff" stroke="#e6e0ec" stroke-width="1"/><text x="169" y="154" font-size="8" font-weight="700" fill="#1b1530" font-family="Public Sans,sans-serif">G-12</text><text x="169" y="164" font-size="6.5" fill="#8a8399" font-family="Public Sans,sans-serif">Pharmacy</text><rect x="216" y="140" width="56" height="50" rx="4" fill="#fff" stroke="#e5483b" stroke-width="1.2"/><text x="223" y="154" font-size="8" font-weight="700" fill="#1b1530" font-family="Public Sans,sans-serif">G-14</text><text x="223" y="164" font-size="6.5" fill="#8a8399" font-family="Public Sans,sans-serif">Electronics</text><rect x="276" y="140" width="64" height="50" rx="4" fill="#fff" stroke="#e6e0ec" stroke-width="1"/><text x="283" y="154" font-size="8" font-weight="700" fill="#1b1530" font-family="Public Sans,sans-serif">G-15</text><text x="283" y="164" font-size="6.5" fill="#8a8399" font-family="Public Sans,sans-serif">Sports</text>
            <rect x="44" y="88" width="26" height="26" rx="6" fill="#fff" stroke="#dccde6"/><path d="M50 107 h4 l6 -9 h4" fill="none" stroke="#5D1F72" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><text x="57" y="123" text-anchor="middle" font-size="6" font-weight="600" fill="#6c6780" font-family="Public Sans,sans-serif">Escalator</text><rect x="150" y="88" width="26" height="26" rx="6" fill="#fff" stroke="#dccde6"/><rect x="158" y="94" width="10" height="14" rx="1.5" fill="none" stroke="#5D1F72" stroke-width="1.4"/><path d="M163 97 l-2 2.5 h4z M163 105 l-2 -2.5 h4z" fill="#5D1F72"/><text x="163" y="123" text-anchor="middle" font-size="6" font-weight="600" fill="#6c6780" font-family="Public Sans,sans-serif">Lift</text><rect x="206" y="88" width="26" height="26" rx="6" fill="#fff" stroke="#dccde6"/><circle cx="219" cy="101" r="6.5" fill="none" stroke="#5D1F72" stroke-width="1.4"/><path d="M219 100v4" stroke="#5D1F72" stroke-width="1.6" stroke-linecap="round"/><circle cx="219" cy="97.5" r="1" fill="#5D1F72"/><text x="219" y="123" text-anchor="middle" font-size="6" font-weight="600" fill="#6c6780" font-family="Public Sans,sans-serif">Info desk</text><rect x="296" y="88" width="26" height="26" rx="6" fill="#fff" stroke="#dccde6"/><circle cx="306" cy="96" r="1.8" fill="#5D1F72"/><circle cx="312" cy="96" r="1.8" fill="#5D1F72"/><path d="M306 99v8M312 99v8" stroke="#5D1F72" stroke-width="2" stroke-linecap="round"/><text x="309" y="123" text-anchor="middle" font-size="6" font-weight="600" fill="#6c6780" font-family="Public Sans,sans-serif">Washroom</text>
            <rect x="160" y="196" width="40" height="8" fill="#fff"/>
            <path d="M180 214 v-10 m-4 4 l4 -4 4 4" fill="none" stroke="#9a91a6" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            <text x="190" y="216" font-size="6.5" font-weight="600" fill="#9a91a6" font-family="Public Sans,sans-serif">Main entrance</text>
            <g><path d="M64 98 c-6 -7 -9 -10 -9 -15 a9 9 0 0 1 18 0 c0 5 -3 8 -9 15z" fill="#e8a23a" stroke="#fff" stroke-width="1.5"/><text x="64" y="86" text-anchor="middle" font-size="8" font-weight="700" fill="#fff" font-family="Public Sans,sans-serif">1</text></g>
            <g><path d="M258 160 c-6 -7 -9 -10 -9 -15 a9 9 0 0 1 18 0 c0 5 -3 8 -9 15z" fill="#e5483b" stroke="#fff" stroke-width="1.5"/><text x="258" y="148" text-anchor="middle" font-size="8" font-weight="700" fill="#fff" font-family="Public Sans,sans-serif">2</text></g>
            <g><path d="M316 98 c-6 -7 -9 -10 -9 -15 a9 9 0 0 1 18 0 c0 5 -3 8 -9 15z" fill="#00BF88" stroke="#fff" stroke-width="1.5"/><text x="316" y="86" text-anchor="middle" font-size="8" font-weight="700" fill="#fff" font-family="Public Sans,sans-serif">3</text></g>
          </svg>
            <div class="rt-legend"><span><i style="background:#e8a23a"></i>Maintenance due</span><span><i style="background:#e5483b"></i>Open ticket</span><span><i style="background:#00BF88"></i>Done</span><span><i class="sq"></i>Anchor / food court</span></div>
          </div>
          <div class="rt-list">
            <div class="rt-li"><span class="n a">1</span><div><b>Escalator E1</b><small>Concourse · near G-01</small></div><div><b>Monthly PPM</b><small>Assigned to Lift &amp; Escalator team</small></div><i class="st a">Due today</i></div>
            <div class="rt-li"><span class="n r">2</span><div><b>Store G-14</b><small>Electronics · tenant request</small></div><div><b>AC not cooling</b><small>Technician on the way</small></div><i class="st r">Open · 12 min</i></div>
            <div class="rt-li"><span class="n g">3</span><div><b>Washroom W3</b><small>Concourse · east</small></div><div><b>Cleaning round</b><small>Closed with photo</small></div><i class="st g">Done 10:20</i></div>
          </div>
          <div class="rt-foot"><div><small>Open tickets</small><b>3</b></div><div><small>Checklists done</small><b>98%</b></div><div><small>Assets on floor</small><b>24</b></div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Two sides -->
  <div class="cs-w">
    <section>
      <div class="cs-head">
        <div><span class="cs-tag">Who it’s for</span><h2>Built for both sides of retail</h2></div>
        <p class="cs-lead">Whether you run the building or the stores inside it, the job is the same: keep everything working and prove it.</p>
      </div>
      <div class="rt-sides">
        <article class="rt-side"><span class="who">Mall operators</span><h3>One view of the whole building</h3><p>Common areas, shared utilities and hundreds of tenants, managed from one place.</p>
          <ul><li>PPM for escalators, lifts, HVAC, DG sets and fire systems</li><li>Housekeeping and washroom checklists with photo proof</li><li>Tenant help desk with SLAs and escalation</li><li>Energy readings and fair billing for tenants</li></ul></article>
        <article class="rt-side b"><span class="who">Retail chains</span><h3>Every store, run the same way</h3><p>Dozens or hundreds of outlets, each with its own landlord, vendors and equipment.</p>
          <ul><li>One maintenance standard rolled out to every store</li><li>Store requests routed to the right vendor</li><li>Asset and AMC records for every outlet</li><li>Compare stores side by side on one dashboard</li></ul></article>
      </div>
    </section>
  </div>

  <!-- Capabilities -->
  <div class="cs-tint">
    <div class="cs-w">
      <div class="cs-head">
        <div><span class="cs-tag">Capabilities</span><h2>Everything that keeps the floor open</h2></div>
        <p class="cs-lead">Turn on what you need today and add more later. Every module shares the same assets, people and data.</p>
      </div>
      <div class="rt-bento">
        <article class="rt-c s4 g"><span class="rt-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/></svg></span><h3>Preventive maintenance</h3><p>Escalators, lifts, chillers, AHUs, DG sets and fire pumps on schedule, with reminders on technicians’ phones and a photo to close each task.</p></article>
        <article class="rt-c s2"><span class="rt-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8a2 2 0 0 0 0 4v4h18v-4a2 2 0 0 0 0-4V4H3z"/><path d="M13 4v16"/></svg></span><h3>Smart ticketing</h3><p>Every request timed, assigned and escalated.</p></article>
        <article class="rt-c s2"><span class="rt-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8l2 2 4-4M8 15h8"/></svg></span><h3>Digital checklists</h3><p>Washrooms, food courts and parking checked on time.</p></article>
        <article class="rt-c s2"><span class="rt-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg></span><h3>Energy and readings</h3><p>Meters read at set times, spikes flagged early.</p></article>
        <article class="rt-c s2"><span class="rt-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V7l9-4 9 4v14"/><path d="M9 21v-6h6v6"/></svg></span><h3>Tenant management</h3><p>Help desk, fit-outs and shared costs in one place.</p></article>
        <article class="rt-c s3"><span class="rt-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg></span><h3>Vendors and AMCs</h3><p>Contracts, renewals and vendor performance tracked, with reminders before an AMC lapses.</p></article>
        <article class="rt-c s3 g"><span class="rt-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg></span><h3>CXO dashboard</h3><p>Every mall or store, every ticket and every SLA in one live view.</p></article>
      </div>
    </div>
  </div>

  <!-- Peak days -->
  <div class="rt-peak">
    <div class="cs-w">
      <span class="cs-tag">Peak days</span>
      <h2>Built for weekends, sales and festive rush</h2>
      <p class="cs-lead" style="max-width:620px;margin-top:14px">The days that matter most are the days your building is under the most pressure.</p>
      <div class="rt-pk">
        <div><em>Before the rush</em><p>Critical assets checked and cleaning schedules stepped up ahead of the weekend or sale.</p></div>
        <div><em>During the rush</em><p>Washroom and food-court rounds tracked live, with faults escalated in minutes.</p></div>
        <div><em>After the rush</em><p>A full record of what was done, ready for the landlord, brand or auditor.</p></div>
      </div>
    </div>
  </div>

  <!-- Chain rollout -->
  <div class="cs-w">
    <section>
      <div class="cs-head">
        <div><span class="cs-tag">For store chains</span><h2>From one store to hundreds, in four steps</h2></div>
        <p class="cs-lead">Set the standard once, then roll it out to every outlet.</p>
      </div>
      <div class="rt-roll">
        <div><em>01</em><h3>Build the template</h3><p>Checklists, PPM schedules and SLAs set up once for a model store.</p></div>
        <div><em>02</em><h3>Roll it out</h3><p>Every new or existing store goes live on the same template.</p></div>
        <div><em>03</em><h3>Run it daily</h3><p>Store staff and vendors work from their phones, with photo proof.</p></div>
        <div><em>04</em><h3>Compare and improve</h3><p>See which stores lag, and fix the cause, not just the ticket.</p></div>
      </div>
    </section>
  </div>

  <!-- CTA -->
  <div class="cs-w">
    <div class="cs-cta">
      <span class="cs-tag" style="color:#e6d6ee">Get Started</span>
      <h2 style="margin-top:14px;max-width:24ch">See FusionEdge running in a mall or store like yours</h2>
      <p>Book a demo and we will walk you through the modules for your floors, tenants, stores and vendors. No card and no setup fee.</p>
      <div class="cs-btns">
        <a class="cs-btn cs-g" href="https://fusionedge.io/request-demo/">Book a Demo <span class="cs-ar">→</span></a>
        <a class="cs-btn" href="https://fusionedge.io/contact/">Contact Sales</a>
      </div>
    </div>
  </div>
</div>
</Layout>

<style>
.cs{
  --bg:#fff;--soft:#f4eff7;--ink:#1b1530;--mut:#6c6780;--line:#ebe6f0;--card:#fff;
  --brand:#5D1F72;--green:#00BF88;--green-ink:#00a576;--ph:#ece7f0;--phx:#9a91a6;
  --r:16px;--sec:clamp(72px,10vw,120px);color-scheme:light
}
.cs,.cs *{box-sizing:border-box}
.cs{background:var(--bg);color:var(--ink);font-family:"Public Sans",sans-serif;line-height:1.6;width:100%}
.cs,.cs *,.cs *::before,.cs *::after{font-family:"Public Sans",sans-serif!important}
.cs h1,.cs h2,.cs h3,.cs p{margin:0}
.cs h1,.cs h2,.cs h3{color:var(--ink)}
.cs-w{max-width:1160px;margin:0 auto;padding:0 clamp(20px,4vw,40px)}

/* Type — italic display headings like the main site */
.cs h1{font-size:clamp(28px,5.2vw,60px);line-height:1.05;letter-spacing:-.03em;font-weight:600;font-style:italic}
.cs h2{font-size:clamp(26px,3.2vw,38px);line-height:1.15;letter-spacing:-.025em;font-weight:600;font-style:italic;text-wrap:balance}
.cs h3{font-size:16.5px;line-height:1.35;font-weight:600;color:var(--brand)}
.cs-lead{font-size:clamp(15px,1.4vw,17px);color:var(--mut);line-height:1.7}
.cs-ul{color:var(--brand);text-decoration:underline;text-decoration-color:var(--green);text-decoration-thickness:3px;text-underline-offset:8px}

/* Bits */
.cs-tag{display:inline-flex;align-items:center;gap:8px;font-size:11.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--brand)}
.cs-tag::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.cs-pill{font-size:12.5px;padding:5px 12px;border-radius:99px;background:#fff;color:var(--brand);border:1px solid #dccde6}
.cs-btns{display:flex;gap:12px;flex-wrap:wrap}
.cs-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 26px;border-radius:99px;font:600 14px/1 "Public Sans",sans-serif;
  border:1px solid #d9cfe2;background:#fff;color:var(--brand);text-decoration:none;transition:transform .15s,background .15s,border-color .15s,box-shadow .15s}
.cs-btn:hover{transform:translateY(-1px);border-color:var(--brand)}
.cs-btn.cs-p,.cs-btn.cs-g{background:var(--brand);color:#fff;border-color:var(--brand)}
.cs-btn.cs-p:hover,.cs-btn.cs-g:hover{box-shadow:0 8px 20px rgba(93,31,114,.25)}
.cs-btn .cs-ar{transition:transform .15s}.cs-btn:hover .cs-ar{transform:translateX(3px)}

.cs-ph{background:var(--ph);color:var(--phx);display:flex;align-items:center;justify-content:center;font-size:12px;border-radius:var(--r);overflow:hidden}
.cs-ph::before{content:"Image"}

/* Hero */
.cs-hero{padding:clamp(56px,8vw,104px) 0 0;text-align:center}
.cs-hero h1{margin:0 auto;white-space:nowrap}
.cs-hero .cs-sub{font-size:clamp(15px,2.2vw,21px);font-weight:600;font-style:italic;margin:18px auto 0;white-space:nowrap}
.cs-hero .cs-lead{max-width:780px;margin:16px auto 32px;text-wrap:balance}
.cs-hero .cs-btns{justify-content:center}
.cs-checks{list-style:none;padding:0;margin:40px auto 0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;max-width:1040px;text-align:left}
.cs-checks li{display:flex;gap:10px;font-size:13.5px;line-height:1.45;color:var(--ink);padding:16px;border-radius:14px;background:#fff;border:1px solid var(--line);box-shadow:0 6px 18px rgba(93,31,114,.05)}
.cs-checks li::before{content:"✓";flex:none;width:20px;height:20px;border-radius:50%;background:var(--green);color:#fff;font-size:11px;font-weight:700;display:grid;place-items:center}
.cs-hero-img{aspect-ratio:16/7;margin-top:clamp(40px,6vw,64px);border-radius:24px}
@media (max-width:640px){.cs-hero .cs-sub{white-space:normal;max-width:30ch}}
@media (max-width:480px){.cs-hero h1{white-space:normal;max-width:12ch}}

/* Stats */
.cs-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:clamp(48px,7vw,80px) 0 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.cs-stats div{padding:28px clamp(16px,2.5vw,32px)}
.cs-stats div+div{border-left:1px solid var(--line)}
.cs-stats b{display:block;font-size:clamp(32px,4vw,48px);font-weight:600;letter-spacing:-.03em;line-height:1;color:var(--green-ink)}
.cs-stats span{display:block;font-size:14px;color:var(--mut);margin-top:10px}

/* Sections */
.cs section{margin-top:var(--sec)}
.cs-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(20px,5vw,80px);align-items:end;margin-bottom:clamp(32px,4vw,48px)}
.cs-head h2{margin-top:14px}

.cs-grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(16px,2vw,24px)}
.cs-grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(16px,2vw,24px)}
.cs-card{border:1px solid var(--line);border-radius:var(--r);overflow:hidden;background:var(--card);display:flex;flex-direction:column;
  box-shadow:0 8px 24px rgba(93,31,114,.06);transition:transform .2s,box-shadow .2s}
.cs-card:hover{transform:translateY(-3px);box-shadow:0 16px 36px rgba(93,31,114,.12)}
.cs-card .cs-ph{border-radius:0;aspect-ratio:16/10}
.cs-grid2 .cs-card .cs-ph{aspect-ratio:16/8}
.cs-card .cs-b{padding:22px 22px 24px;display:flex;flex-direction:column;gap:8px}
.cs-card p{font-size:14.5px;color:var(--mut);line-height:1.65}
.cs-card .cs-n{font-size:12px;font-weight:600;color:var(--green-ink);letter-spacing:.04em}

/* Purple band */
