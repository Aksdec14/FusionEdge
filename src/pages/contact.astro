---
import Layout from "../layouts/Layout.astro";
const offices = [
  { city: "Noida", address: "3rd Floor, C33, Sector 62, Noida, UP 201309" },
  { city: "Bengaluru", address: "Brigade Tech Park, Tower B, Whitefield, Bengaluru, KA 560066" },
];
const phone = { display: "+91-8968211311", href: "tel:+918968211311", hours: "Mon–Fri, 9 AM – 6 PM IST" };
const email = "sales@fusionedge.io";
const topics = ["Request a Demo", "Need Brochure", "Connect with the Team"];
---
<Layout title="Contact — Fusionedge">
<section class="ct" id="contact" aria-labelledby="ct-title">
  <div class="ct-bg" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
  <div class="ct-wrap">
    <!-- Left: intro + details -->
    <div class="ct-info">
      <p class="ct-kicker">Contact us</p>
      <h2 class="ct-h" id="ct-title">Let's solve your <br>challenges together</h2>
      <p class="ct-lead">Have questions about FusionEdge? We're here to help. Reach out to our team and let's transform your facility management together.</p>

      <ul class="ct-list">
        <li>
          <span class="ct-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
          <div>
            <h3>Address</h3>
            <p class="ct-sub">Visit us at our offices</p>
            {offices.map((o) => (
              <p class="ct-val"><span class="ct-city">{o.city}</span><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(o.address)}`} target="_blank" rel="noopener">{o.address}</a></p>
            ))}
          </div>
        </li>
        <li>
          <span class="ct-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3.5h3.2l1.4 3.4-2 1.2a12 12 0 0 0 6.3 6.3l1.2-2 3.4 1.4V17a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 5 6.7 2 2 0 0 1 7 3.5z"/></svg></span>
          <div>
            <h3>Phone</h3>
            <p class="ct-sub">Call us, {phone.hours}</p>
            <p class="ct-val"><a href={phone.href}>{phone.display}</a></p>
          </div>
        </li>
        <li>
          <span class="ct-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
          <div>
            <h3>Email</h3>
            <p class="ct-sub">Send us your questions</p>
            <p class="ct-val"><a href={`mailto:${email}`}>{email}</a></p>
          </div>
        </li>
      </ul>
    </div>

    <!-- Right: form -->
    <form class="ct-form" action="#" method="post" novalidate>
      <div class="ct-row">
        <label class="ct-field"><span>First name</span><input type="text" name="first_name" placeholder="First name" autocomplete="given-name" required></label>
        <label class="ct-field"><span>Last name</span><input type="text" name="last_name" placeholder="Last name" autocomplete="family-name"></label>
      </div>
      <label class="ct-field"><span>Company email</span><input type="email" name="email" placeholder="you@company.com" autocomplete="email" required></label>
      <label class="ct-field"><span>Phone number</span>
        <span class="ct-phone">
          <select name="country_code" aria-label="Country code">
            <option value="+91" selected>IN (+91)</option>
            <option value="+1">US (+1)</option>
            <option value="+44">UK (+44)</option>
            <option value="+971">UAE (+971)</option>
            <option value="+65">SG (+65)</option>
          </select>
          <input type="tel" name="phone" placeholder="Phone number" autocomplete="tel-national">
        </span>
      </label>
      <label class="ct-field"><span>How can we help?</span>
        <select name="subject" required>
          <option value="" selected disabled>Choose a topic</option>
          {topics.map((t) => <option value={t}>{t}</option>)}
        </select>
      </label>
      <label class="ct-field"><span>Message</span>
        <textarea name="message" rows="4" placeholder="Type your message here..."></textarea>
        <small class="ct-help">Tell us about your sites, assets or the modules you're interested in.</small>
      </label>
      <label class="ct-check"><input type="checkbox" name="consent" required><span>By reaching out to us, you agree to our <a href="/privacy-policy">Privacy Policy</a>.</span></label>
      <button type="submit" class="ct-btn">Submit</button>
    </form>
  </div>
</section>

<style>
  .ct{--brand:#5D1F72;--ink:#1a1424;--mut:#6b6478;--line:rgba(93,31,114,.16);--soft:rgba(93,31,114,.08);
    padding:clamp(56px,8vw,96px) 0;font-family:"Public Sans",sans-serif;color:var(--ink)}
  .ct *,.ct *::before,.ct *::after{box-sizing:border-box;font-family:"Public Sans",sans-serif}
  .ct p,.ct h2,.ct h3{margin:0;max-width:none}
  .ct-wrap{max-width:1120px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(32px,6vw,88px);align-items:start}

  /* Left */
  .ct .ct-kicker{font-size:14px;font-weight:600;color:var(--brand)}
  .ct .ct-h{margin-top:12px;font-size:clamp(30px,3.6vw,44px);line-height:1.12;letter-spacing:-.03em;font-weight:700;color:var(--ink)}
  .ct .ct-lead{margin-top:18px;max-width:460px;font-size:15px;line-height:1.6;color:var(--mut)}
  .ct-list{list-style:none;margin:36px 0 0;padding:0;display:grid;gap:30px}
  .ct-list li{display:grid;grid-template-columns:36px minmax(0,1fr);gap:16px;align-items:start}
  .ct-ico{width:36px;height:36px;border-radius:9px;background:var(--soft);color:var(--brand);display:grid;place-items:center}
  .ct-ico svg{width:18px;height:18px}
  .ct h3{font-size:17px;font-weight:600;color:var(--ink);line-height:1.3;margin-top:4px}
  .ct .ct-sub{margin-top:6px;font-size:14px;color:var(--mut);line-height:1.5}
  .ct .ct-val{margin-top:12px;font-size:14px;line-height:1.5}
  .ct .ct-val+.ct-val{margin-top:8px}
  .ct-val a{color:var(--brand);font-weight:600;text-decoration:none}
  .ct-val a:hover{text-decoration:underline}
  .ct-city{display:block;font-size:11.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);margin-bottom:2px}

  /* Form */
  .ct-form{display:grid;gap:20px}
  .ct-row{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .ct-field{display:grid;gap:8px}
  .ct-field>span:first-child{font-size:13px;font-weight:600;color:var(--ink)}
  .ct input[type=text],.ct input[type=email],.ct input[type=tel],.ct select,.ct textarea{
    width:100%;height:46px;padding:0 14px;border:1px solid var(--line);border-radius:10px;background:#fff;
    font-size:14.5px;color:var(--ink);outline:none;transition:border-color .15s,box-shadow .15s}
  .ct textarea{height:auto;min-height:110px;padding:12px 14px;resize:vertical;line-height:1.5}
  .ct input::placeholder,.ct textarea::placeholder{color:#9a93a8}
  .ct input:focus,.ct select:focus,.ct textarea:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(93,31,114,.12)}
  .ct select{appearance:none;padding-right:38px;cursor:pointer;
    background:#fff url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8'><path d='M1 1.5l5 5 5-5' fill='none' stroke='%235D1F72' stroke-width='1.5' stroke-linecap='round'/></svg>") no-repeat right 14px center/11px}
  .ct select:has(option[value=""]:checked){color:#9a93a8}
  .ct-phone{display:flex;border:1px solid var(--line);border-radius:10px;overflow:hidden;transition:border-color .15s,box-shadow .15s}
  .ct-phone:focus-within{border-color:var(--brand);box-shadow:0 0 0 3px rgba(93,31,114,.12)}
  .ct .ct-phone select,.ct .ct-phone input{border:0;border-radius:0;box-shadow:none!important}
  .ct .ct-phone select{width:auto;flex:none;padding:0 32px 0 14px;background-position:right 12px center;font-weight:500;color:var(--ink)}
  .ct .ct-phone input{flex:1;min-width:0;padding-left:12px;border-left:1px solid var(--line)}
  .ct-help{font-size:12.5px;color:var(--mut)}
  .ct-check{display:flex;gap:10px;align-items:flex-start;font-size:13px;color:var(--mut);line-height:1.5;cursor:pointer}
  .ct-check input{width:16px;height:16px;margin:2px 0 0;accent-color:var(--brand);flex:none}
  .ct-check a{color:var(--brand);font-weight:600;text-decoration:none}
  .ct-check a:hover{text-decoration:underline}
  .ct-btn{height:48px;border:0;border-radius:10px;background:var(--brand);color:#fff;font-size:15px;font-weight:600;cursor:pointer;transition:opacity .15s}
  .ct-btn:hover{opacity:.9}
  .ct-btn:focus-visible{outline:3px solid rgba(93,31,114,.35);outline-offset:2px}


  /* very light layered paper-cut background */
  .ct{position:relative;isolation:isolate;overflow:hidden;background:#fefefe}
  .ct-bg{position:absolute;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
  .ct-bg span{position:absolute;width:var(--s);height:var(--s);border-radius:28px;transform:rotate(45deg);
    background:#fff;
    box-shadow:-6px 6px 20px rgba(93,31,114,.02),-1px 1px 3px rgba(93,31,114,.015)}
  .ct-bg span:nth-child(1){--s:560px;left:-300px;top:-120px}
  .ct-bg span:nth-child(2){--s:520px;left:-230px;top:-40px}
  .ct-bg span:nth-child(3){--s:600px;right:-260px;top:-380px}
  .ct-bg span:nth-child(4){--s:420px;left:34%;top:38%}
  .ct-bg span:nth-child(5){--s:420px;left:44%;top:30%}
  .ct-bg span:nth-child(6){--s:520px;right:-180px;top:42%}
  .ct-bg span:nth-child(7){--s:560px;left:22%;bottom:-460px}
  .ct-form{background:rgba(255,255,255,.9);border-radius:16px;padding:clamp(18px,2.4vw,28px);box-shadow:0 8px 28px -14px rgba(93,31,114,.08)}
  @media (max-width:860px){.ct-bg span:nth-child(n+4){display:none}}

  @media (max-width:860px){
    .ct-wrap{grid-template-columns:1fr}
  }
  @media (max-width:480px){
    .ct-row{grid-template-columns:1fr}
    .ct .ct-h br{display:none}
  }
</style>
</Layout>