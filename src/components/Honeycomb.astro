<section class="hc" id="modules" aria-label="Modules by system">
  <div class="stage">
    <h2 class="rtitle layer hidden" id="rtitle"></h2>
    <div class="stats layer hidden" id="stats">
      <div><b data-n="26">0</b><span>separate apps</span></div>
      <div><b data-n="26">0</b><span>logins to remember</span></div>
      <div><b data-n="19">0</b><span>vendors to pay</span></div>
      <div><b data-n="0" data-z>∞</b><span>copy-pasting between them</span></div>
    </div>
    <svg id="svg" viewBox="120 90 1660 620" role="img" aria-label="Product honeycomb">
      <defs>
        <linearGradient id="hexFace" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset=".55" stop-color="#fbfafc"/><stop offset="1" stop-color="#eeebf2"/></linearGradient>
        <linearGradient id="hexRim" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff" stop-opacity=".95"/><stop offset=".5" stop-color="#ffffff" stop-opacity="0"/></linearGradient>
        <marker id="hcArrow" viewBox="0 0 12 12" markerWidth="16" markerHeight="16" refX="10" refY="6" orient="auto" markerUnits="userSpaceOnUse">
          <path d="M0 1.2 L11 6 L0 10.8 Z" fill="#13b981"/>
        </marker>
      </defs>
      <g class="layer" id="titles"></g>
      <g id="tiles"></g>
      <g id="hand"></g>
      <g class="layer hidden" id="arrows">
        <path id="aL" class="arrow" marker-end="url(#hcArrow)" d=""/>
        <path id="aR" class="arrow" marker-end="url(#hcArrow)" d=""/>
        <path id="aB" class="arrow" marker-end="url(#hcArrow)" d=""/>
      </g>
    </svg>
    <div class="legend layer" id="legend"></div>
    <div class="ind layer hidden" id="ind"><h2></h2><p class="sub"></p><div class="lines"></div></div>
    <div class="rnote l layer hidden" id="nl"></div>
    <div class="rnote r layer hidden" id="nr"></div>
    <div class="rnote b layer hidden" id="nb"></div>
  </div>
  <div class="bar">
    <div class="tabs" role="tablist">
      <button type="button" role="tab" data-v="software" aria-selected="true">Software</button>
      <button type="button" role="tab" data-v="industries" aria-selected="false">Industries</button>
      <button type="button" role="tab" data-v="roles" aria-selected="false">Roles</button>
    </div>
    <div class="status" id="status">Waiting to scroll into view…</div>
    <div class="imagine" id="imagine">
      <button type="button" class="switch" id="switch" role="switch" aria-checked="false" aria-labelledby="swl"></button>
      <span id="swl">Imagine without FusionEdge</span>
    </div>
  </div>
</section>
<script is:inline src="/honeycomb.js?v=role18"></script>
<style is:global>
#modules{
  --purple:#5b1f73;--green:#13b981;--ink:#222;
  max-width:none;margin:-8px auto 0;padding:4px 5vw 48px;
  font-family:"Public Sans",system-ui,sans-serif;font-style:normal;color:var(--ink);
}
#modules p{max-width:none;margin:0;font-size:inherit;line-height:inherit;color:inherit}
#modules h2{font-style:normal}
#modules .stage{position:relative}
#modules #svg{width:100%;height:auto;display:block;overflow:visible}
#modules .tile .hex{stroke-width:1.6;transition:stroke .4s,filter .4s}
#modules .tile .ring{fill:none;stroke-width:3.5;stroke-dasharray:1;stroke-dashoffset:1;opacity:0;transition:stroke-dashoffset 1.1s ease,opacity .3s}
#modules .tile .ring.on{stroke-dashoffset:0;opacity:1}
#modules .tile .ring{stroke:var(--group)}
#modules .tile .lbl{font-size:13.5px;fill:#222;text-anchor:middle}
#modules .tile.off{opacity:0}
#modules .clustered .tile .hex{stroke:transparent;filter:drop-shadow(0 4px 10px rgba(60,20,80,.13))}
#modules .clustered .tile .ring{display:none}
#modules .gt{text-anchor:middle;transition:opacity .4s}
#modules .gt .a{font-size:23px;font-weight:600}
#modules .gt .b{font-size:19.5px}
#modules .gt .a,#modules .gt .b{fill:var(--group)}
#modules .gt.dim{opacity:0}
#modules .layer{transition:opacity .08s}
#modules .hidden{opacity:0!important;pointer-events:none}
#modules .ind{position:absolute;left:56%;top:31%;right:2%}
#modules .ind h2{margin:0 0 22px;color:var(--purple);font-size:clamp(24px,2.6vw,44px);font-weight:600}
#modules .ind .sub{font-size:clamp(15px,1.25vw,21px);color:#333;margin:0 0 26px}
#modules .ind p.l{font-size:clamp(14px,1.2vw,20px);color:#444;margin:0 0 12px}
#modules .rtitle{position:absolute;left:0;right:0;top:3%;text-align:center;margin:0;color:var(--ink);font-size:clamp(22px,2.4vw,40px);font-weight:600}
#modules .rnote{position:absolute;font-size:clamp(13px,1.2vw,20px);color:#333;line-height:1.4;transition:opacity .08s}
#modules .rnote.l{right:76%;top:54%;text-align:right;width:22%}
#modules .rnote.r{left:78%;top:54%;width:20%}
#modules .rnote.b{left:50%;transform:translateX(-50%);top:91%;text-align:center;width:24%}
#modules .arrow{fill:none;stroke:#13b981;stroke-width:2.2;stroke-linecap:round;transition:opacity .08s}
#modules .bar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:24px}
#modules .tabs button{font:inherit;font-size:21px;padding:10px 24px;border:1px solid #ddd;background:#fff;color:var(--purple);border-radius:4px;cursor:pointer;margin-right:8px}
#modules .tabs button[aria-selected=true]{background:var(--purple);color:#fff;border-color:var(--purple)}
#modules .status{color:#aaa;font-size:13px;margin-left:auto}
#modules .tile .lbl{transition:opacity .4s,transform .5s}
#modules .chaos .tile .ring{display:none}
#modules .chaos .tile{transition:transform 1s cubic-bezier(.3,1.2,.5,1)}
#modules .stats{position:absolute;top:0;left:0;right:0;display:flex;justify-content:center;gap:clamp(16px,4vw,64px);text-align:center}
#modules .stats b{display:block;font-size:clamp(22px,2.6vw,42px);color:#d0566b;font-weight:700;line-height:1.1}
#modules .stats span{font-size:clamp(11px,.95vw,15px);color:#777}
#modules .legend{display:none;flex-wrap:wrap;justify-content:center;gap:6px 14px;margin:0 0 10px}
#modules .legend span{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--group);transition:opacity .4s}
#modules .legend span::before{content:"";width:10px;height:10px;border-radius:3px;background:var(--group)}
#modules .legend span.dim{opacity:0}
#modules[data-lay=desk] .stage{aspect-ratio:1660/620;width:min(100%,calc((var(--vh,100vh) - 130px) * 2.677));margin:0 auto}
#modules[data-lay=desk] .bar{width:min(100%,calc((var(--vh,100vh) - 130px) * 2.677));margin:18px auto 0;padding:0 1.3%;flex-wrap:nowrap}
#modules[data-lay=desk] .status{display:none}
#modules[data-lay=desk] .tabs button{font-size:15px;padding:8px 18px;margin-right:6px}
#modules[data-lay=desk] .imagine{margin:0 0 0 auto;padding:3px}
#modules[data-lay=desk] .imagine button{font-size:13px;padding:7px 14px}
#modules[data-lay=desk]{padding:4px 5vw 40px}
#modules:not([data-lay=desk]) .legend{display:flex}
#modules:not([data-lay=desk]) .stage>.hidden,#modules:not([data-lay=desk]) .legend.hidden,#modules:not([data-lay=desk]) .layer.hidden{display:none}
#modules:not([data-lay=desk]) .stage{display:flex;flex-direction:column}
#modules:not([data-lay=desk]) .stats,
#modules:not([data-lay=desk]) .ind,#modules:not([data-lay=desk]) .rtitle{position:static;margin:0 0 12px}
#modules:not([data-lay=desk]) .ind,#modules:not([data-lay=desk]) .rtitle,#modules:not([data-lay=desk]) .rnote{order:-1}
#modules:not([data-lay=desk]) .stats{flex-wrap:wrap;gap:10px 22px}
#modules:not([data-lay=desk]) .ind{text-align:left;margin:0 0 18px}
#modules:not([data-lay=desk]) .ind h2{margin:0 0 6px;color:var(--ink);font-size:26px;font-weight:700}
#modules:not([data-lay=desk]) .ind .sub{margin:0 0 14px;color:var(--purple);font-size:16px;font-weight:600}
#modules:not([data-lay=desk]) .ind p.l{font-size:14px;color:#222;line-height:1.45;margin:0 0 12px}
#modules:not([data-lay=desk]) .rtitle{text-align:left;color:var(--ink);font-size:26px;font-weight:700;margin:0 0 8px}
#modules:not([data-lay=desk]) .rnote{position:static;width:auto;right:auto;left:auto;top:auto;transform:none;text-align:left;margin:0 0 12px;max-width:none;padding:0;border:0;background:none;border-radius:0;font-size:14px;color:#222;line-height:1.45}
#modules:not([data-lay=desk]) .arrow{display:none}
#modules[data-lay=tab] .tile .lbl{font-size:15px}
#modules[data-lay=mob] .tile .lbl{font-size:17px}
#modules[data-lay=mob] .tabs{display:flex;width:100%}
#modules[data-lay=mob] .tabs button{flex:1;font-size:15px;padding:9px 6px;margin-right:6px}
#modules[data-lay=mob] .tabs button:last-child{margin-right:0}
#modules[data-lay=mob] .status{margin-left:0}
#modules[data-lay=mob] .imagine{display:flex;width:100%}
#modules[data-lay=mob] .imagine button{flex:1;font-size:13px;padding:9px 8px}
#modules[data-lay=mob]{padding:20px 12px 40px}
#modules .imagine{display:inline-flex!important;align-items:center;gap:12px;border:0!important;background:none!important;padding:0!important;position:relative}
#modules .imagine .switch{width:52px!important;height:28px;padding:0!important;border-radius:20px!important;background:#d9cfe0!important;border:0;position:relative;cursor:pointer;flex:none!important;transition:background .3s}
#modules .imagine .switch::after{content:"";position:absolute;top:4px;left:4px;width:20px;height:20px;border-radius:50%;background:#fff;transition:left .3s;box-shadow:0 1px 3px rgba(0,0,0,.25)}
#modules .imagine.on .switch{background:#6b3f66!important}
#modules .imagine.on .switch::after{left:28px}
#modules .imagine span{font-size:15px;color:#6b3f66;cursor:pointer;white-space:nowrap}
#modules .ic.p{--d:#6B2288;--k:#5D1F72;--l:#F3E9F8;--m:#CBA9DB;--g:#fff}
#modules .ic.g1{--d:#00BF88;--k:#00A276;--l:#FBFCDA;--m:#F6F7A9;--g:#fff}
#modules .ic.g2{--d:#00BF88;--k:#00A276;--l:#fff;--m:#C4EEDF;--g:#fff}
#modules .D{fill:var(--d)}#modules .K{fill:var(--k)}#modules .L{fill:var(--l)}#modules .M{fill:var(--m)}
#modules .W{fill:#fff}#modules .G{fill:var(--g)}#modules .N{fill:none}
#modules .sD,#modules .sM,#modules .sG{stroke-linecap:round;stroke-linejoin:round;stroke-width:2.2}
#modules .sD{stroke:var(--d)}#modules .sM{stroke:var(--m)}#modules .sG{stroke:var(--g);stroke-width:2}
#modules .o{stroke:#fff;stroke-width:3;paint-order:stroke;stroke-linejoin:round}
#modules .tile .icon{transition:opacity .4s}
#modules .tile .ring2{stroke-width:2.5}
#modules .chaos .tile .ring2{opacity:0}
#modules .tile .hex{stroke:transparent}
#modules .tile .hex{fill:url(#hexFace)}
#modules .tile .hex-side{fill:#dcd6e3;filter:drop-shadow(0 8px 10px rgba(40,20,60,.16))}
#modules .tile .hex-rim{fill:none;stroke:url(#hexRim);stroke-width:3}
#modules .tile .hex{filter:none}
#modules .tile>*:not(.hex-side){transition:transform .45s cubic-bezier(.3,1.4,.5,1),stroke-dashoffset 1.1s ease,opacity .3s}
#modules .tile .hex-side{transition:transform .45s cubic-bezier(.3,1.4,.5,1),filter .45s,fill .45s}
#modules .tile.act>*:not(.hex-side){transform:translateY(-8px)}
#modules .tile.act .hex-side{transform:translateY(6px);fill:#cfc5dc;filter:drop-shadow(0 16px 16px rgba(40,20,60,.26)) drop-shadow(0 4px 4px rgba(40,20,60,.12))}
#modules .tile{transition:transform .9s cubic-bezier(.6,.05,.25,1),opacity .08s}
#modules .hand text{font-family:"Public Sans",sans-serif;font-size:22px;font-weight:600;fill:var(--note);opacity:0;transition:opacity .08s}
#modules .hand path{fill:none;stroke:var(--note);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset .08s ease}
#modules .hand.on text{opacity:1}
#modules .hand.on path{stroke-dashoffset:0}
#modules:not([data-lay=desk]) .hand text{font-size:21px}
@media (max-width:760px){#modules{padding-left:16px;padding-right:16px}}
@media (prefers-reduced-motion:reduce){#modules .hand text,#modules .hand path{transition:none}}
#modules .chaos .tile .lbl{opacity:1;fill:#6B2288;font-weight:600}
#modules[data-lay=desk] .legend{display:flex;position:absolute;top:auto;bottom:3%;left:0;right:0;gap:10px 30px;z-index:2}
#modules[data-lay=desk] .legend span{font-size:clamp(15px,1.25vw,22px);gap:9px}
#modules[data-lay=desk] .legend span::before{width:clamp(12px,1vw,18px);height:clamp(12px,1vw,18px);border-radius:4px}
#modules:not([data-lay=desk]) .legend{margin:10px 0 0}
</style>
