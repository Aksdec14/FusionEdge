<script>
  // view toggle: every click replays the build-up and shows the chosen view
  (() => {
    const twin = document.querySelector<HTMLElement>('.twin');
    if (!twin) return;
    const buttons = [...twin.querySelectorAll<HTMLButtonElement>('.toggle button')];
    buttons.forEach(btn => btn.addEventListener('click', () => {
      twin.classList.remove('is-manual');
      void twin.offsetWidth;            // restart the CSS animations
      twin.dataset.view = btn.dataset.view ?? '';
      twin.classList.add('is-manual');
      buttons.forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
    }));
  })();

  // gentle tilt toward the pointer
  (() => {
    const stage = document.getElementById('twinStage');
    if (!stage || matchMedia('(prefers-reduced-motion: reduce)').matches || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    addEventListener('pointermove', e => {
      const x = e.clientX / innerWidth - .5, y = e.clientY / innerHeight - .5;
      stage.style.setProperty('--ry', (x * 8).toFixed(2) + 'deg');
      stage.style.setProperty('--rx', (-y * 6).toFixed(2) + 'deg');
    });
  })();
</script>
