<section class="twin" aria-labelledby="twin-title">
  <div class="twin-frame">
  <h2 id="twin-title">India’s First Operational Digital Twin</h2>
  <p class="twin-lead">Explore every floor, monitor every asset and understand your building in real time.</p>
  <div class="twin-video">
  <video
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-label="Your building’s operational digital twin"
  >
    <source
      src="/twin-video/digital-twin-fusionedge-mobile-1080x1350-voiceover.mp4"
      type="video/mp4"
      media="(max-width: 1024px)"
    />
    <source src="/twin-video/digital-twin-fusionedge-2200x800-voiceover.mp4" type="video/mp4" />
  </video>
  <button type="button" class="twin-sound" aria-pressed="false">Silence</button>
  </div>
  </div>
</section>
<script>
  const video = document.querySelector<HTMLVideoElement>(".twin video");
  if (video) {
    const desktop = "/twin-video/digital-twin-fusionedge-2200x800-voiceover.mp4";
    const mobile = "/twin-video/digital-twin-fusionedge-mobile-1080x1350-voiceover.mp4";
    const small = matchMedia("(max-width: 1024px)");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    const hold = () => {
      if (!reduce.matches) return;
      video.removeAttribute("autoplay");
      video.pause();
      video.controls = true;
    };

    const sound = document.querySelector<HTMLButtonElement>(".twin-sound");
    let silenced = false;

    const paint = () => {
      if (!sound) return;
      const hearing = !video.muted;
      sound.textContent = hearing ? "Silence" : "Sound";
      sound.setAttribute("aria-pressed", hearing ? "false" : "true");
      sound.setAttribute("aria-label", hearing ? "Silence the video" : "Turn on the video sound");
    };

    const inSight = () => {
      const r = video.getBoundingClientRect();
      return Math.min(r.bottom, innerHeight) - Math.max(r.top, 0) >= 120;
    };

    const applySound = () => {
      if (reduce.matches) {
        paint();
        return;
      }
      const want = inSight() && !silenced;
      if (!want) {
        video.muted = true;
        paint();
        return;
      }
      video.muted = false;
      if (!video.paused) {
        paint();
        return;
      }
      const pending = video.play();
      if (pending) {
        pending.then(paint).catch(() => {
          video.muted = true;
          video.play().catch(() => {});
          paint();
        });
      } else paint();
    };

    const useClip = () => {
      const next = small.matches ? mobile : desktop;
      if (!video.currentSrc.endsWith(next)) video.src = next;
      hold();
      applySound();
    };

    hold();
    small.addEventListener("change", useClip);
    addEventListener("scroll", applySound, { passive: true });
    addEventListener("resize", applySound);
    addEventListener("pointerdown", (e) => {
      if ((e.target as Element | null)?.closest?.(".twin-sound")) return;
      applySound();
    }, true);
    applySound();
    sound?.addEventListener("click", () => {
      silenced = !video.muted;
      video.muted = silenced;
      if (!silenced && video.paused) video.play().catch(() => {});
      paint();
    });
  }
</script>
<style>
  .twin {
    padding: clamp(28px, 4vh, 48px) 5vw;
    box-sizing: border-box;
  }
  .twin-frame {
    background: #5D1F72;
    border-radius: 22px;
    box-shadow: 0 12px 32px rgba(26, 20, 36, 0.08);
    padding: clamp(20px, 2.2vw, 36px);
  }
  .twin h2 {
    margin: 0 auto;
    max-width: none;
    text-align: center;
    font-family: "Public Sans", system-ui, sans-serif;
    font-style: italic;
    font-weight: 600;
    font-size: var(--type-h);
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .twin .twin-lead {
    margin: 6px auto 26px;
    max-width: 640px;
    text-align: center;
    font-family: "Public Sans", system-ui, sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: normal;
    color: #fff;
  }
  .twin-video { position: relative; }
  .twin-sound {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid #5D1F72;
    border-radius: 10px;
    background: #5D1F72;
    color: #fff;
    font: 500 14px "Public Sans", system-ui, sans-serif;
    cursor: pointer;
  }
  .twin-sound:hover { background: #fff; color: #5D1F72; }
  .twin video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2200 / 800;
    margin: 0;
    background: #fff;
    border-radius: 12px;
    object-fit: contain;
  }
  @media (min-width: 1025px) {
    .twin { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 1024px) {
    .twin video { aspect-ratio: 1080 / 1350; }
  }
  @media (max-width: 760px) {
    .twin { padding-left: 16px; padding-right: 16px; }
    .twin-frame { padding: 16px; border-radius: 16px; }
    .twin h2 { margin-bottom: 0; }
    .twin .twin-lead { margin-bottom: 20px; }
  }
</style>
