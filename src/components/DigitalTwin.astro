<style>
  @property --c { syntax: "<number>"; inherits: true; initial-value: 1; }  /* 1 = stacked, 0 = floors apart */
  @property --p { syntax: "<number>"; inherits: true; initial-value: 0; }  /* asset labels visible */
  @property --h { syntax: "<number>"; inherits: true; initial-value: 0; }  /* heatmap visible */


  .twin {
    /* brand colours */
    --brand: #5D1F72;        /* main purple: headline, charts, active states */
    --brand-mid: #A27BB3;
    --brand-light: #D9C8E2;
    --tint: #F4EEF6;         /* chart tracks, toggle background */
    --line: #EEE5F2;         /* card borders, axis lines */
    --text: #3A1347;         /* body text: deep brand ink */
    --muted: #7B6884;        /* secondary text: purple-grey */
    /* building size: limited by screen width AND height so the section fits one screen */
    --width: clamp(220px, min(34vw, calc((100svh - 318px) * .92)), 540px);
    --loop: 24s;             /* one cycle: stacked → open → asset view → heatmap → stacked */

    padding: var(--section-y) 0;
    box-sizing: border-box;
    font-family: "Public Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    color: var(--text);
  }
  .twin *, .twin *::before, .twin *::after { box-sizing: border-box; }

  /* ---------- heading ---------- */
  .twin__card {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(24px, 3vh, 40px) 5vw clamp(28px, 4vh, 48px);
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 16px 40px rgba(40,80,120,.18);
  }
  .twin__head {
    margin-bottom: clamp(16px, 2.5vh, 24px);
    text-align: center;
  }
  @media (max-width: 760px) {
    .twin__card { padding-left: 16px; padding-right: 16px; }
  }
  .twin__title {
    margin: 0 auto;
    max-width: 100%;
    font-family: "Public Sans", system-ui, sans-serif;
    font-style: italic;
    font-weight: 600;
    font-size: min(var(--type-h), calc((100vw - 48px) / 16.6));
    line-height: 1.2;
    letter-spacing: -.03em;
    color: #1a1424;
    white-space: nowrap;
  }
  .twin__lead {
    margin: 10px auto 0;
    max-width: 520px;
    font-family: "Public Sans", system-ui, sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: var(--type-body);
    line-height: 1.5;
    color: #6b7280;
    text-wrap: balance;
  }

  /* ---------- layout: cards | building | cards ---------- */
  .twin__body {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(24px, 3.5vw, 56px);
  }
  /* the timeline runs here so the building, labels, heatmap and caption share it */
  .twin__wrap {
    position: relative;
    flex: none;
    animation: cycle var(--loop) cubic-bezier(.65,0,.35,1) infinite,
               pins var(--loop) ease-in-out infinite,
               heat var(--loop) ease-in-out infinite;
  }

  .twin__stage {
    --rx: 0deg; --ry: 0deg;
    position: relative;
    width: var(--width);
    margin-inline: auto;
    aspect-ratio: 643 / 693;
    transform: perspective(1600px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform .4s ease-out;
  }

  /* each floor is a slice of the original image; stacked = moved down onto the floor below */
  .layer {
    position: absolute;
    inset: 0;
    transform: translateY(calc(var(--k) * 6.6% * var(--c)));
    animation: float 6s ease-in-out infinite;
    animation-delay: calc(var(--k) * -.35s);
  }
  .layer--pins { pointer-events: none; }
  .layer img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; user-select: none;
    filter: saturate(calc(1 - var(--h) * .85)) brightness(calc(1 + var(--h) * .03)); }

  /* ---------- heatmap ---------- */
  .layer--heat { pointer-events: none; }
  .heat {
    position: absolute;
    inset: 0;
    opacity: var(--h);
    mix-blend-mode: multiply;
    -webkit-mask: var(--mask) center / 100% 100% no-repeat;
            mask: var(--mask) center / 100% 100% no-repeat;
    animation: breathe 3s ease-in-out infinite;
  }
  @keyframes breathe { 50% { filter: brightness(1.08) saturate(1.15); } }

  .count {
    position: absolute;
    display: grid;
    place-items: center;
    min-width: 26px;
    height: 26px;
    padding: 0 6px;
    border-radius: 999px;
    background: #fff;
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--brand);
    transform: translate(-50%, -50%) scale(calc(.7 + var(--h) * .3));
    opacity: var(--h);
    pointer-events: none;
  }
  .count--hi  { box-shadow: 0 0 0 3px rgba(229,72,77,.45), 0 2px 8px rgba(20,24,31,.18); }
  .count--mid { box-shadow: 0 0 0 3px rgba(245,166,35,.5),  0 2px 8px rgba(20,24,31,.18); }

  /* ---------- view toggle ---------- */
  .viewbar {
    position: relative;
    display: flex;
    justify-content: center;
    margin-bottom: clamp(6px, 1.4vh, 14px);
  }
  .toggle {
    display: inline-flex;
    gap: 8px;
  }
  .toggle button {
    position: relative;
    isolation: isolate;
    min-width: 96px;
    padding: 8px 18px;
    border: 0;
    border-radius: 6px;
    background: none;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: color .3s ease;
  }
  /* filled background of the selected button (no background on the other one) */
  .toggle button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--brand);
    transition: opacity .3s ease;
  }
  /* while the section plays on its own, the fill follows the view on screen */
  .toggle button[data-view="assets"]  { color: color-mix(in srgb, #fff calc((1 - var(--h)) * 100%), var(--brand)); }
  .toggle button[data-view="heatmap"] { color: color-mix(in srgb, #fff calc(var(--h) * 100%), var(--brand)); }
  .toggle button[data-view="assets"]::before  { opacity: calc(1 - var(--h)); }
  .toggle button[data-view="heatmap"]::before { opacity: var(--h); }
  /* after a click, the clicked button stays filled */
  .twin.is-manual .toggle button { color: var(--brand); }
  .twin.is-manual .toggle button::before { opacity: 0; }
  .twin.is-manual .toggle button[aria-pressed="true"] { color: #fff; }
  .twin.is-manual .toggle button[aria-pressed="true"]::before { opacity: 1; }
  .toggle button:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .heatlegend {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    height: 16px;
    margin-top: clamp(4px, 1vh, 10px);
    font-size: 11px;
    color: var(--muted);
    opacity: var(--h);
    white-space: nowrap;
  }
  .heatlegend span:first-of-type { margin-left: 4px; }

  /* after a click: the loop stops and a short replay runs: stack → open → chosen view */
  .twin.is-manual .twin__wrap { --c: 0; --p: 0; --h: 0; }
  .twin.is-manual[data-view="assets"] .twin__wrap {
    animation: open-once 1.6s cubic-bezier(.65,0,.35,1) both,
               p-in .5s ease 1.4s both;
  }
  .twin.is-manual[data-view="heatmap"] .twin__wrap {
    animation: open-once 1.6s cubic-bezier(.65,0,.35,1) both,
               h-in .5s ease 1.4s both;
  }
  @keyframes open-once { 0%, 15% { --c: 1; } 100% { --c: 0; } }
  @keyframes p-in { from { --p: 0; } to { --p: 1; } }
  @keyframes h-in { from { --h: 0; } to { --h: 1; } }

  .twin.is-manual .kpi { animation: kpi-once .5s ease-out both; animation-delay: calc(1.4s + var(--d) * .1s); }
  .twin.is-manual .chart .line,
  .twin.is-manual .chart .area,
  .twin.is-manual .chart .end,
  .twin.is-manual .chart .live-dot,
  .twin.is-manual .pie__svg .sweep { animation-duration: 1.6s; animation-timing-function: linear; animation-fill-mode: both; animation-iteration-count: 1;
                                      animation-delay: calc(1.6s + var(--d) * .1s); }
  .twin.is-manual .chart .line     { animation-name: draw-once; }
  .twin.is-manual .chart .area     { animation-name: reveal-once; }
  .twin.is-manual .chart .end      { animation-name: travel-once; }
  .twin.is-manual .chart .live-dot { animation-name: live-once; animation-timing-function: step-end; }
  .twin.is-manual .chart .col      { animation: grow-y-once .5s ease-out both; animation-delay: calc(1.5s + var(--d) * .1s + var(--i) * .1s); }
  .twin.is-manual .chart .row      { animation: grow-x-once .5s ease-out both; animation-delay: calc(1.5s + var(--d) * .1s + var(--i) * .12s); }
  .twin.is-manual .pie__svg .sweep { animation-name: sweep-once; animation-duration: 1.2s; animation-timing-function: ease-in-out; }
  @keyframes kpi-once    { from { opacity: 0; translate: 0 10px; } to { opacity: 1; translate: 0 0; } }
  @keyframes draw-once   { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes reveal-once { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes travel-once { from { offset-distance: 0%; } to { offset-distance: 100%; } }
  @keyframes live-once   { from { opacity: 0; } to { opacity: 1; } }
  @keyframes sweep-once  { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }
  @keyframes grow-y-once { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes grow-x-once { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .ramp { width: 64px; height: 6px; border-radius: 3px; background: linear-gradient(90deg, rgba(245,166,35,.35), rgb(245,166,35) 40%, rgb(229,72,77)); }

  /* timeline (24s): stacked → open (6–18%) → asset view (20–50%) → heatmap (54–86%) → stack (90–100%) */
  @keyframes cycle {
    0%, 6%    { --c: 1; }
    18%, 90%  { --c: 0; }
    100%      { --c: 1; }
  }
  @keyframes pins {
    0%, 19%   { --p: 0; }
    23%, 49%  { --p: 1; }
    53%, 100% { --p: 0; }
  }
  @keyframes heat {
    0%, 51%   { --h: 0; }
    56%, 85%  { --h: 1; }
    89%, 100% { --h: 0; }
  }
  @keyframes float {
    0%, 100% { translate: 0 0; }
    50%      { translate: 0 -4px; }
  }

  /* ---------- pins: small label with a pointer ---------- */
  .pin {
    position: absolute;
    transform: translate(-50%, calc(-100% - 8px)) translateY(calc((1 - var(--p)) * 6px));
    opacity: var(--p);
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(255,255,255,.96);
    box-shadow: 0 1px 6px rgba(93,31,114,.16);
    color: var(--brand);
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
  }
  .pin::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 100%;
    translate: -50% 0;
    border: 5px solid transparent;
    border-top-color: rgba(255,255,255,.96);
  }

  /* ---------- KPI dashboard ---------- */
  .kpirow { display: contents; }
  .kpis--l { order: 0; }
  .twin__wrap { order: 1; }
  .kpis--r { order: 2; }
  .kpis {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.6vh, 16px);
    width: clamp(170px, 16vw, 210px);
    flex: none;
  }
  .kpi {
    padding: clamp(10px, 1.6vh, 14px) 16px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 6px 24px rgba(93,31,114,.07);
    opacity: 0;
    translate: 0 10px;
    animation: kpi-cycle var(--loop) ease-in-out infinite;
    animation-delay: calc(var(--d) * .15s);
  }
  .kpi__label { font-size: 11px; color: var(--muted); }
  .kpi__value { font-size: clamp(20px, 2vw, 26px); font-weight: 600; letter-spacing: -.02em; line-height: 1.2; margin-top: 4px; font-variant-numeric: tabular-nums; }
  .kpi__value small { font-size: 13px; font-weight: 500; color: var(--muted); letter-spacing: 0; }
  .kpi__sub { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .kpi__bar { height: 4px; border-radius: 4px; background: #f0f1f4; margin-top: 10px; overflow: hidden; }
  .kpi__bar i { display: block; height: 100%; width: var(--w); background: var(--text); border-radius: inherit; transform-origin: left; animation: bar-cycle var(--loop) ease-out infinite; animation-delay: calc(var(--d) * .15s); }
  .live { display: inline-flex; align-items: center; gap: 6px; }
  .live::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--text); animation: blink 1.6s ease-in-out infinite; }
  /* ---------- mini charts ---------- */
  .kpi__label { margin-bottom: 8px; }
  .chart { display: block; width: 100%; height: auto; overflow: visible; }
  .chart text, .legend { font-size: 8px; fill: var(--muted); color: var(--muted); }
  .chart .axis  { stroke: var(--line); stroke-width: 1; }
  .chart .track { fill: var(--tint); }
  .chart .col, .chart .row { fill: var(--brand); }
  .chart .line  { fill: none; stroke: var(--brand); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; }
  .chart .area  { fill: #F1E8F4; }
  .chart .end   { fill: var(--brand); stroke: #fff; stroke-width: 2; }
  .chart .hit   { fill: transparent; }
  .pie { display: flex; align-items: center; gap: 14px; }
  .pie__svg { width: 64px; height: 64px; flex: none; overflow: visible; }
  .pie__svg .slice { stroke: #fff; stroke-width: 1.5; stroke-linejoin: round; }
  .legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 5px; font-size: 11px; }
  .legend li { display: flex; align-items: center; gap: 6px; white-space: nowrap; min-width: 0; }
  .pie { min-width: 0; } .legend { min-width: 0; overflow: hidden; }
  .legend i { width: 8px; height: 8px; border-radius: 2px; flex: none; }

  /* charts fill in like live data each time the dashboard appears */
  .kpi * { animation-delay: inherit; }
  .chart .end { offset-distance: 100%; offset-rotate: 0deg; }
  .chart .ping { fill: none; stroke: var(--brand); stroke-width: 1.5; transform-box: fill-box; transform-origin: center; animation: ping 2s ease-out infinite; }
  .chart .line { animation: draw var(--loop) linear infinite; animation-delay: inherit; }
  .chart .area { animation: reveal var(--loop) linear infinite; animation-delay: inherit; }
  .chart .end  { animation: travel var(--loop) linear infinite; animation-delay: inherit; }
  .chart .live-dot { animation: live-on var(--loop) linear infinite; animation-delay: inherit; }
  .chart .col  { transform-box: fill-box; transform-origin: 50% 100%; animation: grow-y var(--loop) ease-out infinite; animation-delay: calc(var(--d) * .15s + var(--i) * .1s); }
  .chart .row  { transform-box: fill-box; transform-origin: 0 50%;   animation: grow-x var(--loop) ease-out infinite; animation-delay: calc(var(--d) * .15s + var(--i) * .12s); }
  .pie__svg .sweep { stroke-dashoffset: 0; animation: sweep var(--loop) ease-in-out infinite; animation-delay: inherit; }
  @keyframes ping { from { scale: 1; opacity: .8; } to { scale: 3; opacity: 0; } }
  /* loop timing: cards arrive at 23%, charts fill between 23% and 33% */
  @keyframes draw    { 0%, 23% { stroke-dashoffset: 1; } 33%, 100% { stroke-dashoffset: 0; } }
  @keyframes reveal  { 0%, 23% { clip-path: inset(0 100% 0 0); } 33%, 100% { clip-path: inset(0 0 0 0); } }
  @keyframes travel  { 0%, 23% { offset-distance: 0%; opacity: 1; } 33%, 100% { offset-distance: 100%; opacity: 1; } }
  @keyframes live-on { 0%, 33% { opacity: 0; } 34%, 100% { opacity: 1; } }
  @keyframes grow-y  { 0%, 23% { transform: scaleY(0); } 28%, 100% { transform: scaleY(1); } }
  @keyframes grow-x  { 0%, 23% { transform: scaleX(0); } 28%, 100% { transform: scaleX(1); } }
  @keyframes sweep   { 0%, 23% { stroke-dashoffset: 100; } 31%, 100% { stroke-dashoffset: 0; } }

  /* floors finish opening at 18% of the loop, then the cards come in and stay through the heatmap */
  @keyframes kpi-cycle {
    0%, 19%   { opacity: 0; translate: 0 10px; }
    23%, 86%  { opacity: 1; translate: 0 0; }
    90%, 100% { opacity: 0; translate: 0 10px; }
  }
  @keyframes bar-cycle {
    0%, 36%   { transform: scaleX(0); }
    46%, 100% { transform: scaleX(1); }
  }
  @keyframes blink { 50% { opacity: .25; } }

  /* portrait tablet & narrow screens: building on top, cards in a 3-column grid below */
  @media (max-width: 1024px) and (orientation: portrait), (max-width: 860px) {
    .twin { --width: clamp(220px, min(80vw, calc((100svh - 535px) * .92)), 460px); }
    .twin__body {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
    .twin__wrap { grid-column: 1 / -1; order: -1; justify-self: center; margin-bottom: clamp(4px, 1.5vh, 18px); }
    .kpis { display: contents; }
  }
  /* phone: building on top, then the four cards in a 2×2 grid */
  @media (max-width: 600px) {
    .twin { --width: clamp(200px, min(84vw, calc((100svh - 520px) * .92)), 400px); }
    .twin__body { display: block; min-width: 0; }
    .twin__wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      margin: 0 auto clamp(8px, 2vh, 18px);
    }
    .kpirow {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin: 0;
    }
    .kpis { display: contents; }
    .kpi--extra { display: none; }
    .kpi { padding: 11px 12px; min-width: 0; }
    .kpi__label { font-size: 11.5px; margin-bottom: 7px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pie { gap: 10px; }
    .pie__svg { width: 48px; height: 48px; }
    .legend { font-size: 10.5px; gap: 4px; }
    .ramp { width: 40px; }
    .heatlegend { font-size: 10px; height: 14px; }
    .count { min-width: 20px; height: 20px; padding: 0 4px; font-size: 10px; }
    .toggle button { min-width: 84px; padding: 7px 14px; font-size: 12px; }
    .pin { font-size: 9.5px; padding: 2px 6px; }
    .pin::after { border-width: 4px; }
  }

  /* short phones (e.g. iPhone SE): drop the intro line to keep everything on one screen */
  @media (max-width: 600px) and (max-height: 700px) {
    .twin { --width: clamp(180px, min(84vw, calc((100svh - 452px) * .92)), 400px); }
  }
  @media (max-width: 600px) and (max-height: 580px) {
    .twin { --width: clamp(160px, calc((100svh - 420px) * .92), 400px); }
  }

  /* phone held sideways: very short screen, go back to side-by-side and trim text */
  @media (orientation: landscape) and (max-height: 500px) {
    .twin { --width: clamp(160px, calc((100svh - 140px) * .92), 340px); }
    .kpi__sub { display: none; }
    .viewbar { margin-bottom: 4px; }
    .toggle button { min-width: 72px; padding: 4px 10px; font-size: 11px; }
    .twin__head { margin-bottom: 8px; }
    .twin__body { display: flex; gap: 16px; max-width: none; }
    .twin__wrap { order: 1; margin: 0; width: max-content; flex: none; align-self: center; }
    .kpirow { display: contents; }
    .kpis { display: flex; width: 150px; gap: 6px; }
    .kpi { padding: 7px 10px; }
    .kpi__label { margin-bottom: 4px; }
    .chart { max-height: 40px; }
    .pie__svg { width: 40px; height: 40px; }
    .legend { font-size: 9px; gap: 2px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .twin__wrap { animation: none; --c: 0; --p: 1; --h: 0; }
    .twin.is-manual[data-view] .twin__wrap { animation: none; --c: 0; }
    .twin.is-manual[data-view="assets"]  .twin__wrap { --p: 1; --h: 0; }
    .twin.is-manual[data-view="heatmap"] .twin__wrap { --p: 0; --h: 1; }
    .twin.is-manual .kpi, .twin.is-manual .kpi * { animation: none !important; opacity: 1; }
    .heat { animation: none; }
    .layer { animation: none; }
    .kpi { animation: none; opacity: 1; translate: 0 0; }
    .kpi * { animation: none !important; }
  }
</style>
<section class="twin" aria-labelledby="twin-title">
  <div class="twin__card">
  <header class="twin__head">
    <h2 class="twin__title" id="twin-title">Your building’s operational digital twin</h2>
    <p class="twin__lead">A live 3D copy of your space. See every asset where it is, floor by floor and room by room.</p>
  </header>

  <div class="twin__body">
  <div class="twin__wrap">
    <div class="viewbar">
      <div class="toggle" role="group" aria-label="Choose view">
        <button type="button" data-view="assets" aria-pressed="false">Assets</button>
        <button type="button" data-view="heatmap" aria-pressed="false">Heatmap</button>
      </div>
    </div>
    <div class="twin__stage" id="twinStage" role="img"
         aria-label="Office building model separating floor by floor, with assets pinned at their locations">
    <div class="layer" style="--k:0">
      <img src="data:image/webp;base64," alt="" width="643" height="693" draggable="false">
    </div>
    <div class="layer" style="--k:1">
      <img src="data:image/webp;base64," alt="" width="643" height="693" draggable="false">
    </div>
    <div class="layer" style="--k:2">
      <img src="data:image/webp;base64," alt="" width="643" height="693" draggable="false">
    </div>
    <div class="layer" style="--k:3">
      <img src="data:image/webp;base64," alt="" width="643" height="693" draggable="false">
