<style is:global>
  #fe-friction{--ff-purple:#5b1d72;--ff-green:#00BF88;--ff-ink:#171624;--ff-text:#55536a;--ff-muted:#9a98ab;--ff-red:#ef3b3b;
    font-family:"Public Sans",system-ui,sans-serif;color:var(--ff-text);padding:var(--section-y) 16px;margin:0;position:relative;overflow:hidden;background:transparent}
  #fe-friction *{box-sizing:border-box}
  #fe-friction .ff-card{max-width:1040px;margin:0 auto;background:#fff;border-radius:4px;padding:0 48px 48px;position:relative}
  #fe-friction .ff-h{margin:0;text-align:center;font-family:"Public Sans",system-ui,sans-serif;font-style:italic;font-weight:600;font-size:var(--type-h);line-height:1.2;letter-spacing:-.03em;color:var(--ff-ink)}
  #fe-friction .ff-keep{white-space:nowrap}
  #fe-friction .ff-h em{position:relative;display:inline-block;color:var(--ff-ink);transition:color .5s,opacity .35s}
  #fe-friction .ff-h em::after{content:"";position:absolute;left:2%;right:4%;bottom:-.06em;height:.16em;border-radius:99px;background:var(--ff-red);transform:rotate(-1deg);transition:background .5s}
  #fe-friction.after .ff-h em{color:var(--ff-purple)}
  #fe-friction.after .ff-h em::after{background:var(--ff-green)}
  #fe-friction .ff-sub{max-width:620px;margin:12px auto 0;text-align:center;font-size:var(--type-body);line-height:1.5;color:var(--ff-text)}
  #fe-friction .ff-swap{transition:opacity .35s ease}
