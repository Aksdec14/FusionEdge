<script is:inline>
(function(){
  const root=document.getElementById('fe-friction'); if(!root) return;
  const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  let state='before';
  function parse(s){const m=s.match(/^(\D*)([\d.]+)(.*)$/);return m?{pre:m[1],n:parseFloat(m[2]),suf:m[3],dp:(m[2].split('.')[1]||'').length}:null;}
  function countTo(el,from,to){
    const a=parse(from),b=parse(to); if(reduced||!a||!b){el.textContent=to;return;}
    const t0=performance.now(),dur=900;
    (function step(t){
      const k=Math.min(1,(t-t0)/dur);
      if(k<.5){const e=k*2;el.textContent=a.pre+(a.n*(1-e)).toFixed(a.dp)+a.suf;}
      else{const e=1-Math.pow(1-(k-.5)*2,3);el.textContent=b.pre+(b.n*e).toFixed(b.dp)+b.suf;}
      if(k<1)requestAnimationFrame(step);else el.textContent=to;
    })(t0);
  }
  function set(next){
    if(next===state)return; const prev=state; state=next;
    root.classList.toggle('after',next==='after');
    const swaps=[...root.querySelectorAll('.ff-swap'),...root.querySelectorAll('.ff-feat span')];
    swaps.forEach(el=>el.classList.add('out'));
    setTimeout(()=>{
      root.querySelectorAll('.ff-swap').forEach(el=>el.textContent=el.dataset[next]);
      root.querySelectorAll('.ff-feat').forEach(li=>li.querySelector('span').textContent=li.dataset[next]);
      swaps.forEach(el=>el.classList.remove('out'));
    },reduced?0:350);
    root.querySelectorAll('.ff-num').forEach(el=>countTo(el,el.dataset[prev],el.dataset[next]));
  }
  root.querySelectorAll('.ff-num').forEach(el=>el.textContent=el.dataset.before);
  const wait=ms=>new Promise(r=>setTimeout(r,ms));
  const BEFORE=2500, AFTER=5000;
  let visible=false, running=false;
  async function cycle(){
    if(running) return; running=true;
    while(visible){
      await wait(BEFORE); if(!visible) break; set('after');
      if(reduced) break;
      await wait(AFTER); if(!visible) break; set('before');
    }
    running=false;
  }
  new IntersectionObserver(ents=>{visible=ents.some(e=>e.isIntersecting); if(visible) cycle();},{threshold:.35}).observe(root);
})();
</script>
