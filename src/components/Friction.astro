  #fe-friction .stops{position:relative;display:grid;grid-template-columns:repeat(5,1fr);height:26px}
  #fe-friction .stop{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;font-size:11px;font-weight:800;position:relative;z-index:2}
