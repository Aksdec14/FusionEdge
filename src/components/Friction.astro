  #fe-friction .amber .streak{background:repeating-linear-gradient(90deg,var(--amber) 0 70px,transparent 70px 84px)}
  #fe-friction .green .streak{background:var(--green);height:4px;box-shadow:0 0 10px rgba(31,181,127,.45)}
